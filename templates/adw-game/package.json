{
    "name": "@gjsify/template-adw-game",
    "description": "Adwaita game shell using Excalibur.js, WebGL \u2192 Canvas2D fallback.",
    "version": "0.1.10",
    "type": "module",
    "private": true,
    "scripts": {
        "clear": "gjsify clear dist tsconfig.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjs && gjsify run build:node",
        "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/index.gjs.js --globals auto,dom,XMLHttpRequest,ProgressEvent,PointerEvent,MouseEvent,KeyboardEvent,WheelEvent",
        "build:node": "gjsify build src/index.ts --app node --outfile dist/index.node.mjs --globals auto,dom,XMLHttpRequest,ProgressEvent,PointerEvent,MouseEvent,KeyboardEvent,WheelEvent",
        "start": "gjsify run dist/index.gjs.js",
        "start:node": "gjsify run dist/index.node.mjs --runtime node",
        "start:bun": "gjsify run dist/index.node.mjs --runtime bun",
        "start:deno": "gjsify run dist/index.node.mjs --runtime deno",
        "dev": "gjsify dev --runtime gjs"
    },
    "devDependencies": {
        "@girs/adw-1": "4.3.0",
        "@girs/gio-2.0": "4.3.0",
        "@girs/gjs": "4.3.0",
        "@girs/gobject-2.0": "4.3.0",
        "@girs/gtk-4.0": "4.3.0",
        "@gjsify/canvas2d": "workspace:^",
        "@gjsify/cli": "workspace:^",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/fetch": "workspace:^",
        "@gjsify/rolldown-native": "workspace:^",
        "@gjsify/vite-plugin-blueprint": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@gjsify/node-gi": "file:../../packages/node-gi/node-gi",
        "@gjsify/webgl": "workspace:^",
        "excalibur": "0.32.0"
    },
    "gjsify": {
        "main": "dist/index.gjs.js",
        "example": {
            "runtimes": [
                "gjs",
                "node",
                "bun",
                "deno"
            ],
            "node": "dist/index.node.mjs"
        }
    }
}
