{
  "name": "@gjsify/example-node-gtk-http-dashboard",
  "description": "GTK4 dashboard with embedded HTTP server (GJS only)",
  "main": "dist/index.gjs.js",
  "type": "module",
  "scripts": {
    "clear": "gjsify clear dist tsconfig.tsbuildinfo",
    "check": "gjsify tsc --noEmit --skipLibCheck",
    "start": "gjsify run dist/index.gjs.js",
    "build": "gjsify run build:gjs",
    "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/index.gjs.js"
  },
  "devDependencies": {
    "@girs/gio-2.0": "4.6.0",
    "@girs/gjs": "4.6.0",
    "@girs/glib-2.0": "4.6.0",
    "@girs/gtk-4.0": "4.6.0",
    "@gjsify/cli": "workspace:^",
    "@gjsify/node-globals": "workspace:^",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "private": true,
  "version": "0.46.0"
}
