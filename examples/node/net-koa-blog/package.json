{
  "name": "@gjsify/example-node-net-koa-blog",
  "description": "Koa.js blog example with EJS templates for Node.js and GJS",
  "main": "dist/index.gjs.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clear": "gjsify clear dist tsconfig.tsbuildinfo",
    "check": "gjsify tsc --noEmit",
    "start": "gjsify run start:gjs",
    "start:gjs": "gjsify run dist/index.gjs.js",
    "start:node": "node dist/index.node.mjs",
    "build": "gjsify run build:gjs && gjsify run build:node && gjsify run build:views",
    "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/index.gjs.js",
    "build:node": "gjsify build src/index.ts --app node --outfile dist/index.node.mjs",
    "build:views": "gjsify copy src/views dist/views",
    "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
    "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
    "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
    "test": "gjsify run build && gjsify run build:test:node && gjsify run test:node",
    "test:node": "node test.node.mjs",
    "test:gjs": "gjsify run test.gjs.mjs"
  },
  "devDependencies": {
    "@gjsify/cli": "workspace:^",
    "@gjsify/node-globals": "workspace:^",
    "@gjsify/runtime": "workspace:^",
    "@gjsify/unit": "workspace:^",
    "@koa/router": "^15.6.0",
    "@types/ejs": "^3.1.5",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^25.9.2",
    "ejs": "^6.0.1",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "version": "0.46.0"
}
