{
  "name": "@gjsify/example-dom-three-extrude-shapes",
  "description": "Three.js extrude shapes example ported from refs/three/examples/webgl_geometry_extrude_shapes.html",
  "main": "dist/gjs.js",
  "type": "module",
  "scripts": {
    "clear": "gjsify clear dist tsconfig.tsbuildinfo",
    "check": "gjsify tsc --noEmit --skipLibCheck --strictNullChecks false --noImplicitAny false",
    "start": "gjsify run dist/gjs.js",
    "start:browser": "http-server dist",
    "build": "gjsify run build:gjs && gjsify run build:browser && gjsify run build:assets",
    "build:gjs": "gjsify build src/gjs/gjs.ts --app gjs --outfile dist/gjs.js",
    "build:browser": "gjsify build src/browser/browser.ts --app browser --outfile dist/browser.js",
    "build:assets": "gjsify copy src/browser/index.html src/browser/webgl.css dist/"
  },
  "dependencies": {
    "@gjsify/webgl": "workspace:^"
  },
  "devDependencies": {
    "@girs/gio-2.0": "4.3.0",
    "@girs/gjs": "4.3.0",
    "@girs/gtk-4.0": "4.3.0",
    "@gjsify/cli": "workspace:^",
    "@types/node": "^25.9.2",
    "@types/three": "^0.185.0",
    "http-server": "^14.1.1",
    "three": "0.185.1",
    "typescript": "^6.0.3"
  },
  "author": "Pascal Garber <pascal@artandcode.studio>",
  "license": "MIT",
  "private": true,
  "version": "0.45.0"
}
