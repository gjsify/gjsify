# Yarn artifacts (Phase D.7d removed yarn from this monorepo; PnP-related
# E2E tests still touch .yarn/* when yarn is on PATH, so keep ignored).
.pnp.*
.yarn/

# Flatpak build artifacts — flatpak-builder build-dir + .flatpak-builder/
# cache + exported single-file bundles. Manifests + metainfo + flathub.json
# are kept (committed source); only build outputs ignored.
.flatpak-builder/
build-dir/
repo/
*.flatpak

*.tsbuildinfo

node_modules/
tmp/
dist/
dist-templates/
lib/
build/
builddir/

# Phase D.7b: the gjsify CLI's GJS bundle is committed so CI (and
# downstream consumers) can bootstrap via `gjs -m cli.gjs.mjs …`
# without Node. Refreshed by `gjsify workspace @gjsify/cli
# build:gjs-bundle` on every CLI source change; a staleness check
# in CI forces a refresh-commit when src/ changes without the
# bundle being rebuilt.
!packages/infra/cli/dist/
!packages/infra/cli/dist/cli.gjs.mjs

# @gjsify/tsc ships its bundled `tsc` as the bin — committed for
# the same reason the CLI bundle is: downstream consumers (and
# `gjsify install --immutable`) must not need a rebuild step on
# install. Rebuilt by `gjsify workspace @gjsify/tsc build`.
!packages/infra/tsc/dist/
!packages/infra/tsc/dist/tsc.gjs.mjs
# The default-library `lib/lib*.d.ts` files tsc resolves on a consumer
# (which has no upstream `typescript`) are NOT committed — they are a
# build-copied artifact (`scripts/build-bundle.mjs` copies them from the
# `typescript` devDep into `packages/infra/tsc/lib/` on every build) and
# are shipped in the npm tarball via `package.json#files` (`lib/lib*.d.ts`).
# Committing ~108 generated `.d.ts` (~76k lines) only bloats the repo; CI
# always runs `gjsify run build` (which builds `@gjsify/tsc`, copying the
# libs) before any step that uses the bundled `tsc` to compile, so a clean
# checkout resolves them after build. `lib/` stays globally ignored.

packages/**/*/test.*.js
packages/**/*/test.*.js.map
packages/**/*/test.*.cjs
packages/**/*/test.*.cjs.map
packages/**/*/test.*.mjs
packages/**/*/test.*.mjs.map
packages/**/*/conformance.*.js
packages/**/*/conformance.*.js.map

examples/**/*/test.*.js
examples/**/*/test.*.js.map
examples/**/*/test.*.cjs
examples/**/*/test.*.cjs.map
examples/**/*/test.*.mjs
examples/**/*/test.*.mjs.map

# Test artifacts (fs tests create temp dirs/files)
fs-*/
foobar/
symlink_tsconfig.json

# Ad-hoc test/debug scripts in project root
test-*.mjs
test-*.js

# Metafile
*.meta.json
meta.json

# Astro
.astro/

# E2E test artifacts
tests/e2e/*/out/

# Copied worker_threads fixtures (sources live under src/fixtures/; copied to
# the package root next to test.{gjs,node}.mjs by `prebuild:test:fixtures` so
# `new URL('./fixtures/...', import.meta.url)` resolves from the test bundle).
packages/node/worker_threads/fixtures/

# Claude Code agent worktree state (per-session, must never enter commits)
.claude/
