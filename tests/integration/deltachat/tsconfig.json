{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "lib",
        "noEmit": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": false,
        "types": ["node"]
    },
    "include": ["src/**/*"]
}
