{
    "name": "@gjsify/integration-nativescript-gi",
    "description": "On-device measurement for ADR 0105 stage 4: an app that gets the GObject-Introspection runtime from the @gjsify/gi-runtime-android plugin dependency alone — no hand-copied .so, no jniLibs in App_Resources — opts the real-Gio GObject engine in at app level, and drives @gjsify/adwaita-core's GOBJECT_VECTORS and LIST_ITEMS_CHANGED_VECTORS against it on a real Android device. Requires the NativeScript CLI + an adb device; NOT wired into CI, and excluded from the root workspace.",
    "version": "0.60.0",
    "private": true,
    "main": "app/app.ts",
    "scripts": {
        "clear": "gjsify clear platforms hooks dist .ns-vite-build *.log tsconfig.tsbuildinfo",
        "check": "tsc --noEmit",
        "prepare:android": "nativescript prepare android --no-hmr --disable-npm-install",
        "build:android": "nativescript build android --no-hmr --disable-npm-install",
        "test:android": "node scripts/run-on-device.mjs android",
        "test:android:pure-js": "GJSIFY_GI_OPT_IN=0 node scripts/run-on-device.mjs android",
        "size:android": "node scripts/apk-size.mjs",
        "test": "node scripts/run-on-device.mjs android"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "tests/integration/nativescript-gi"
    },
    "license": "MIT",
    "dependencies": {
        "@gjsify/adwaita-core": "file:../../../packages/web/adwaita-core",
        "@gjsify/adwaita-gobject-native": "file:../../../packages/nativescript-bridge/gobject",
        "@gjsify/adwaita-nativescript": "file:../../../packages/nativescript-bridge/adwaita",
        "@gjsify/gi-runtime-android": "file:../../../packages/node-gi/gi-runtime-android",
        "@gjsify/nativescript-vite": "file:../../../packages/infra/nativescript-vite",
        "@gjsify/node-gi": "file:../../../packages/node-gi/node-gi",
        "@nativescript/core": "~9.1.3"
    },
    "devDependencies": {
        "@nativescript/android": "9.1.1",
        "@nativescript/types": "~9.0.0",
        "@nativescript/vite": "8.0.18",
        "nativescript": "9.1.2",
        "typescript": "~5.4.0",
        "vite": "^8.0.16"
    }
}
