# The `@gjsify/*` deps are `file:` paths into this checkout and MUST stay symlinks.
# With `install-links=true` npm COPIES a file: dependency into node_modules, and the
# copy is taken at install time: a rebuilt AAR, a recompiled `lib/esm`, a fixed
# `host.nativescript.js` would all be invisible until the next `npm install`, while the
# app kept reporting results for bytes nobody can point at any more. This suite exists
# to measure THIS worktree.
install-links=false
