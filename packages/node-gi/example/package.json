{
  "name": "@gjsify/example-node-gi-quad",
  "description": "One source, four runtimes — the same gi:// GObject-Introspection program built and run byte-identically on GJS, Node.js, Bun and Deno via @gjsify/node-gi.",
  "version": "0.47.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "gjsify": {
    "runtimes": {
      "gjs": "polyfill",
      "node": "none",
      "browser": "none",
      "nativescript": "none"
    },
    "example": {
      "runtimes": [
        "gjs",
        "node",
        "bun",
        "deno"
      ],
      "node": "dist/app.node.mjs"
    }
  },
  "scripts": {
    "build": "npm run build:gjs && npm run build:node",
    "build:gjs": "gjsify build src/app.ts --app gjs --outfile dist/app.gjs.mjs",
    "build:node": "gjsify build src/app.ts --app node --outfile dist/app.node.mjs",
    "start:gjs": "gjs -m dist/app.gjs.mjs",
    "start:node": "node dist/app.node.mjs",
    "start:bun": "bun dist/app.node.mjs",
    "start:deno": "deno run -A --node-modules-dir=manual dist/app.node.mjs",
    "test": "node --test quad.e2e.mjs",
    "clear": "gjsify clear dist"
  },
  "dependencies": {
    "@gjsify/node-gi": "file:../node-gi"
  },
  "devDependencies": {
    "@gjsify/cli": "^0.13.0",
    "@girs/gjs": "4.6.0",
    "@girs/glib-2.0": "4.6.0",
    "@girs/gobject-2.0": "4.6.0",
    "@girs/gio-2.0": "4.6.0"
  },
  "author": "Pascal Garber <pascal@artandcode.studio>",
  "license": "MIT"
}
