{
  "name": "@gjsify/gtk-runtime-darwin-arm64",
  "version": "0.50.0",
  "description": "Batteries-included, relocated GTK/GObject-Introspection runtime bundle for macOS arm64 — lets @gjsify/node-gi load gi:// namespaces (GLib/GObject/Gio/cairo/Pango/Graphene/Gdk) with NO Homebrew GTK. Platform-gated (darwin/arm64 only).",
  "type": "module",
  "license": "SEE LICENSE IN gtk/THIRD-PARTY-NOTICES.md",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./gtk/girepository-1.0": "./gtk/girepository-1.0",
    "./gtk/lib": "./gtk/lib"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "gtk"
  ],
  "gjsify": {
    "runtimes": {
      "gjs": "none",
      "node": "polyfill",
      "browser": "none",
      "nativescript": "none"
    },
    "tier": 3,
    "mediaCapabilities": {
      "gstPluginDir": "gtk/lib/gstreamer-1.0",
      "audioDecode": [
        {
          "format": "WAV / PCM",
          "plugin": "wavparse",
          "element": "wavparse"
        },
        {
          "format": "MP3",
          "plugin": "mpg123",
          "element": "mpg123audiodec"
        },
        {
          "format": "Ogg / Vorbis",
          "plugin": "vorbis",
          "element": "vorbisdec"
        },
        {
          "format": "Opus",
          "plugin": "opus",
          "element": "opusdec"
        },
        {
          "format": "FLAC",
          "plugin": "flac",
          "element": "flacdec"
        },
        {
          "format": "A-law",
          "plugin": "alaw",
          "element": "alawdec"
        },
        {
          "format": "µ-law",
          "plugin": "mulaw",
          "element": "mulawdec"
        }
      ],
      "gaps": [
        {
          "format": "AAC (in M4A)",
          "why": "`isomp4` demuxes the container and `audioparsers` supplies `aacparse`, after which the stream reaches no decoder at all. The two elements that would decode it are `faad` (gst-plugins-bad, GPL) and `avdec_aac` (libav, whose whole closure these bundles refuse), so shipping one is a redistribution decision for whoever ships the product rather than this bundle's."
        }
      ]
    }
  },
  "scripts": {
    "build:bundle": "node ../scripts/build-gtk-runtime-darwin.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjsify/gjsify.git",
    "directory": "packages/node-gi/gtk-runtime-darwin-arm64"
  }
}
