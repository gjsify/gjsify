{
  "name": "@gjsify/gtk-runtime-darwin-x64",
  "version": "0.47.0",
  "description": "Batteries-included, relocated GTK/GObject-Introspection runtime bundle for macOS Intel (x64) — lets @gjsify/node-gi load gi:// namespaces (GLib/GObject/Gio/cairo/Pango/Graphene/Gdk) with NO Homebrew GTK. Platform-gated (darwin/x64 only).",
  "type": "module",
  "license": "SEE LICENSE IN gtk/THIRD-PARTY-NOTICES.md",
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./gtk/girepository-1.0": "./gtk/girepository-1.0",
    "./gtk/lib": "./gtk/lib"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "gtk"
  ],
  "gjsify": {
    "runtimes": {
      "gjs": "none",
      "node": "polyfill",
      "browser": "none",
      "nativescript": "none"
    },
    "tier": 3
  },
  "scripts": {
    "build:bundle": "node ../scripts/build-gtk-runtime-darwin.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjsify/gjsify.git",
    "directory": "packages/node-gi/gtk-runtime-darwin-x64"
  }
}
