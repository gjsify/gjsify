      <source-position filename="src/objc/gjsify-webkit.h" line="119"/>
      <constructor name="new" c:identifier="gjsify_webkit_user_script_new">
        <doc xml:space="preserve"
             filename="src/objc/gjsify-webkit.h"
             line="134">The lists are `scheme://host/path` patterns as WebKitGTK's are, with `*`
wildcards; `*` as a scheme means http or https, and a `*.` host prefix
matches subdomains. Apple's WKUserScript carries no URL filter, so a script
with a non-empty list is wrapped in a guard that tests the document's URL
before running — which costs one thing worth knowing: the guard is a labelled
block, so a filtered script's top-level `let`, `const` and `class` are
block-scoped rather than global. `var` and function declarations are
unaffected, and a script with no lists is not wrapped at all.</doc>
        <source-position filename="src/objc/gjsify-webkit.h" line="153"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/objc/gjsify-webkit.h"
               line="151">a new script.</doc>
          <type name="UserScript" c:type="GjsifyWebKitUserScript*"/>
        </return-value>
        <parameters>
          <parameter name="source" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/objc/gjsify-webkit.h"
                 line="136">the script source.</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
          <parameter name="injected_frames" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/objc/gjsify-webkit.h"
                 line="137">which frames to inject into.</doc>
            <type name="UserContentInjectedFrames"
                  c:type="GjsifyWebKitUserContentInjectedFrames"/>
          </parameter>
          <parameter name="injection_time" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/objc/gjsify-webkit.h"
                 line="138">when to inject.</doc>
            <type name="UserScriptInjectionTime"
                  c:type="GjsifyWebKitUserScriptInjectionTime"/>
          </parameter>
          <parameter name="allow_list"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="src/objc/gjsify-webkit.h"
                 line="139">URI patterns to allow, or %NULL for all.</doc>
            <array c:type="const gchar* const*">
              <type name="utf8" c:type="gchar*"/>
            </array>
          </parameter>
          <parameter name="block_list"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="src/objc/gjsify-webkit.h"
