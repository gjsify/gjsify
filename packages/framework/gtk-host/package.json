{
    "name": "@gjsify/gtk-host",
    "version": "0.45.0",
    "description": "Framework-agnostic GTK4/Adwaita host: the element model UI-framework renderers bind to",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./style": {
            "types": "./lib/types/style/index.d.ts",
            "default": "./lib/esm/style/index.js"
        },
        "./list": {
            "types": "./lib/types/list/index.d.ts",
            "default": "./lib/esm/list/index.js"
        },
        "./vue": {
            "types": "./lib/types/adapters/vue.d.ts",
            "default": "./lib/esm/adapters/vue.js"
        },
        "./solid": {
            "types": "./lib/types/adapters/solid.d.ts",
            "default": "./lib/esm/adapters/solid.js"
        },
        "./react": {
            "types": "./lib/types/adapters/react.d.ts",
            "default": "./lib/esm/adapters/react.js"
        },
        "./react/jsx-runtime": {
            "types": "./lib/types/react-jsx-runtime.d.ts",
            "default": "./lib/esm/react-jsx-runtime.js"
        },
        "./react/jsx-dev-runtime": {
            "types": "./lib/types/react-jsx-runtime.d.ts",
            "default": "./lib/esm/react-jsx-runtime.js"
        },
        "./conformance": {
            "types": "./lib/types/conformance/index.d.ts",
            "default": "./lib/esm/conformance/index.js"
        },
        "./jsx-runtime": {
            "types": "./lib/types/jsx-runtime.d.ts",
            "default": "./lib/esm/jsx-runtime.js"
        },
        "./vue-components": {
            "types": "./lib/types/vue-components.d.ts",
            "default": "./lib/esm/vue-components.js"
        },
        "./generated/props": {
            "types": "./lib/types/generated/props.d.ts",
            "default": "./lib/esm/generated/props.js"
        },
        "./attrs": {
            "types": "./lib/types/attrs.d.ts",
            "default": "./lib/esm/attrs.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.d.mts",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile dist/test.node.mjs --define '__VUE_OPTIONS_API__=false' --define '__VUE_PROD_DEVTOOLS__=false' --define '__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false' --define 'process.env.NODE_ENV=\"production\"' --exclude-globals navigator",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs --define '__VUE_OPTIONS_API__=false' --define '__VUE_PROD_DEVTOOLS__=false' --define '__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false' --define 'process.env.NODE_ENV=\"production\"' --exclude-globals navigator",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:gjs-on-node": "gjsify run build:gjsify && gjsify run build:test:node && NODE_GI_NATIVE=${NODE_GI_NATIVE:-prebuild} node dist/test.node.mjs",
        "generate": "gjsify build src/generator/main.mts --app gjs --outfile tmp/generate.gjs.mjs && gjsify run tmp/generate.gjs.mjs -- --out src/generated && gjsify format src/generated"
    },
    "keywords": [
        "gjs",
        "gtk",
        "adwaita",
        "renderer",
        "host"
    ],
    "dependencies": {
        "@girs/adw-1": "4.3.0",
        "@girs/gdk-4.0": "4.3.0",
        "@girs/gio-2.0": "4.3.0",
        "@girs/gjs": "4.3.0",
        "@girs/glib-2.0": "4.3.0",
        "@girs/gobject-2.0": "4.3.0",
        "@girs/gtk-4.0": "4.3.0",
        "@girs/pango-1.0": "4.3.0"
    },
    "peerDependencies": {
        "@vue/runtime-core": "^3.5.0",
        "solid-js": "^1.9.0",
        "react": "^19.2.0",
        "react-reconciler": "^0.33.0"
    },
    "peerDependenciesMeta": {
        "@vue/runtime-core": {
            "optional": true
        },
        "solid-js": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-reconciler": {
            "optional": true
        }
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@vue/runtime-core": "^3.5.0",
        "solid-js": "^1.9.0",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3",
        "@gjsify/domparser": "workspace:^",
        "@gjsify/node-gi": "file:../../node-gi/node-gi",
        "vue": "^3.5.41",
        "vue-tsc": "^3.3.11",
        "react": "^19.2.0",
        "react-reconciler": "^0.33.0",
        "@types/react": "^19.2.2",
        "@types/react-reconciler": "^0.33.0"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "polyfill",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 3,
        "widgetVocabulary": {
            "role": "reference"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/gtk-host"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/gtk-host#readme"
}
