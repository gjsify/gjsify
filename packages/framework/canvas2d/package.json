{
    "name": "@gjsify/canvas2d",
    "version": "0.45.0",
    "description": "Canvas 2D rendering context for GJS, backed by Cairo",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        }
    },
    "sideEffects": [
        "./lib/esm/register.js"
    ],
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "canvas",
        "canvas2d",
        "cairo"
    ],
    "dependencies": {
        "@girs/gdk-4.0": "4.6.0",
        "@girs/gdkpixbuf-2.0": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/glib-2.0": "4.6.0",
        "@girs/gobject-2.0": "4.6.0",
        "@girs/gtk-4.0": "4.6.0",
        "@girs/pango-1.0": "4.6.0",
        "@girs/pangocairo-1.0": "4.6.0",
        "@gjsify/canvas2d-core": "workspace:^",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/event-bridge": "workspace:^",
        "@gjsify/utils": "workspace:^"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/canvas2d"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/canvas2d#readme"
}
