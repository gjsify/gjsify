{
    "name": "@gjsify/bridge-types",
    "version": "0.43.0",
    "description": "Shared interfaces and environment classes for GTK-DOM bridge containers",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc"
    },
    "keywords": [
        "gjs",
        "gtk",
        "dom",
        "bridge"
    ],
    "dependencies": {
        "@girs/gdk-4.0": "^4.1.0",
        "@girs/gjs": "^4.1.0",
        "@girs/glib-2.0": "^4.1.0",
        "@girs/gtk-4.0": "^4.1.0",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/dom-events": "workspace:^"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/bridge-types"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/bridge-types#readme"
}
