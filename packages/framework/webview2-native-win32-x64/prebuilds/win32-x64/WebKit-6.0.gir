      <constructor name="new_for_world"
                   c:identifier="gjsify_webview2_user_script_new_for_world">
        <doc xml:space="preserve"
             filename="src/c/gjsify-webview2.h"
             line="232">Mirrors `webkit_user_script_new_for_world()` so the call site is portable.
WebView2 has no public isolated-world API — `AddScriptToExecuteOnDocumentCreated`
runs in the page's own world and `ExecuteScript` evaluates there too — so a
non-%NULL @world_name is accepted and WARNED about ONCE per name rather than
silently honoured. Silently running an isolated script in the page's world is
the failure the argument exists to prevent, and a warning is the only honest
report this backend can make of it.</doc>
        <source-position filename="src/c/gjsify-webview2.h" line="251"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/c/gjsify-webview2.h"
               line="249">a new script.</doc>
          <type name="UserScript" c:type="GjsifyWebView2UserScript*"/>
        </return-value>
        <parameters>
          <parameter name="source" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-webview2.h"
                 line="234">the script source.</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
          <parameter name="injected_frames" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-webview2.h"
                 line="235">which frames to inject into.</doc>
            <type name="UserContentInjectedFrames"
                  c:type="GjsifyWebView2UserContentInjectedFrames"/>
          </parameter>
          <parameter name="injection_time" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-webview2.h"
                 line="236">when to inject.</doc>
            <type name="UserScriptInjectionTime"
                  c:type="GjsifyWebView2UserScriptInjectionTime"/>
          </parameter>
          <parameter name="world_name"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-webview2.h"
                 line="237">ignored, and the reason is in the description.</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
          <parameter name="allow_list"
                     transfer-ownership="none"
