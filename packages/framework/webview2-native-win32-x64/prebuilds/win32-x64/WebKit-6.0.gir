      <method name="to_string" c:identifier="gjsify_webview2_value_to_string">
        <doc xml:space="preserve"
             filename="src/c/gjsify-webview2.h"
             line="160">WebView2's `ExecuteScript` returns its result as JSON, where WebKitGTK
returns a live `JSCValue`. A JSON string is unquoted and unescaped here so a
string result reads the same on both backends; everything else is returned as
its JSON text, which is what `JSCValue.to_string()` produces for numbers and
booleans and is a documented divergence for objects.</doc>
        <source-position filename="src/c/gjsify-webview2.h" line="172"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/c/gjsify-webview2.h"
               line="170">the value rendered as a string.</doc>
          <type name="utf8" c:type="gchar*"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-webview2.h"
                 line="162">a value.</doc>
            <type name="Value" c:type="GjsifyWebView2Value*"/>
          </instance-parameter>
        </parameters>
      </method>
    </class>
