{
    "name": "@gjsify/adwaita-react-native",
    "version": "0.45.0",
    "description": "Adwaita widgets with one API surface and two implementations — the real Adw.* widget on GTK4, React Native primitives on a phone",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "react-native": "./lib/esm/index.native.js",
            "default": "./lib/esm/index.gtk.js"
        },
        "./widgets/action-row": {
            "types": "./lib/types/widgets/action-row.d.ts",
            "react-native": "./lib/esm/widgets/action-row.native.js",
            "default": "./lib/esm/widgets/action-row.gtk.js"
        },
        "./widgets/avatar": {
            "types": "./lib/types/widgets/avatar.d.ts",
            "react-native": "./lib/esm/widgets/avatar.native.js",
            "default": "./lib/esm/widgets/avatar.gtk.js"
        },
        "./widgets/banner": {
            "types": "./lib/types/widgets/banner.d.ts",
            "react-native": "./lib/esm/widgets/banner.native.js",
            "default": "./lib/esm/widgets/banner.gtk.js"
        },
        "./widgets/bin": {
            "types": "./lib/types/widgets/bin.d.ts",
            "react-native": "./lib/esm/widgets/bin.native.js",
            "default": "./lib/esm/widgets/bin.gtk.js"
        },
        "./widgets/button-content": {
            "types": "./lib/types/widgets/button-content.d.ts",
            "react-native": "./lib/esm/widgets/button-content.native.js",
            "default": "./lib/esm/widgets/button-content.gtk.js"
        },
        "./widgets/button-row": {
            "types": "./lib/types/widgets/button-row.d.ts",
            "react-native": "./lib/esm/widgets/button-row.native.js",
            "default": "./lib/esm/widgets/button-row.gtk.js"
        },
        "./widgets/clamp": {
            "types": "./lib/types/widgets/clamp.d.ts",
            "react-native": "./lib/esm/widgets/clamp.native.js",
            "default": "./lib/esm/widgets/clamp.gtk.js"
        },
        "./widgets/entry-row": {
            "types": "./lib/types/widgets/entry-row.d.ts",
            "react-native": "./lib/esm/widgets/entry-row.native.js",
            "default": "./lib/esm/widgets/entry-row.gtk.js"
        },
        "./widgets/expander-row": {
            "types": "./lib/types/widgets/expander-row.d.ts",
            "react-native": "./lib/esm/widgets/expander-row.native.js",
            "default": "./lib/esm/widgets/expander-row.gtk.js"
        },
        "./widgets/header-bar": {
            "types": "./lib/types/widgets/header-bar.d.ts",
            "react-native": "./lib/esm/widgets/header-bar.native.js",
            "default": "./lib/esm/widgets/header-bar.gtk.js"
        },
        "./widgets/spinner": {
            "types": "./lib/types/widgets/spinner.d.ts",
            "react-native": "./lib/esm/widgets/spinner.native.js",
            "default": "./lib/esm/widgets/spinner.gtk.js"
        },
        "./widgets/status-page": {
            "types": "./lib/types/widgets/status-page.d.ts",
            "react-native": "./lib/esm/widgets/status-page.native.js",
            "default": "./lib/esm/widgets/status-page.gtk.js"
        },
        "./widgets/switch-row": {
            "types": "./lib/types/widgets/switch-row.d.ts",
            "react-native": "./lib/esm/widgets/switch-row.native.js",
            "default": "./lib/esm/widgets/switch-row.gtk.js"
        },
        "./widgets/toast-overlay": {
            "types": "./lib/types/widgets/toast-overlay.d.ts",
            "react-native": "./lib/esm/widgets/toast-overlay.native.js",
            "default": "./lib/esm/widgets/toast-overlay.gtk.js"
        },
        "./widgets/toolbar-view": {
            "types": "./lib/types/widgets/toolbar-view.d.ts",
            "react-native": "./lib/esm/widgets/toolbar-view.native.js",
            "default": "./lib/esm/widgets/toolbar-view.gtk.js"
        },
        "./widgets/window-title": {
            "types": "./lib/types/widgets/window-title.d.ts",
            "react-native": "./lib/esm/widgets/window-title.native.js",
            "default": "./lib/esm/widgets/window-title.gtk.js"
        },
        "./widgets/wrap-box": {
            "types": "./lib/types/widgets/wrap-box.d.ts",
            "react-native": "./lib/esm/widgets/wrap-box.native.js",
            "default": "./lib/esm/widgets/wrap-box.gtk.js"
        },
        "./testing/react-native": {
            "types": "./lib/types/testing/react-native.d.ts",
            "default": "./lib/esm/testing/react-native.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs dist",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,tsx,js}' --exclude 'src/**/*.spec.{mts,ts,tsx}' 'src/test.{mts,ts}' 'src/test.node.mts'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs --define \"process.env.NODE_ENV='production'\" --exclude-globals navigator",
        "build:test:node": "gjsify build src/test.node.mts --app node --outfile dist/test.node.mjs --exclude-globals navigator --alias react-native=@gjsify/adwaita-react-native/testing/react-native",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node dist/test.node.mjs"
    },
    "keywords": [
        "gjs",
        "gtk",
        "adwaita",
        "react",
        "react-native",
        "design-system"
    ],
    "dependencies": {
        "@gjsify/adwaita-core": "workspace:^",
        "@gjsify/gtk-host": "workspace:^"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-native": ">=0.87 <1"
    },
    "peerDependenciesMeta": {
        "react-native": {
            "optional": true
        }
    },
    "devDependencies": {
        "@girs/adw-1": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/gtk-4.0": "4.6.0",
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "@types/react": "^19.2.2",
        "@types/react-test-renderer": "^19.1.0",
        "react": "^19.2.0",
        "react-native": ">=0.87 <1",
        "react-test-renderer": "^19.2.8",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "polyfill",
            "browser": "none",
            "nativescript": "none",
            "react-native": "native"
        },
        "tier": 3,
        "widgetVocabulary": {
            "role": "renderer"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/adwaita-react-native"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/adwaita-react-native#readme"
}
