{
    "compilerOptions": {
        "outDir": "lib",
        "declarationDir": "lib/types",
        "rootDir": "src",
        "tsBuildInfoFile": "tmp/.tsbuildinfo",
        "target": "es2020",
        "declaration": true,
        "emitDeclarationOnly": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "removeComments": false,
        "sourceMap": true,
        "skipLibCheck": true,
        "composite": true,
        "incremental": true,
        "types": ["node", "@girs/gjs"],
        "lib": ["es2020"],
        "strict": true
    },
    "include": [
        "src",
        "../../../node_modules/@girs/gtk-4.0/gtk-4.0-ambient.d.ts",
        "../../../node_modules/@girs/gio-2.0/gio-2.0-ambient.d.ts",
        "../../../node_modules/@girs/glib-2.0/glib-2.0-ambient.d.ts"
    ],
    "exclude": ["src/test.mts"]
}
