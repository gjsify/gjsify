{
    "name": "@gjsify/video",
    "version": "0.4.41",
    "description": "VideoBridge — GTK container for HTMLVideoElement backed by GStreamer gtk4paintablesink",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "rm -rf lib tmp tsconfig.tsbuildinfo || exit 0",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc"
    },
    "keywords": [
        "gjs",
        "gtk",
        "video",
        "gstreamer",
        "bridge"
    ],
    "dependencies": {
        "@girs/gdk-4.0": "4.0.0-4.0.4",
        "@girs/gdkpixbuf-2.0": "2.0.0-4.0.4",
        "@girs/gjs": "4.0.4",
        "@girs/glib-2.0": "2.88.0-4.0.4",
        "@girs/gobject-2.0": "2.88.0-4.0.4",
        "@girs/gst-1.0": "1.28.1-4.0.4",
        "@girs/gtk-4.0": "4.23.0-4.0.4",
        "@gjsify/bridge-types": "workspace:^",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/dom-exception": "workspace:^",
        "@gjsify/event-bridge": "workspace:^"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/video"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/video#readme"
}
