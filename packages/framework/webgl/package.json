{
    "name": "@gjsify/webgl",
    "version": "0.48.0",
    "description": "WebGL module for Gjs",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        }
    },
    "sideEffects": [
        "./lib/esm/register.js"
    ],
    "files": [
        "lib"
    ],
    "gjsify": {
        "platforms": [
            "linux-x64",
            "linux-arm64",
            "linux-ppc64",
            "linux-s390x",
            "linux-riscv64",
            "darwin-arm64",
            "darwin-x64",
            "win32-x64"
        ],
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "scripts": {
        "clear": "gjsify clear lib tmp build test.gjs.mjs tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "init:meson": "meson setup build .",
        "init:meson:wipe": "gjsify run init:meson --wipe",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/ts/**/*.{ts,js}'",
        "build:meson": "gjsify run init:meson && meson compile -C build",
        "build:types": "gjsify tsc",
        "build:prebuilds": "gjsify run build:meson && node ../../../scripts/stage-prebuild.mjs .",
        "build:test": "gjsify build src/ts/test.ts --app gjs --outfile test.gjs.js",
        "build:conformance": "gjsify build src/ts/conformance-test.ts --app gjs --outfile conformance.gjs.js",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.js",
        "test:conformance": "gjsify run build:gjsify && gjsify run build:conformance && gjsify run conformance.gjs.js"
    },
    "keywords": [
        "gjs",
        "WebGL"
    ],
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/bit-twiddle": "^1.0.3",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@girs/gdkpixbuf-2.0": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/gtk-4.0": "4.6.0",
        "@girs/gwebgl-0.1": "0.1.0-4.0.0-rc.5",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/event-bridge": "workspace:^",
        "@gjsify/utils": "workspace:^",
        "bit-twiddle": "^1.0.2",
        "glsl-tokenizer": "^2.1.5"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/webgl"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/webgl#readme",
    "optionalDependencies": {
        "@gjsify/webgl-darwin-arm64": "workspace:*",
        "@gjsify/webgl-darwin-x64": "workspace:*",
        "@gjsify/webgl-linux-arm64": "workspace:*",
        "@gjsify/webgl-linux-ppc64": "workspace:*",
        "@gjsify/webgl-linux-riscv64": "workspace:*",
        "@gjsify/webgl-linux-s390x": "workspace:*",
        "@gjsify/webgl-linux-x64": "workspace:*",
        "@gjsify/webgl-win32-x64": "workspace:*"
    }
}
