{
    "name": "@gjsify/iframe",
    "version": "0.45.0",
    "description": "HTMLIFrameElement for GJS, backed by WebKit.WebView",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        }
    },
    "sideEffects": [
        "./lib/esm/register.js",
        "./lib/esm/promisify.js"
    ],
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile dist/test.node.mjs --alias @gjsify/message-channel=../../web/message-channel/lib/esm/index.js",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:gjs-on-node": "gjsify run build:gjsify && gjsify run build:test:node && node dist/test.node.mjs"
    },
    "keywords": [
        "gjs",
        "iframe",
        "webview",
        "webkit",
        "dom"
    ],
    "dependencies": {
        "@girs/gdkpixbuf-2.0": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/gtk-4.0": "4.6.0",
        "@girs/javascriptcore-6.0": "4.6.0",
        "@girs/webkit-6.0": "4.6.0",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/message-channel": "workspace:^",
        "@gjsify/webkit-native": "workspace:^"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "polyfill",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/framework/iframe"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/framework/iframe#readme"
}
