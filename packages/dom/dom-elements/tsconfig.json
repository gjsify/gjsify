{
	"compilerOptions": {
		"outDir": "lib",
    	"declarationDir": "lib/types",
		"rootDir": "src",
		"tsBuildInfoFile": "tsconfig.tsbuildinfo",
		"target": "es2020",
		"declaration": true,
		"emitDeclarationOnly": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"resolveJsonModule": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"removeComments": false,
		"preserveConstEnums": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"composite": true,
		"incremental": true,
		"types": ["node", "@girs/gjs", "@girs/gdkpixbuf-2.0", "@girs/gio-2.0", "@girs/glib-2.0"],
		"lib": [
			"es2015",
			"es2016",
			"es2017"
		]
	},
	"include": [
		"@types/node",
		"src"
	],
  	"exclude": ["src/test.mts", "src/test.browser.mts"]
}
