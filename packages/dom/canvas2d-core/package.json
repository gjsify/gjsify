{
    "name": "@gjsify/canvas2d-core",
    "version": "0.47.0",
    "description": "Cairo-backed Canvas 2D core (CanvasRenderingContext2D, Path2D, ImageData) — headless root entry, no GTK dependency",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./gdk": {
            "types": "./lib/types/gdk-pixel-bridge.d.ts",
            "default": "./lib/esm/gdk-pixel-bridge.js"
        },
        "./globals": "./globals.mjs"
    },
    "files": [
        "lib",
        "globals.mjs"
    ],
    "sideEffects": [
        "./src/gdk-pixel-bridge.ts",
        "./lib/esm/gdk-pixel-bridge.js",
        "./globals.mjs"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:browser": "gjsify build src/test.browser.mts --app browser --outfile dist/test.browser.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "canvas",
        "canvas2d",
        "cairo",
        "offscreen"
    ],
    "dependencies": {
        "@girs/gdk-4.0": "4.6.0",
        "@girs/gdkpixbuf-2.0": "4.6.0",
        "@girs/gio-2.0": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/glib-2.0": "4.6.0",
        "@girs/gobject-2.0": "4.6.0",
        "@girs/pango-1.0": "4.6.0",
        "@girs/pangocairo-1.0": "4.6.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/dom-elements": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "native",
            "nativescript": "none"
        },
        "headless": [
            "Gdk",
            "GdkPixbuf",
            "Gsk",
            "Gtk",
            "Adw"
        ],
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/dom/canvas2d-core"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/dom/canvas2d-core#readme"
}
