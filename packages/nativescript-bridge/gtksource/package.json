{
    "name": "@gjsify/gtksource-nativescript",
    "version": "0.56.0",
    "description": "GtkSource.View for NativeScript — an Android EditText with incremental syntax highlighting, a line-number gutter and GtkSourceView language/scheme managers, driven by @gjsify/gtksource-core",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./gtksource": {
            "types": "./lib/types/namespace/gtksource.d.ts",
            "default": "./lib/esm/namespace/gtksource.js"
        },
        "./builder": {
            "types": "./lib/types/builder.d.ts",
            "default": "./lib/esm/builder.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.d.mts",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.trees.gjs.mjs test.trees.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:trees:gjs && gjsify run build:test:trees:node",
        "build:test:trees:gjs": "gjsify build src/test.trees.mts --app gjs --no-minify --alias @nativescript/core=@gjsify/adwaita-nativescript/testing/ns-core --outfile test.trees.gjs.mjs",
        "build:test:trees:node": "gjsify build src/test.trees.mts --app node --no-minify --alias @nativescript/core=@gjsify/adwaita-nativescript/testing/ns-core --outfile test.trees.node.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.trees.gjs.mjs",
        "test:node": "node test.trees.node.mjs"
    },
    "keywords": [
        "gjs",
        "nativescript",
        "gtksourceview",
        "source-view",
        "syntax",
        "highlighting",
        "android",
        "editor"
    ],
    "dependencies": {
        "@gjsify/adwaita-nativescript": "workspace:^",
        "@gjsify/gtksource-core": "workspace:^"
    },
    "peerDependencies": {
        "@nativescript/core": "*"
    },
    "peerDependenciesMeta": {
        "@nativescript/core": {
            "optional": true
        }
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "none",
            "node": "none",
            "browser": "none",
            "nativescript": "native"
        },
        "tier": 2,
        "nativescriptPlatforms": [
            "android"
        ]
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/nativescript-bridge/gtksource"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/nativescript-bridge/gtksource#readme"
}
