{
    "name": "@gjsify/adwaita-nativescript",
    "version": "0.51.1",
    "description": "Native Adwaita widgets for the NativeScript runtime — real NativeScript components (StackLayout/GridLayout/Switch/Label) styled like Libadwaita, not a webview",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./adw": {
            "types": "./lib/types/namespace/adw.d.ts",
            "default": "./lib/esm/namespace/adw.js"
        },
        "./gtk": {
            "types": "./lib/types/namespace/gtk.d.ts",
            "default": "./lib/esm/namespace/gtk.js"
        },
        "./builder": {
            "types": "./lib/types/builder/index.d.ts",
            "default": "./lib/esm/builder/index.js"
        },
        "./theme/adwaita.css": "./src/theme/adwaita.css",
        "./fonts": {
            "types": "./lib/types/fonts.d.ts",
            "default": "./lib/esm/fonts.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.d.mts",
        "!lib/types/**/*.spec.d.ts",
        "src/theme/adwaita.css"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs test.node.mjs test.trees.gjs.mjs test.trees.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node && gjsify run build:test:trees:gjs && gjsify run build:test:trees:node",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "build:test:trees:gjs": "gjsify build src/test.trees.mts --app gjs --no-minify --alias @nativescript/core=../testing/ns-core.mjs --outfile test.trees.gjs.mjs",
        "build:test:trees:node": "gjsify build src/test.trees.mts --app node --no-minify --alias @nativescript/core=../testing/ns-core.mjs --outfile test.trees.node.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs && gjsify run test.trees.gjs.mjs",
        "test:node": "node test.node.mjs && node test.trees.node.mjs"
    },
    "keywords": [
        "gjs",
        "nativescript",
        "adwaita",
        "gnome",
        "android",
        "ios",
        "design-system"
    ],
    "dependencies": {
        "@gjsify/adwaita-core": "workspace:^",
        "@gjsify/adwaita-fonts": "workspace:^",
        "@gjsify/adwaita-icons": "workspace:^",
        "@gjsify/native-platform": "workspace:^"
    },
    "peerDependencies": {
        "@nativescript/core": "*"
    },
    "peerDependenciesMeta": {
        "@nativescript/core": {
            "optional": true
        }
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "none",
            "node": "none",
            "browser": "none",
            "nativescript": "native"
        },
        "tier": 2,
        "nativescriptPlatforms": [
            "android",
            "ios"
        ],
        "widgetVocabulary": {
            "role": "renderer"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/nativescript-bridge/adwaita"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/nativescript-bridge/adwaita#readme"
}
