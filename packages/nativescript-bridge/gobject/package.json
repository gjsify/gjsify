{
    "name": "@gjsify/adwaita-gobject-native",
    "version": "0.59.1",
    "description": "Real GObject behind @gjsify/adwaita-core's GObject subset — a GObjectEngine whose property store and signal bus are a live GObject reached through node-gi (ADR 0105)",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.d.mts",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp dist tsconfig.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:node-gi",
        "build:test:node-gi": "gjsify build src/test.node-gi.mts --app node --outfile dist/test.node-gi.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test",
        "test:gjs-on-node": "gjsify run build:test:node-gi && node dist/test.node-gi.mjs"
    },
    "keywords": [
        "gjs",
        "gobject",
        "node-gi",
        "nativescript",
        "android",
        "adwaita"
    ],
    "dependencies": {
        "@gjsify/adwaita-core": "workspace:^"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/node-gi": "file:../../node-gi/node-gi",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "none",
            "node": "polyfill",
            "browser": "none",
            "nativescript": "native"
        },
        "tier": 3,
        "nativescriptPlatforms": [
            "android"
        ]
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/nativescript-bridge/gobject"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/nativescript-bridge/gobject#readme"
}
