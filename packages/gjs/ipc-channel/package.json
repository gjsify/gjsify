{
    "name": "@gjsify/ipc-channel",
    "version": "0.64.34",
    "description": "Message channel between two GJS processes: line framing, structured-clone wire codec, SharedBuffer fd transfer, cross-process MessagePort routing",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./wire": {
            "types": "./lib/types/wire.d.ts",
            "default": "./lib/esm/wire.js"
        },
        "./node-channel": {
            "types": "./lib/types/node-channel.d.ts",
            "default": "./lib/esm/node-channel.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "ipc",
        "structured-clone",
        "subprocess"
    ],
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@girs/gio-2.0": "5.4.0",
        "@girs/glib-2.0": "5.4.0",
        "@gjsify/message-channel": "workspace:^",
        "@gjsify/sab-native": "workspace:^",
        "@gjsify/utils": "workspace:^"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "runtimeSubpaths": {
            "./wire": {
                "gjs": "polyfill",
                "node": "polyfill",
                "browser": "polyfill",
                "nativescript": "polyfill"
            },
            "./node-channel": {
                "gjs": "polyfill",
                "node": "partial",
                "browser": "partial",
                "nativescript": "partial"
            }
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/gjs/ipc-channel"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/gjs/ipc-channel#readme"
}
