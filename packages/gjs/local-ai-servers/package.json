{
    "name": "@gjsify/local-ai-servers",
    "version": "0.64.19",
    "description": "Find local inference servers (Ollama, LM Studio, llama.cpp) and the models they have loaded, so an app can reuse one through its OpenAI-compatible endpoint instead of loading a second copy. Loopback only, short timeouts, never inference.",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "keywords": [
        "ollama",
        "lm-studio",
        "llama.cpp",
        "openai-compatible",
        "local-ai",
        "discovery"
    ],
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/fetch": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/gjs/local-ai-servers"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/gjs/local-ai-servers#readme",
    "gjsify": {
        "tier": 3,
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "headless": true
    }
}
