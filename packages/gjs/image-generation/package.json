{
    "name": "@gjsify/image-generation",
    "version": "0.64.27",
    "description": "Image generation in the WebML CG lifecycle shape: an ImageGenerator with availability(), create({ monitor, signal }) and destroy(), and a local stable-diffusion.cpp engine for diffusion models on Node and GJS.",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./engine": {
            "types": "./lib/types/engine.d.ts",
            "default": "./lib/esm/engine.js"
        },
        "./sdcpp": {
            "types": "./lib/types/sdcpp.d.ts",
            "default": "./lib/esm/sdcpp.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs --external @gjsify/napi",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs --external @gjsify/napi",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "keywords": [
        "image-generation",
        "diffusion",
        "ai",
        "stable-diffusion",
        "sd.cpp",
        "webml"
    ],
    "dependencies": {
        "@gjsify/buffer": "workspace:^",
        "@gjsify/fs": "workspace:^",
        "@gjsify/machine-fit": "workspace:^",
        "@gjsify/model-store": "workspace:^",
        "@gjsify/path": "workspace:^",
        "@gjsify/process": "workspace:^",
        "@gjsify/zlib": "workspace:^"
    },
    "peerDependencies": {
        "@gjsify/napi": "^0.64.19"
    },
    "peerDependenciesMeta": {
        "@gjsify/napi": {
            "optional": true
        }
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/gjs/image-generation"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/gjs/image-generation#readme",
    "gjsify": {
        "tier": 3,
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "os": {
            "linux": "supported",
            "darwin": "partial",
            "win32": "partial"
        },
        "osNotes": {
            "darwin": "The sd.cpp engine runs on Node only: the GJS route loads stable-diffusion.cpp's Linux prebuilt binaries.",
            "win32": "The sd.cpp engine runs on Node only: the GJS route loads stable-diffusion.cpp's Linux prebuilt binaries."
        },
        "headless": true
    }
}
