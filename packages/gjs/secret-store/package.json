{
    "name": "@gjsify/secret-store",
    "version": "0.64.57",
    "description": "Secrets an app owns (a typed password, its own refresh token), kept per namespace by a platform driver. No driver means it throws, naming the platform: never a silent plaintext fallback (ADR 0152).",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "sideEffects": [
        "./lib/esm/libsecret.js"
    ],
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./libsecret": {
            "types": "./lib/types/libsecret.d.ts",
            "default": "./lib/esm/libsecret.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.spec.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}' 'src/test.gjs.mts' 'src/**/*.gjs.spec.ts'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.gjs.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "keywords": [
        "gjs",
        "secret",
        "password",
        "keystore",
        "keychain",
        "libsecret"
    ],
    "dependencies": {
        "@girs/gio-2.0": "5.4.0",
        "@girs/gjs": "5.4.0",
        "@girs/glib-2.0": "5.4.0",
        "@girs/gobject-2.0": "5.4.0",
        "@girs/secret-1": "5.4.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/gjs/secret-store"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/gjs/secret-store#readme",
    "gjsify": {
        "tier": 3,
        "runtimes": {
            "gjs": "partial",
            "node": "none",
            "browser": "none",
            "nativescript": "partial"
        },
        "headless": true
    }
}
