{
    "name": "@gjsify/utils",
    "version": "0.47.0",
    "description": "Utils module for gjsify",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "sideEffects": false,
    "files": [
        "lib"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./core": {
            "types": "./lib/types/core.d.ts",
            "default": "./lib/esm/core.js"
        },
        "./main-loop": {
            "types": "./lib/types/main-loop.d.ts",
            "default": "./lib/esm/main-loop.js"
        }
    },
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.ts --app gjs --outfile test.gjs.js",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.js"
    },
    "keywords": [
        "gjs",
        "node",
        "fs"
    ],
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@girs/gio-2.0": "4.6.0",
        "@girs/giounix-2.0": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/glib-2.0": "4.6.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/gjs/utils"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/gjs/utils#readme",
    "gjsify": {
        "tier": 1,
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "runtimeSubpaths": {
            "./core": {
                "gjs": "polyfill",
                "node": "polyfill",
                "browser": "polyfill",
                "nativescript": "polyfill"
            },
            "./main-loop": {
                "gjs": "polyfill",
                "node": "polyfill",
                "browser": "polyfill",
                "nativescript": "polyfill"
            }
        },
        "os": {
            "linux": "supported",
            "darwin": "supported",
            "win32": "supported"
        }
    }
}
