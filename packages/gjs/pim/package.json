{
    "name": "@gjsify/pim",
    "version": "0.64.56",
    "description": "Calendars and tasks behind one port: the CalendarBackend interface moves iCalendar text, drivers move it to CalDAV (plain fetch, every runtime) or Evolution Data Server (typelibs loaded on first use).",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./caldav": {
            "types": "./lib/types/caldav/index.d.ts",
            "default": "./lib/esm/caldav/index.js"
        },
        "./eds": {
            "types": "./lib/types/eds/index.d.ts",
            "default": "./lib/esm/eds/index.js"
        }
    },
    "files": [
        "lib",
        "!lib/types/**/*.spec.d.ts",
        "!lib/types/fake-dav-server.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib tmp tsconfig.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}' 'src/test.gjs.mts' 'src/fake-dav-server.ts'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.gjs.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify env DBUS_SESSION_BUS_ADDRESS=unix:path=/nonexistent XDG_RUNTIME_DIR=/nonexistent gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "keywords": [
        "calendar",
        "tasks",
        "reminders",
        "icalendar",
        "caldav",
        "evolution-data-server",
        "eds"
    ],
    "dependencies": {
        "@girs/ecal-2.0": "5.4.0",
        "@girs/edataserver-1.2": "5.4.0",
        "@girs/icalglib-3.0": "5.4.0",
        "@gjsify/dav": "workspace:^"
    },
    "devDependencies": {
        "@girs/gio-2.0": "5.4.0",
        "@girs/gjs": "5.4.0",
        "@girs/glib-2.0": "5.4.0",
        "@girs/gobject-2.0": "5.4.0",
        "@gjsify/cli": "workspace:^",
        "@gjsify/fetch": "workspace:^",
        "@gjsify/http": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/gjs/pim"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/gjs/pim#readme",
    "gjsify": {
        "tier": 3,
        "runtimes": {
            "gjs": "native",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "headless": [
            "Gdk",
            "GdkPixbuf",
            "Gsk",
            "Gtk",
            "Adw"
        ],
        "os": {
            "linux": "supported",
            "darwin": "none",
            "win32": "none"
        },
        "osNotes": {
            "darwin": "The CalDAV driver is plain fetch and works; the EDS driver answers BackendUnavailableError because Evolution Data Server is not there.",
            "win32": "The CalDAV driver is plain fetch and works; the EDS driver answers BackendUnavailableError because Evolution Data Server is not there."
        }
    }
}
