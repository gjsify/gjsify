{
    "name": "@gjsify/node-globals",
    "version": "0.45.0",
    "description": "Node.js globals module for Gjs",
    "keywords": [
        "gjs",
        "node",
        "globals"
    ],
    "author": "Pascal Garber",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "files": [
        "lib"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        },
        "./register/process": {
            "default": "./lib/esm/register/process.js"
        },
        "./register/buffer": {
            "default": "./lib/esm/register/buffer.js"
        },
        "./register/timers": {
            "default": "./lib/esm/register/timers.js"
        },
        "./register/encoding": {
            "default": "./lib/esm/register/encoding.js"
        },
        "./register/url": {
            "default": "./lib/esm/register/url.js"
        },
        "./register/structured-clone": {
            "default": "./lib/esm/register/structured-clone.js"
        },
        "./register/microtask": {
            "default": "./lib/esm/register/microtask.js"
        }
    },
    "sideEffects": [
        "./lib/esm/register.js",
        "./lib/esm/register/*.js"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "dependencies": {
        "@girs/glib-2.0": "^4.1.0",
        "@gjsify/buffer": "workspace:^",
        "@gjsify/process": "workspace:^",
        "@gjsify/url": "workspace:^",
        "@gjsify/utils": "workspace:^"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/node/globals"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/node/globals#readme"
}
