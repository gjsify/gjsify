{
    "name": "@gjsify/crypto",
    "version": "0.45.0",
    "description": "Node.js crypto module for Gjs",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./nativescript": {
            "types": "./lib/types/nativescript.d.ts",
            "default": "./lib/esm/nativescript.js"
        },
        "./browser": {
            "types": "./lib/types/browser.d.ts",
            "default": "./lib/esm/browser.js"
        },
        "./browser/hash": {
            "types": "./lib/types/browser/hash.d.ts",
            "default": "./lib/esm/browser/hash.js"
        },
        "./browser/hmac": {
            "types": "./lib/types/browser/hmac.d.ts",
            "default": "./lib/esm/browser/hmac.js"
        },
        "./browser/random": {
            "types": "./lib/types/browser/random.d.ts",
            "default": "./lib/esm/browser/random.js"
        },
        "./browser/kdf": {
            "types": "./lib/types/browser/kdf.d.ts",
            "default": "./lib/esm/browser/kdf.js"
        },
        "./browser/cipher": {
            "types": "./lib/types/browser/cipher.d.ts",
            "default": "./lib/esm/browser/cipher.js"
        },
        "./browser/sign": {
            "types": "./lib/types/browser/sign.d.ts",
            "default": "./lib/esm/browser/sign.js"
        },
        "./browser/ecdh": {
            "types": "./lib/types/browser/ecdh.d.ts",
            "default": "./lib/esm/browser/ecdh.js"
        },
        "./browser/stubs": {
            "types": "./lib/types/browser/stubs.d.ts",
            "default": "./lib/esm/browser/stubs.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node && gjsify run build:test:browser",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "build:test:browser": "gjsify build src/test.browser.mts --app browser --outfile dist/test.browser.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "keywords": [
        "gjs",
        "node",
        "crypto"
    ],
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/diffie-hellman": "^5.0.3",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@girs/glib-2.0": "4.3.0",
        "@gjsify/buffer": "workspace:^",
        "@gjsify/stream": "workspace:^",
        "@gjsify/webcrypto": "workspace:^",
        "@noble/hashes": "^2.2.0"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "partial",
            "nativescript": "none"
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/node/crypto"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/node/crypto#readme"
}
