{
    "name": "@gjsify/terminal-native-linux-s390x",
    "version": "0.46.0",
    "description": "linux-s390x prebuilt native library + GObject-Introspection typelib for @gjsify/terminal-native. Installed automatically on linux/s390x as an optionalDependency of that package (ADR 0017) and skipped everywhere else. Contains no JavaScript.",
    "license": "MIT",
    "os": [
        "linux"
    ],
    "cpu": [
        "s390x"
    ],
    "files": [
        "prebuilds"
    ],
    "gjsify": {
        "glibcRequires": {
            "linux-s390x": "2.2"
        },
        "platforms": [
            "linux-s390x"
        ],
        "prebuilds": "prebuilds",
        "tier": 1
    },
    "scripts": {
        "clear": "echo 'nothing to do'",
        "check": "echo 'nothing to do'",
        "build": "echo 'nothing to do'",
        "test": "echo 'nothing to do'"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/node/terminal-native-linux-s390x"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/node/terminal-native-linux-s390x#readme"
}
