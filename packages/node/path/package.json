{
    "name": "@gjsify/path",
    "version": "0.44.0",
    "description": "Node.js path module for Gjs",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./posix": {
            "types": "./lib/types/posix.d.ts",
            "default": "./lib/esm/posix.js"
        },
        "./win32": {
            "types": "./lib/types/win32.d.ts",
            "default": "./lib/esm/win32.js"
        }
    },
    "dependencies": {
        "@gjsify/utils": "workspace:^"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs test.node.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs && gjsify run build:test:node",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:node": "gjsify build src/test.mts --app node --outfile test.node.mjs",
        "build:test:browser": "gjsify build src/test.browser.mts --app browser --outfile dist/test.browser.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:node && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "test:node": "node test.node.mjs"
    },
    "keywords": [
        "gjs",
        "node",
        "path"
    ],
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "polyfill",
            "browser": "polyfill",
            "nativescript": "polyfill"
        },
        "tier": 1,
        "os": {
            "linux": "supported",
            "darwin": "supported",
            "win32": "partial"
        },
        "osNotes": {
            "win32": "The win32 flavour is complete and driven directly by host-flavour.spec.ts from every host (drive letters, UNC, toNamespacedPath, parse/format), so its SEMANTICS are exercised on Linux. What no runner can confirm yet is the SELECTION: `hostOs()` returning \"win32\" picks it, and no GJS-on-Windows host exists to observe that. On a POSIX host \"selected per host\" and \"posix hardcoded\" are indistinguishable at runtime, which is why `selectFlavour(os)` takes the OS as an argument — that half is asserted. Promote to \"supported\" from the first GJS run on Windows."
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/node/path"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/node/path#readme"
}
