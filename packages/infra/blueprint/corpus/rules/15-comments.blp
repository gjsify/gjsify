// a line comment before the directive
using Gtk 4.0;

/* a block comment
   spanning two lines */
Gtk.CenterBox {
  // a line comment before a property
  orientation: /* between the colon and the value */ vertical; // and one after it

  [start] // after a slot bracket
  Gtk.Label {
    label: "commented";

    styles [
      "a", // inside a list
      /* and before an item */ "b",
    ]
  }
  /* before the closing brace */
}
// and after it
