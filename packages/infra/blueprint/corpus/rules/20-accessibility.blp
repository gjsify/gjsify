using Gtk 4.0;

Gtk.Button {
  label: "described";

  accessibility {
    label: "an accessible name";
    row-index: 3;
    checked: true;
    hidden: true;
    pressed: mixed;
    orientation: vertical;
    autocomplete: inline;
    value-now: 0.5;
    description: _("a translatable description");
    labelled-by: [labelA, labelB];
  }
}

Gtk.Label labelA {
}

Gtk.Label labelB {
}
