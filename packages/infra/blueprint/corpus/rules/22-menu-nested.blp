using Gtk 4.0;

menu nestedMenu {
  section {
    submenu {
      label: _("More");

      item ("Deep", "app.deep")
      item (_("Marked"), "app.marked")
      item (C_("verb", "Context"), "app.context", "edit-copy-symbolic")
      item ("Alone")
    }
  }
}

Gtk.MenuButton {
  menu-model: nestedMenu;
}
