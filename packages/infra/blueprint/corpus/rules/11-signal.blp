using Gtk 4.0;

Gtk.Box {
  Gtk.Label labelOne {
  }

  Gtk.Button {
    label: "press";
    clicked => $onClicked();
    activate => $onActivate() swapped;
    map => $onMap() after;
    realize => $onRealize(labelOne);
    unrealize => $onUnrealize(labelOne) not-swapped;
    notify::sensitive => $onSensitive();
  }
}
