using Gtk 4.0;
using Adw 1;

Adw.Window {
  content: Gtk.Box boxOne {
    Gtk.Label labelOne {
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 400px")

    setters {
      boxOne.visible: false;
      boxOne.opacity: 0.5;
      boxOne.orientation: vertical;
      labelOne.label: _("narrow");
    }
  }
}
