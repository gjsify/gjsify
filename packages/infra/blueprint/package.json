{
    "name": "@gjsify/blueprint",
    "version": "0.51.1",
    "description": "The GNOME Blueprint parser, GtkBuilder-XML emitter and SharedNode projection of ADR 0053, with the corpus of reference-compiler goldens they are measured against.",
    "type": "module",
    "main": "src/index.mjs",
    "types": "src/index.d.mts",
    "exports": {
        ".": {
            "types": "./src/index.d.mts",
            "default": "./src/index.mjs"
        },
        "./corpus": {
            "types": "./corpus/manifest.d.mts",
            "default": "./corpus/manifest.mjs"
        },
        "./corpus/expectations": "./corpus/expectations.mjs",
        "./corpus/real-expectations": "./corpus/real-expectations.mjs",
        "./package.json": "./package.json"
    },
    "files": [
        "corpus",
        "src"
    ],
    "dependencies": {
        "@girs/adw-1": "5.4.0",
        "@girs/gdk-4.0": "5.4.0",
        "@girs/gio-2.0": "5.4.0",
        "@girs/gobject-2.0": "5.4.0",
        "@girs/gtk-4.0": "5.4.0",
        "@girs/gtksource-5": "5.4.0",
        "@girs/pango-1.0": "5.4.0",
        "@girs/shumate-1.0": "5.4.0",
        "@girs/webkit-6.0": "5.4.0"
    },
    "scripts": {
        "clear": "echo 'nothing to do'",
        "check": "gjsify tsc --noEmit",
        "test": "node ../../../scripts/check-blueprint-corpus.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/blueprint"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/blueprint#readme",
    "keywords": [
        "blueprint",
        "blp",
        "gtk",
        "gnome",
        "gtkbuilder",
        "corpus"
    ],
    "license": "MIT",
    "gjsify": {
        "tier": 1
    }
}
