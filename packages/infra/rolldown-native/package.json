{
    "name": "@gjsify/rolldown-native",
    "version": "0.46.0",
    "description": "Phase D-2 POC: Vala/GObject + Rust cdylib bridge to rolldown for GJS. Wraps `rolldown::Bundler::generate()` (async, tokio) in a per-call current-thread runtime so JS sees a sync `bundle()` call. JSON-encoded BundlerOptions in, JSON-encoded BundleOutput out — the boundary stays small even though rolldown's option surface is enormous. POC scope: no JS plugins (Phase B), no watch/HMR, no incremental builds. Companion to `@gjsify/lightningcss-native`; together they remove the last two Rust-crate runtime blockers from the gjsify build pipeline (Phase D-3 unblock).",
    "type": "module",
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib",
        "meson.build",
        "src/rust",
        "src/vala"
    ],
    "gjsify": {
        "platforms": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "darwin-x64"
        ],
        "refsLockstep": {
            "refs/rolldown": {
                "npm": "rolldown",
                "tag": "v{version}"
            }
        },
        "tier": 1
    },
    "scripts": {
        "clear": "gjsify clear lib build tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "init:meson": "meson setup build .",
        "init:meson:wipe": "gjsify run init:meson --wipe",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/ts/**/*.{ts,js}'",
        "build:meson": "node ../../../scripts/check-refs-pin.mjs . && gjsify run init:meson && meson compile -C build",
        "build:types": "gjsify tsc",
        "build:prebuilds": "gjsify run build:meson && node ../../../scripts/stage-prebuild.mjs ."
    },
    "keywords": [
        "gjs",
        "rolldown",
        "bundler",
        "vala",
        "rust",
        "native"
    ],
    "dependencies": {
        "@girs/gjs": "4.6.0",
        "@girs/glib-2.0": "4.6.0",
        "@girs/gobject-2.0": "4.6.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "author": "Pascal Garber <pascal@artandcode.studio>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/rolldown-native"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/rolldown-native#readme",
    "optionalDependencies": {
        "@gjsify/rolldown-native-darwin-arm64": "workspace:*",
        "@gjsify/rolldown-native-darwin-x64": "workspace:*",
        "@gjsify/rolldown-native-linux-arm64": "workspace:*",
        "@gjsify/rolldown-native-linux-x64": "workspace:*"
    }
}
