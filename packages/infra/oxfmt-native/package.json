{
    "name": "@gjsify/oxfmt-native",
    "version": "0.42.0",
    "description": "Vala/GObject + Rust cdylib bridge to oxc's formatter (oxfmt) for GJS. Formats JavaScript/TypeScript/JSX under GJS without a Node runtime — the Node-free counterpart to the npm `oxfmt` native napi binary, backing `gjsify format` under GJS. Wraps oxc_formatter (Prettier-compatible) via a single-shot FFI; the embedded CSS/HTML/Markdown ExternalFormatter (Prettier-NAPI) is out of scope.",
    "type": "module",
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib",
        "meson.build",
        "src/rust",
        "src/vala"
    ],
    "gjsify": {
        "platforms": [
            "linux-x64",
            "linux-arm64",
            "darwin-arm64",
            "darwin-x64"
        ],
        "refsLockstep": {
            "refs/oxc": {
                "npm": "oxfmt",
                "tag": "oxfmt_v{version}"
            }
        },
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "scripts": {
        "clear": "gjsify clear lib build tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "init:meson": "meson setup build .",
        "init:meson:wipe": "gjsify run init:meson --wipe",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/ts/**/*.{ts,js}'",
        "build:meson": "node ../../../scripts/check-refs-pin.mjs . && gjsify run init:meson && meson compile -C build",
        "build:types": "gjsify tsc",
        "build:prebuilds": "gjsify run build:meson && node ../../../scripts/stage-prebuild.mjs ."
    },
    "keywords": [
        "gjs",
        "oxc",
        "oxfmt",
        "formatter",
        "prettier",
        "typescript",
        "vala",
        "rust",
        "native"
    ],
    "dependencies": {
        "@girs/gjs": "^4.1.0",
        "@girs/glib-2.0": "^4.1.0",
        "@girs/gobject-2.0": "^4.1.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "author": "Pascal Garber <pascal@artandcode.studio>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/oxfmt-native"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/oxfmt-native#readme",
    "optionalDependencies": {
        "@gjsify/oxfmt-native-darwin-arm64": "workspace:*",
        "@gjsify/oxfmt-native-darwin-x64": "workspace:*",
        "@gjsify/oxfmt-native-linux-arm64": "workspace:*",
        "@gjsify/oxfmt-native-linux-x64": "workspace:*"
    }
}
