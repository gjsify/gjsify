{
    "name": "@gjsify/cli",
    "version": "0.42.0",
    "description": "CLI for Gjsify",
    "type": "module",
    "main": "lib/index.js",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "bin": {
        "gjsify": "./lib/index.js"
    },
    "gjsify": {
        "bin": {
            "gjsify": "./dist/cli.gjs.mjs"
        },
        "flatpak": {
            "appId": "io.github.gjsify.Cli",
            "kind": "cli",
            "name": "gjsify",
            "runtime": "gnome",
            "runtimeVersion": "50",
            "sdkExtensions": [
                "org.freedesktop.Sdk.Extension.node24"
            ],
            "appendPath": [
                "/usr/lib/sdk/node24/bin"
            ],
            "command": "gjsify",
            "finishArgs": [
                "--share=network",
                "--filesystem=host"
            ],
            "developer": {
                "id": "io.github.gjsify",
                "name": "gjsify contributors",
                "email": "pascal@artandcode.studio"
            },
            "summary": "Node.js + Web APIs for GJS — bundle, install, lint, format, flatpak-pack GJS apps",
            "description": [
                {
                    "p": "gjsify is the build-and-tooling CLI for the gjsify project — a polyfill family + bundler that lets you write GNOME apps in Node-shaped TypeScript and run them on GJS (the GNOME JavaScript runtime) without Node.js at runtime."
                },
                {
                    "p": "Use this Flatpak when you want gjsify available on any modern Linux distro without installing Node.js or a system-wide npm setup. The CLI ships its own GJS bundle and a pinned Node 24 SDK extension for the subcommands (`gjsify build`, `gjsify lint`, `gjsify format`) that still call out to Node tooling internally."
                },
                {
                    "ul": [
                        {
                            "item": "`gjsify build` — bundle a TypeScript entry into a single GJS / Node / browser file via Rolldown"
                        },
                        {
                            "item": "`gjsify install` — Node-free npm install with a lockfile (XDG-aware, native backend)"
                        },
                        {
                            "item": "`gjsify dlx <pkg>` — fetch and run any npm package's GJS bundle without persisting it"
                        },
                        {
                            "item": "`gjsify lint` / `gjsify format` — oxc-powered linter (oxlint) + formatter (oxfmt)"
                        },
                        {
                            "item": "`gjsify flatpak {init,build,check,deps,ci}` — pack a GJS app or CLI into a Flatpak end-to-end"
                        },
                        {
                            "item": "`gjsify gresource` — bundle GResource XML files for GTK apps"
                        },
                        {
                            "item": "`gjsify showcase` — run the bundled demo programs (Excalibur, three.js, WebRTC, …)"
                        }
                    ]
                }
            ],
            "license": {
                "metadata": "CC0-1.0",
                "project": "MIT"
            },
            "categories": [
                "Development"
            ],
            "homepageUrl": "https://gjsify.github.io/gjsify/",
            "vcsBrowserUrl": "https://github.com/gjsify/gjsify",
            "issueTrackerUrl": "https://github.com/gjsify/gjsify/issues",
            "modules": [
                {
                    "name": "gjsify-cli",
                    "buildsystem": "simple",
                    "build-commands": [
                        "install -Dm755 dist/cli.gjs.mjs /app/share/gjsify/cli.gjs.mjs",
                        "install -Dm755 launcher.sh /app/bin/gjsify"
                    ],
                    "sources": [
                        {
                            "type": "dir",
                            "path": "."
                        }
                    ]
                }
            ]
        },
        "ship": {
            "binaryName": "gjsify",
            "bundle": "dist/cli.gjs.mjs",
            "targets": [
                "deb",
                "rpm"
            ]
        },
        "tier": 1,
        "defineFromPackageJson": {
            "__PACKAGE_VERSION__": {
                "field": "version"
            }
        },
        "os": {
            "linux": "supported",
            "darwin": "supported",
            "win32": "supported"
        }
    },
    "files": [
        "lib",
        "dist/cli.gjs.mjs",
        "showcases.json"
    ],
    "scripts": {
        "clear": "gjsify clear lib dist tsconfig.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "start": "node lib/index.js",
        "build": "gjsify tsc && node scripts/build-assets.mjs",
        "build:gjs-bundle": "node lib/index.js build src/index.ts --app gjs --outfile dist/cli.gjs.mjs --shebang",
        "build:affected-bundle": "node lib/index.js build src/affected-entry.ts --app gjs --outfile dist/affected.gjs.mjs",
        "build:test:node": "node lib/index.js build src/test.mts --app node --outfile dist/test.node.mjs",
        "test:node": "node dist/test.node.mjs",
        "test:bun": "bun dist/test.node.mjs",
        "test:deno": "deno run -A --no-lock --node-modules-dir=none dist/test.node.mjs",
        "test:cross-runtime": "gjsify run build:test:node && gjsify run test:node && gjsify run test:bun && gjsify run test:deno",
        "test": "gjsify run build:test:node && gjsify run test:node"
    },
    "keywords": [
        "gjs",
        "node",
        "gjsify",
        "cli"
    ],
    "dependencies": {
        "@gjsify/buffer": "workspace:^",
        "@gjsify/create-app": "workspace:^",
        "@gjsify/node-globals": "workspace:^",
        "@gjsify/node-polyfills": "workspace:^",
        "@gjsify/npm-registry": "workspace:^",
        "@gjsify/resolve-npm": "workspace:^",
        "@gjsify/rolldown-plugin-gjsify": "workspace:^",
        "@gjsify/vite-plugin-blueprint": "workspace:^",
        "@gjsify/rolldown-plugin-pnp": "workspace:^",
        "@gjsify/semver": "workspace:^",
        "@gjsify/tar": "workspace:^",
        "@gjsify/tsc": "workspace:^",
        "@gjsify/utils": "workspace:^",
        "@gjsify/web-polyfills": "workspace:^",
        "@gjsify/workspace": "workspace:^",
        "acorn": "^8.17.0",
        "cosmiconfig": "^9.0.2",
        "get-tsconfig": "^4.14.0",
        "pkg-types": "^2.3.1",
        "rolldown": "^1.1.4",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@gjsify/unit": "workspace:^",
        "@types/yargs": "^17.0.35",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "@gjsify/oxfmt-native": "workspace:^",
        "@gjsify/rolldown-native": "workspace:^"
    },
    "peerDependenciesMeta": {
        "@gjsify/oxfmt-native": {
            "optional": true
        },
        "@gjsify/rolldown-native": {
            "optional": true
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/cli"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/cli#readme"
}
