{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "typescript/consistent-type-imports": "warn",
        "typescript/no-explicit-any": "warn",
        "typescript/no-non-null-assertion": "off",
        "unicorn/prefer-node-protocol": "error",
        "eslint/no-unused-vars": "warn"
    },
    "ignorePatterns": [
        "**/node_modules",
        "**/dist",
        "**/lib",
        "**/build",
        "**/build-dir",
        "**/builddir",
        "**/flatpak-build",
        "**/.flatpak-builder",
        "**/repo",
        "**/coverage",
        "**/refs",
        "**/@types",
        "**/templates",
        "**/prebuilds",
        "**/cli.gjs.mjs",
        "**/test.gjs.mjs",
        "**/test.node.mjs",
        "**/*.gresource",
        "**/*.compiled",
        "**/*.metainfo.xml"
    ]
}
