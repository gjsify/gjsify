{
    "name": "@gjsify/oxlint-plugin-gjsify",
    "version": "0.54.0",
    "description": "oxlint JS plugin with gjsify's own lint rules for GJS/GTK code — Blueprint templates, translatable widget labels, GObject.registerClass field order, GJS-correct process exit, anchored deferral markers, and the CSS side-effect import that tree-shakes away. Wire it through `jsPlugins` in `.oxlintrc.json`.",
    "type": "module",
    "main": "lib/index.js",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify tsc -p tsconfig.build.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/oxlint-plugin-gjsify"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/oxlint-plugin-gjsify#readme",
    "keywords": [
        "oxlint",
        "oxc",
        "plugin",
        "gjs",
        "gtk",
        "blueprint",
        "gobject",
        "lint"
    ],
    "license": "MIT",
    "peerDependencies": {
        "oxlint": "^1.72.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "tier": 1
    }
}
