{
    "name": "@gjsify/create-app",
    "version": "0.22.0",
    "description": "Create a new Gjsify project",
    "type": "module",
    "main": "lib/create.js",
    "types": "lib/create.d.ts",
    "exports": {
        ".": {
            "types": "./lib/create.d.ts",
            "import": "./lib/create.js"
        },
        "./prompt": {
            "types": "./lib/prompt-template.d.ts",
            "import": "./lib/prompt-template.js"
        },
        "./package.json": "./package.json"
    },
    "bin": "./lib/index.js",
    "scripts": {
        "clear": "rm -rf lib tsconfig.tsbuildinfo || exit 0",
        "check": "gjsify tsc --noEmit",
        "build": "node scripts/process-template.mjs && tsc && chmod +x ./lib/index.js",
        "test": "echo 'nothing to do'"
    },
    "keywords": [
        "gjs",
        "gjsify",
        "create",
        "scaffold",
        "gnome"
    ],
    "files": [
        "lib",
        "dist-templates"
    ],
    "dependencies": {
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@types/yargs": "^17.0.35",
        "typescript": "^6.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/create-gjsify"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/create-gjsify#readme",
    "gjsify": {
        "tier": 1
    }
}
