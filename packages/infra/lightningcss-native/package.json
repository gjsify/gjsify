{
    "name": "@gjsify/lightningcss-native",
    "version": "0.46.0",
    "description": "Vala/GObject + Rust cdylib bridge to lightningcss for GJS. Replaces the Node-only npm `lightningcss` package: parse, transform, minify, and browserslist-target lowering of CSS without leaving a Node-free GJS process. Backs `@gjsify/rolldown-plugin-gjsify`'s cssAsStringPlugin under `--app gjs` so GTK4-CSS lowering (firefox60) works without a Node runtime in the build pipeline.",
    "type": "module",
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib",
        "meson.build",
        "src/rust",
        "src/vala"
    ],
    "gjsify": {
        "platforms": [
            "linux-x64",
            "linux-arm64",
            "linux-ppc64",
            "linux-s390x",
            "linux-riscv64",
            "darwin-arm64",
            "darwin-x64"
        ],
        "tier": 1
    },
    "scripts": {
        "clear": "gjsify clear lib build tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit && gjsify tsc --noEmit -p tsconfig.spec.json",
        "init:meson": "meson setup build .",
        "init:meson:wipe": "gjsify run init:meson --wipe",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/ts/**/*.{ts,js}'",
        "build:meson": "node ../../../scripts/check-refs-pin.mjs . && gjsify run init:meson && meson compile -C build",
        "build:types": "gjsify tsc",
        "build:test:gjs": "gjsify build src/ts/test.mts --app gjs --outfile test.gjs.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test:gjs && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs",
        "build:prebuilds": "gjsify run build:meson && node ../../../scripts/stage-prebuild.mjs .",
        "build:gir-types": "ts-for-gir generate --externalDeps --allowMissingDeps --girDirectories=../lightningcss-native-linux-x64/prebuilds/linux-x64 --girDirectories=/usr/share/gir-1.0 --modules=GjsifyLightningcss-1.0 --outdir=src/ts --npmScope=@girs --package=false --ignoreVersionConflicts=true"
    },
    "keywords": [
        "gjs",
        "lightningcss",
        "css",
        "minify",
        "browserslist",
        "vala",
        "rust",
        "native"
    ],
    "dependencies": {
        "@girs/gjs": "4.6.0",
        "@girs/glib-2.0": "4.6.0",
        "@girs/gobject-2.0": "4.6.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@ts-for-gir/cli": "^4.1.0",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "author": "Pascal Garber <pascal@artandcode.studio>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/infra/lightningcss-native"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/infra/lightningcss-native#readme",
    "optionalDependencies": {
        "@gjsify/lightningcss-native-darwin-arm64": "workspace:*",
        "@gjsify/lightningcss-native-darwin-x64": "workspace:*",
        "@gjsify/lightningcss-native-linux-arm64": "workspace:*",
        "@gjsify/lightningcss-native-linux-ppc64": "workspace:*",
        "@gjsify/lightningcss-native-linux-riscv64": "workspace:*",
        "@gjsify/lightningcss-native-linux-s390x": "workspace:*",
        "@gjsify/lightningcss-native-linux-x64": "workspace:*"
    }
}
