{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "@girs/gjs",
      "@girs/glib-2.0",
      "@girs/gobject-2.0"
    ],
    "experimentalDecorators": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "outDir": "lib",
    "rootDir": "src/ts",
    "declarationDir": "lib/types",
    "composite": true,
    // `composite` derives the buildinfo path from outDir + the rootDir-relative
    // config path. With outDir "lib" (1 level) and rootDir "src/ts" (2), that
    // resolves to `lib/../../tsconfig.tsbuildinfo` — i.e. ../tsconfig.tsbuildinfo,
    // OUTSIDE this package, in the shared pillar dir where every sibling native
    // bridge lands on the SAME file and the `clear` script can never reach it.
    // A stale/foreign one makes the declaration emit a SILENT no-op (tsc exits 0,
    // `lib/types/index.d.ts` is never written). Same fix as packages/napi/napi.
    "tsBuildInfoFile": "lib/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "strict": false
  },
  "include": ["src/ts/**/*.ts"],
  // Specs are excluded from THIS config because it is the one
  // `scripts/bootstrap-native-facades.mjs` compiles, and that runs before the
  // workspace is built: `@gjsify/unit` is linked but has no `lib/`, so a spec
  // importing it fails with TS2307 and takes the whole release build with it.
  // Sibling bridges (tls-native, http2-native, sab-native, webgl) keep their
  // specs in `src/ts/` too, but none of them is bootstrap-built, so only this
  // package and `rolldown-native` are subject to the constraint. Declaration
  // emit never wants test files anyway. Spec type-checking is restored by
  // `tsconfig.spec.json` below, which `check` runs as a second pass.
  "exclude": ["src/ts/**/*.spec.ts"]
}
