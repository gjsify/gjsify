{
    "name": "@gjsify/webrtc-native",
    "version": "0.45.0",
    "description": "Vala-based main-thread signal bridge for @gjsify/webrtc. Marshals webrtcbin signals and GstPromise callbacks from GStreamer's streaming thread onto the GLib main context so GJS can safely handle them.",
    "type": "module",
    "main": "lib/esm/index.js",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib",
        "meson.build",
        "src/vala"
    ],
    "gjsify": {
        "platforms": [
            "linux-x64",
            "linux-arm64",
            "linux-ppc64",
            "linux-s390x",
            "linux-riscv64"
        ],
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "scripts": {
        "clear": "gjsify clear lib build tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo",
        "check": "gjsify tsc --noEmit",
        "init:meson": "meson setup build .",
        "init:meson:wipe": "gjsify run init:meson --wipe",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/ts/**/*.{ts,js}'",
        "build:meson": "gjsify run init:meson && meson compile -C build",
        "build:types": "gjsify tsc -b --force",
        "build:prebuilds": "gjsify run build:meson && node ../../../scripts/stage-prebuild.mjs ."
    },
    "keywords": [
        "gjs",
        "webrtc",
        "gstreamer",
        "webrtcbin",
        "vala",
        "native"
    ],
    "dependencies": {
        "@girs/gjs": "4.5.0",
        "@girs/gjsifywebrtc-0.1": "0.1.0-4.0.0-rc.5",
        "@girs/glib-2.0": "4.5.0",
        "@girs/gobject-2.0": "4.5.0",
        "@girs/gst-1.0": "4.5.0",
        "@girs/gstwebrtc-1.0": "4.5.0"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/webrtc-native"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/webrtc-native#readme",
    "optionalDependencies": {
        "@gjsify/webrtc-native-linux-arm64": "workspace:*",
        "@gjsify/webrtc-native-linux-ppc64": "workspace:*",
        "@gjsify/webrtc-native-linux-riscv64": "workspace:*",
        "@gjsify/webrtc-native-linux-s390x": "workspace:*",
        "@gjsify/webrtc-native-linux-x64": "workspace:*"
    }
}
