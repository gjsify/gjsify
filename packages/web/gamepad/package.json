{
    "name": "@gjsify/gamepad",
    "version": "0.52.0",
    "description": "Gamepad Web API for GJS using libmanette as backend",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        },
        "./globals": "./globals.mjs"
    },
    "files": [
        "lib",
        "globals.mjs"
    ],
    "sideEffects": [
        "./lib/esm/register.js",
        "./globals.mjs"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "build:test:browser": "gjsify build src/test.browser.mts --app browser --outfile dist/test.browser.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "gamepad",
        "libmanette",
        "controller"
    ],
    "dependencies": {
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/utils": "workspace:^"
    },
    "devDependencies": {
        "@girs/gjs": "5.4.0",
        "@girs/glib-2.0": "5.4.0",
        "@girs/manette-0.2": "5.4.0",
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "partial",
            "browser": "native",
            "nativescript": "native"
        },
        "os": {
            "linux": "supported",
            "darwin": "none",
            "win32": "none"
        },
        "osNotes": {
            "darwin": "No backend reads a controller on macOS yet: libmanette links the Linux-only libevdev, and the replacement decided in ADR 0075 (SDL3 behind a GObject shim, @gjsify/gamepad-native) is not built. The package loads, getGamepads() answers the conformant empty list and hasGamepadBackend() reports false.",
            "win32": "No backend on Windows: libmanette links the Linux-only libevdev. getGamepads() answers the conformant empty list and hasGamepadBackend() reports false. ADR 0075's shim is portable C over SDL3, which also covers Windows, but no win32 target is decided."
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/gamepad"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/gamepad#readme"
}
