# SDL3, pinned to one release and verified by checksum. meson downloads it at
# `meson setup` into subprojects/packagecache/ (gitignored) and refuses a tarball
# whose sha256 differs. Bumping it: change all four lines together, then rebuild
# and re-measure the prebuild (size, `otool -L`) — see README.md § Updating SDL.
# License: zlib (docs/attribution.md).
[wrap-file]
directory = SDL3-3.4.16
source_url = https://github.com/libsdl-org/SDL/releases/download/release-3.4.16/SDL3-3.4.16.tar.gz
