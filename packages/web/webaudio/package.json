{
    "name": "@gjsify/webaudio",
    "version": "0.4.40",
    "description": "Web Audio API for GJS using GStreamer as audio backend",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        },
        "./globals": "./globals.mjs"
    },
    "files": [
        "lib",
        "globals.mjs"
    ],
    "sideEffects": [
        "./lib/esm/register.js",
        "./globals.mjs"
    ],
    "scripts": {
        "clear": "rm -rf lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs || exit 0",
        "check": "tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test.{mts,ts}'",
        "build:types": "tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "webaudio",
        "gstreamer",
        "audio-api"
    ],
    "dependencies": {
        "@gjsify/dom-events": "workspace:^"
    },
    "devDependencies": {
        "@girs/gjs": "4.0.4",
        "@girs/glib-2.0": "2.88.0-4.0.4",
        "@girs/gst-1.0": "1.28.1-4.0.4",
        "@girs/gstapp-1.0": "1.0.0-4.0.4",
        "@girs/gstaudio-1.0": "1.0.0-4.0.4",
        "@girs/gstbase-1.0": "1.0.0-4.0.4",
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "native",
            "nativescript": "none"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/webaudio"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/webaudio#readme"
}
