    <class name="Monitor"
           c:symbol-prefix="monitor"
           c:type="GjsifyGamepadMonitor"
           parent="GObject.Object"
           final="1"
           glib:type-name="GjsifyGamepadMonitor"
           glib:get-type="gjsify_gamepad_monitor_get_type"
           glib:type-struct="MonitorClass">
      <source-position filename="src/c/gjsify-gamepad.h" line="70"/>
      <constructor name="new"
                   c:identifier="gjsify_gamepad_monitor_new"
                   throws="1">
        <doc xml:space="preserve"
             filename="src/c/gjsify-gamepad.h"
             line="246">Starts SDL's gamepad subsystem (reference-counted across monitors) and a
low-rate GLib timeout on the thread-default main context that calls
gjsify_gamepad_monitor_update(), so #GjsifyGamepadMonitor::device-added fires
for a program that never polls. Controllers already connected are reported by
the first update, not by this call.

Call it, and everything else on the monitor, from the thread that runs the
JS context: SDL and, on macOS, GameController.framework are single-threaded
here by design.</doc>
        <source-position filename="src/c/gjsify-gamepad.h" line="262"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="src/c/gjsify-gamepad.h"
               line="260">a new monitor, or %NULL with @error set.</doc>
          <type name="Monitor" c:type="GjsifyGamepadMonitor*"/>
        </return-value>
      </constructor>
      <function name="error_quark"
                c:identifier="gjsify_gamepad_monitor_error_quark">
        <return-value transfer-ownership="none">
          <type name="GLib.Quark" c:type="GQuark"/>
        </return-value>
      </function>
      <method name="close" c:identifier="gjsify_gamepad_monitor_close">
        <doc xml:space="preserve"
             filename="src/c/gjsify-gamepad.h"
             line="286">Stops the timeout, releases every controller and SDL's subsystem, without
emitting #GjsifyGamepadMonitor::device-removed. Idempotent, and also run on
finalize; call it explicitly so SDL is released when the JS side stops, not
when the garbage collector gets to the wrapper.</doc>
        <source-position filename="src/c/gjsify-gamepad.h" line="295"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-gamepad.h"
                 line="288">a #GjsifyGamepadMonitor</doc>
            <type name="Monitor" c:type="GjsifyGamepadMonitor*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="get_devices"
              c:identifier="gjsify_gamepad_monitor_get_devices">
        <source-position filename="src/c/gjsify-gamepad.h" line="284"/>
        <return-value transfer-ownership="container">
          <doc xml:space="preserve"
               filename="src/c/gjsify-gamepad.h"
               line="281">the
  connected controllers, in the order they connected.</doc>
          <array name="GLib.PtrArray" c:type="GPtrArray*">
            <type name="Device"/>
          </array>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-gamepad.h"
                 line="279">a #GjsifyGamepadMonitor</doc>
            <type name="Monitor" c:type="GjsifyGamepadMonitor*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="update" c:identifier="gjsify_gamepad_monitor_update">
        <doc xml:space="preserve"
             filename="src/c/gjsify-gamepad.h"
             line="264">The pump: refreshes every controller's state and reports hotplug through
#GjsifyGamepadMonitor::device-removed and #GjsifyGamepadMonitor::device-added,
in that order. On macOS it first drains the main run loop, because that is
where GameController.framework delivers and a GLib main loop never services
it. Call it at the moment the state is read (W3C's getGamepads()); the
monitor's own timeout calls it in between. A no-op once closed.</doc>
        <source-position filename="src/c/gjsify-gamepad.h" line="275"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-gamepad.h"
                 line="266">a #GjsifyGamepadMonitor</doc>
            <type name="Monitor" c:type="GjsifyGamepadMonitor*"/>
          </instance-parameter>
        </parameters>
      </method>
      <glib:signal name="device-added" when="last">
        <doc xml:space="preserve"
             filename="src/c/gjsify-gamepad.h"
             line="229">A controller with a standard-layout mapping connected, or was already
connected when the monitor's first update ran.</doc>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <parameter name="device" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="src/c/gjsify-gamepad.h"
                 line="232">the controller that connected</doc>
            <type name="Device"/>
          </parameter>
        </parameters>
      </glib:signal>
      <glib:signal name="device-removed" when="last">
        <doc xml:space="preserve"
             filename="src/c/gjsify-gamepad.h"
             line="238">A controller disconnected. Not emitted by gjsify_gamepad_monitor_close().</doc>
        <return-value transfer-ownership="none">
