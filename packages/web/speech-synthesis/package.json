{
    "name": "@gjsify/speech-synthesis",
    "version": "0.64.12",
    "description": "Web Speech synthesis API (speechSynthesis, SpeechSynthesisUtterance) for GJS, backed by libspiel",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        },
        "./register": {
            "types": "./lib/types/register.d.ts",
            "default": "./lib/esm/register.js"
        },
        "./globals": "./globals.mjs"
    },
    "files": [
        "lib",
        "globals.mjs"
    ],
    "sideEffects": [
        "./lib/esm/register.js",
        "./globals.mjs"
    ],
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test*.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "speech",
        "speechsynthesis",
        "tts",
        "libspiel"
    ],
    "dependencies": {
        "@gjsify/dom-events": "workspace:^",
        "@gjsify/node-globals": "workspace:^",
        "@gjsify/spiel-native": "workspace:^",
        "@gjsify/utils": "workspace:^"
    },
    "devDependencies": {
        "@girs/gjs": "5.4.0",
        "@girs/glib-2.0": "5.4.0",
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "partial",
            "browser": "native",
            "nativescript": "native"
        },
        "os": {
            "linux": "supported",
            "darwin": "none",
            "win32": "none"
        },
        "osNotes": {
            "darwin": "libspiel is a Linux/GNOME speech stack; getVoices() answers [] and speak() fires an error event with code synthesis-unavailable. describeSpeechSynthesisBackend() says why.",
            "win32": "libspiel is a Linux/GNOME speech stack; getVoices() answers [] and speak() fires an error event with code synthesis-unavailable. describeSpeechSynthesisBackend() says why."
        },
        "tier": 3
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/speech-synthesis"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/speech-synthesis#readme"
}
