{
    "name": "@gjsify/adwaita-web",
    "version": "0.46.0",
    "description": "Adwaita/Libadwaita web components for browser targets",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./src/index.ts"
        },
        "./source-view": {
            "types": "./lib/types/source-view/index.d.ts",
            "default": "./src/source-view/index.ts"
        },
        "./fonts": {
            "types": "./lib/types/fonts.d.ts",
            "default": "./src/fonts.ts"
        },
        "./style.css": {
            "types": "./style.css.d.ts",
            "default": "./dist/adwaita-web.css"
        },
        "./scss": "./scss/adwaita-skin.scss",
        "./scss/*": "./scss/*"
    },
    "files": [
        "src",
        "scss",
        "dist",
        "lib",
        "style.css.d.ts"
    ],
    "scripts": {
        "clear": "gjsify clear lib dist tsconfig.tsbuildinfo scss/_icons.generated.scss src/styles.generated.ts",
        "check": "gjsify run build:scss && gjsify tsc --noEmit",
        "build": "gjsify run build:scss && gjsify run build:types",
        "build:scss": "node scripts/build-scss.mjs",
        "build:types": "gjsify tsc",
        "build:test:browser": "gjsify run build:scss && gjsify build src/test.browser.mts --app browser --outfile dist/test.browser.mjs"
    },
    "dependencies": {
        "@codemirror/commands": "^6.10.4",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.0",
        "@codemirror/view": "^6.43.4",
        "@gjsify/adwaita-core": "workspace:^",
        "@gjsify/adwaita-fonts": "workspace:^",
        "@gjsify/adwaita-icons": "workspace:^",
        "@lezer/highlight": "^1.2.3"
    },
    "devDependencies": {
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "sass": "^1.101.0",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "buildCache": false,
        "runtimes": {
            "gjs": "none",
            "node": "none",
            "browser": "polyfill",
            "nativescript": "none"
        },
        "tier": 2,
        "nodeScript": {
            "excludeGlobals": [
                "document",
                "HTMLElement",
                "HTMLCanvasElement",
                "Path2D",
                "MutationObserver",
                "navigator",
                "process"
            ]
        },
        "widgetVocabulary": {
            "role": "renderer"
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/adwaita-web"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/adwaita-web#readme"
}
