{
    "name": "@gjsify/adwaita-fonts",
    "version": "0.9.0",
    "description": "Adwaita Sans font package for browser targets (fontsource-style)",
    "type": "module",
    "main": "index.css",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.css"
        },
        "./400.css": "./400.css",
        "./400-italic.css": "./400-italic.css",
        "./files/*": "./files/*"
    },
    "license": "OFL-1.1",
    "files": [
        "*.css",
        "files"
    ],
    "gjsify": {
        "runtimes": {
            "gjs": "none",
            "node": "none",
            "browser": "polyfill",
            "nativescript": "none"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/adwaita-fonts"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/adwaita-fonts#readme"
}
