{
    "name": "@gjsify/media-capture",
    "version": "0.64.13",
    "description": "GStreamer capture chain for GJS (pipewiresrc / pulsesrc / v4l2src with probed fallback) and a 16 kHz mono PCM audio source",
    "type": "module",
    "module": "lib/esm/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/esm/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "sideEffects": false,
    "scripts": {
        "clear": "gjsify clear lib tsconfig.tsbuildinfo tsconfig.types.tsbuildinfo test.gjs.mjs",
        "check": "gjsify tsc --noEmit",
        "build": "gjsify run build:gjsify && gjsify run build:types",
        "build:gjsify": "gjsify build --library 'src/**/*.{ts,js}' --exclude 'src/**/*.spec.{mts,ts}' 'src/test*.{mts,ts}'",
        "build:types": "gjsify tsc",
        "build:test": "gjsify run build:test:gjs",
        "build:test:gjs": "gjsify build src/test.mts --app gjs --outfile test.gjs.mjs",
        "test": "gjsify run build:gjsify && gjsify run build:test && gjsify run test:gjs",
        "test:gjs": "gjsify run test.gjs.mjs"
    },
    "keywords": [
        "gjs",
        "gstreamer",
        "capture",
        "microphone",
        "camera",
        "pipewire",
        "pcm"
    ],
    "dependencies": {
        "@gjsify/dom-exception": "workspace:^",
        "@gjsify/node-globals": "workspace:^"
    },
    "devDependencies": {
        "@girs/gjs": "5.4.0",
        "@girs/glib-2.0": "5.4.0",
        "@girs/gobject-2.0": "5.4.0",
        "@girs/gst-1.0": "5.4.0",
        "@girs/gstapp-1.0": "5.4.0",
        "@gjsify/cli": "workspace:^",
        "@gjsify/unit": "workspace:^",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    },
    "gjsify": {
        "runtimes": {
            "gjs": "polyfill",
            "node": "none",
            "browser": "none",
            "nativescript": "none"
        },
        "tier": 1
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "packages/web/media-capture"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/packages/web/media-capture#readme"
}
