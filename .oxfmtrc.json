{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "ignorePatterns": [
        "**/*.json",
        "**/*.jsonc",
        "**/*.json5",
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.html",
        "**/*.htm",
        "**/*.md",
        "**/*.mdx",
        "**/*.yml",
        "**/*.yaml",
        "**/*.vue",
        "**/*.svelte",
        "**/*.toml",
        "**/*.graphql",
        "**/*.gql",
        "**/node_modules",
        "**/dist",
        "**/lib",
        "**/build",
        "**/build-dir",
        "**/builddir",
        "**/flatpak-build",
        "**/.flatpak-builder",
        "**/repo",
        "**/coverage",
        "**/refs",
        "**/@types",
        "**/templates",
        "**/prebuilds",
        "**/.yarn/cache",
        "**/.yarn/install-state.gz",
        "**/cli.gjs.mjs",
        "**/test.gjs.mjs",
        "**/test.node.mjs",
        "**/*.gresource",
        "**/*.compiled",
        "**/*.metainfo.xml"
    ]
}
