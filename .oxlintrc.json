{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "jsPlugins": ["./packages/infra/oxlint-plugin-gjsify/src/index.ts"],
    "categories": {
        "correctness": "error"
    },
    "options": {
        // A disable directive that suppresses NOTHING is a claim that something
        // was considered and handled, when nothing was. That is not hypothetical:
        // `// eslint-disable-next-line @typescript-eslint/no-require-imports`
        // comments sat next to a bare `require('node:fs')` for two months while
        // the rule they named was never enabled, so they announced a review that
        // had never happened and the bug went red on main instead (#859/#861).
        // `error`, not `warn`: the CI lint gate is oxlint's own exit semantics
        // (errors fail, warnings do not), so a warning here would be a check that
        // gates nothing — the half-measure that incident argues against.
        // A directive that IS load-bearing never appears: the two lazy
        // `@gjsify/http2` native-dispatcher disables stay silent under this.
        "reportUnusedDisableDirectives": "error"
    },
    "rules": {
        // A bare `catch {}` with no body and no comment is the shape that hides
        // bugs: `@gjsify/fetch`'s root-relative rewrite (#869 — a TypeError from
        // `globalThis.imports.system` off gjs landed in a bare catch, so every
        // `fetch('/res/…')` went out unrewritten with no error anywhere) and
        // `@gjsify/crypto`'s `fillRandom` (a bare `imports.gi.GLib` inside a
        // try — the ReferenceError was CAUGHT and silently degraded crypto
        // bytes to `Math.random()`). A catch containing only a comment is not
        // reported, so this enforces "a catch must state its reason": either
        // the guarded call has a real failure mode and the comment says why
        // ignoring it is right, or the try/catch has no throw path and must be
        // deleted (best-effort is expressed by ignoring a RETURN VALUE, not by
        // wrapping a non-throwing call).
        "eslint/no-empty": "error",
        "typescript/consistent-type-imports": "warn",
        "typescript/no-explicit-any": "warn",
        // Our source is ESM — a bare `require(...)` is a latent ReferenceError
        // that only "works" inside a bundle (rolldown's CJS interop resolves
        // the call at build time) and throws from the unbundled `lib/` we
        // publish. NOT in the `correctness` category, so it must be listed
        // here. Scoped to ESM by the `*.cjs` override below; a per-site
        // disable needs a stated reason. See AGENTS.md § CJS-ESM Interop (GJS).
        "typescript/no-require-imports": "error",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-this-alias": [
            "error",
            { "allowedNames": ["self", "el", "blob", "readable", "root", "node", "receivedThis"] }
        ],
        "unicorn/prefer-node-protocol": "error",
        // The GJS ambient globals are seeded by the host (gjs) or by the
        // `@gjsify/node-gi/globals` shim — a build-time PREDICTION about the
        // consumer's bundle. A shipped package reaching for them bare tests
        // green and throws a ReferenceError in a consumer on the reverse
        // bridge (`@gjsify/canvas2d-core`'s `_toDataURL`, `@gjsify/fetch`'s
        // root-relative rewrite, `@gjsify/crypto`'s `fillRandom` — one day,
        // one class). Portable spellings exist for every one; the sanctioned
        // runtime PROBE (`globalThis.imports?.gi`) is member access and stays
        // silent here, as does an explicit in-file `declare`. See AGENTS.md
        // § "The legacy `imports.*` object is NOT an API". Genuine GJS
        // PROGRAM sources are scoped out in the override below.
        "no-restricted-globals": [
            "error",
            { "name": "imports", "message": "GJS host object — a ReferenceError off gjs. Use gi://<Ns>, `import system from 'system'`, GLib.Bytes.toArray() or TextDecoder; a runtime PROBE is spelled `globalThis.imports?.gi`. See AGENTS.md § The legacy imports.* object is NOT an API." },
            { "name": "ARGV", "message": "GJS ambient global — a ReferenceError off gjs. Use `system.programArgs` (import system from 'system'), which is what ARGV is defined as." },
            { "name": "print", "message": "GJS ambient global — a ReferenceError off gjs. Use console.log, or declare the binding locally in a deliberate GJS-only module." },
            { "name": "printerr", "message": "GJS ambient global — a ReferenceError off gjs. Use console.error, or declare the binding locally in a deliberate GJS-only module." },
            { "name": "log", "message": "GJS ambient global — a ReferenceError off gjs. Use console.log, or declare the binding locally in a deliberate GJS-only module." },
            { "name": "logError", "message": "GJS ambient global — a ReferenceError off gjs. Use console.error, or declare the binding locally in a deliberate GJS-only module." }
        ],
        "eslint/no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_",
                "caughtErrorsIgnorePattern": "^_",
                "destructuredArrayIgnorePattern": "^_"
            }
        ],
        "gjsify/register-class-order": "error",
        // A bare `process.exit()` does not halt under GJS (no atexit, the GLib
        // loop may still be armed) — the call RETURNS and the statements after
        // it still run, so the requested exit code can be lost entirely. On
        // Node/bun/deno the same call halts immediately, which is why the class
        // ships unnoticed (`gjsify storybook` with no stories reported the
        // failure AND "Found 0 story file(s)" AND exited 0). Flags a statement
        // containing a bare exit when another statement follows it in the same
        // list; tail-position exits are fine. Repair: `return process.exit(…)`.
        "gjsify/deferred-process-exit": "error",
        // A deferral marker must name where it is tracked. A bare `// TODO` has
        // no owner and no retirement path: nothing fails when the work lands and
        // nothing fails when it is abandoned. Measured at v0.29.0 — 37 of 42
        // markers in source carried no reference at all, one of them on a test
        // documented as broken. Anchors accepted: `#123` (issue/PR),
        // `open-todos` (the `status/` ledger the `status-data` conformance rule
        // already validates every PR), or the `// fixed upstream in gjsify: …`
        // shim note. This is the one deferral shape in the repo that lacked the
        // mandatory-reason + self-retirement pattern `it.failing`,
        // `unchecked-fields.mjs` and `platformsUncommitted` all carry.
        "gjsify/todo-needs-anchor": "error",
        // `spawn(process.execPath, …)` means "start the current runtime again" —
        // the right idiom in a Node program and the wrong one in a DUAL-HOST
        // one. Under `dist/cli.gjs.mjs` the current runtime is GJS, so the spawn
        // hands a Node script to `gjs-console`, which RUNS it and dies inside
        // the payload (`ReferenceError: module is not defined`) — a failure that
        // reads as a bug in the payload, not in the spawn. Measured on `gjsify
        // workspace @gjsify/create-app build` from a cold tree, where
        // `@gjsify/tsc`'s bundle does not exist yet and `commands/tsc.ts`
        // therefore took its upstream-`tsc` fallback. Repair: `nodeBinary()`
        // from `utils/run-node.ts`. This was ALREADY the convention — six prose
        // warnings across five files name `nodeBinary()`, two of them in
        // capitals, and the single file that never got the memo is the one that
        // broke. That is the measurement which turns a comment into a check.
        "gjsify/spawn-node-binary": "error",
        // A bare `import '<something that is CSS>';` registers nothing under
        // any gjsify build. `cssAsStringPlugin` emits `export default "<css>"`,
        // which has no side effect, so the import is tree-shaken and the build
        // exits 0 — measured on 0.41.0 as a ZERO-BYTE bundle for a probe entry
        // whose only statement was `import '@gjsify/adwaita-fonts';`, the line
        // `@gjsify/adwaita-web` carried for its whole life while declaring
        // `font-family: 'Adwaita Sans'` and registering no face. Invisible on a
        // GNOME host, which supplies the typeface from fontconfig, so the
        // screenshots were right about a tree that shipped no font. Repo-wide
        // there were exactly two, and the convention was already written down in
        // both files that got it right — one file did not, which is the
        // measurement that turns a comment into a check.
        "gjsify/no-css-side-effect-import": "error"
    },
    "overrides": [
        {
            // `website/` is an ASTRO app — a real CSS pipeline, which is the one
            // place a bare CSS import is the CORRECT spelling. Measured rather than
            // assumed: `website/dist/_astro/common.*.css` carries the
            // `@font-face{font-family:Coming Soon` rule and the emitted
            // `coming-soon-latin-400-normal.*.woff2` asset that
            // `import '@fontsource/coming-soon'` in `ShowcaseSlideshow.astro` put
            // there. The rule is about a build that turns CSS into a STRING, and
            // this tree has none. Its own `@gjsify/adwaita-web` imports are JS and
            // stay covered — `@gjsify/vite-plugin-gjsify` only installs
            // `cssAsStringPlugin` behind an explicit `cssAsString: true`, and a
            // website that opted into that would drop this override with it.
            "files": ["website/**"],
            "rules": {
                "gjsify/no-css-side-effect-import": "off"
            }
        },
        {
            // A `.cjs` file IS CommonJS — `require` is its only module syntax,
            // not a mistake. These are the `cjs-compat.cjs` publishing shims
            // (`@gjsify/{stream,events,assert}`, reached via `exports['.'].require`
            // by an EXTERNAL CJS consumer) and the CJS regression fixtures that
            // exist precisely to exercise a bundled `require('stream')`. Scoping
            // the rule to ESM is the rule being correct, not an exemption.
            "files": ["**/*.cjs", "**/*.cts"],
            "rules": {
                "typescript/no-require-imports": "off"
            }
        },
        {
            // Node-only tooling. Both rules below are about a hazard that
            // exists only where the code can ALSO run under GJS, so the same
            // set carves out both. On Node `process.exit()` DOES halt
            // synchronously, so the deferred-exit hazard does not exist there
            // and a bare exit followed by code is at worst dead code, not a
            // lost exit code; and `process.execPath` genuinely IS the node
            // binary, so re-entering it is the correct idiom rather than a
            // wrong-interpreter bug. `scripts/` dirs are build/CI tooling by
            // convention (AGENTS.md: the CI gates stay plain Node SCRIPTS,
            // never CLI commands), `tests/e2e/**` are `node --test`
            // harnesses, and `packages/{node-gi,napi}/**` are the engines
            // that run ON node/bun/deno with their own Node gate harnesses
            // (same carve-out posture as the affected classifier). Everything
            // that can run under GJS — package sources, examples/showcases
            // src, integration-test src (test:gjs) — stays covered.
            //
            // Measured when `spawn-node-binary` landed: all 41 of its hits
            // across the repo fall inside this set, and none in a shipped
            // package source. A rule that needed exemptions in the code it
            // guards would be the wrong rule; this one needs none.
            "files": ["**/scripts/**", "tests/e2e/**", "packages/node-gi/**", "packages/napi/**"],
            "rules": {
                "gjsify/deferred-process-exit": "off",
                "gjsify/spawn-node-binary": "off"
            }
        },
        {
            // Genuine GJS PROGRAM sources: app entries under examples/ and
            // showcases/, e2e/repro fixtures, docs PoCs, the node-gi/napi
            // engines with their conformance/golden programs, and the gjs-run
            // bootstrap. The ambient globals are sanctioned there — these run
            // under gjs, or through the reverse bridge where a bare
            // `print`/`imports` is exactly the signal `--app node`
            // auto-globals injection keys on. The rule exists for the SHIPPED
            // packages, whose correctness must not depend on a build-time
            // prediction about somebody else's bundle.
            "files": [
                "examples/**",
                "showcases/**",
                "tests/**",
                "docs/**",
                "packages/node-gi/**",
                "packages/napi/**",
                "install.mjs"
            ],
            "rules": {
                "no-restricted-globals": "off"
            }
        }
    ],
    "ignorePatterns": [
        "**/node_modules",
        "**/dist",
        "**/lib",
        "**/build",
        "**/build-dir",
        "**/builddir",
        "**/flatpak-build",
        "**/.flatpak-builder",
        "**/repo",
        "**/coverage",
        "**/refs",
        "tests/e2e/*/out",
        "packages/infra/lightningcss-wasm/src/napi-wasm.mjs",
        "packages/**/conformance.*.js",
        "**/@types",
        "**/templates",
        "**/prebuilds",
        "**/.yarn/cache",
        "**/.yarn/install-state.gz",
        "**/cli.gjs.mjs",
        "**/test.gjs.mjs",
        "**/test.node.mjs",
        "**/*.gresource",
        "**/*.compiled",
        "**/*.metainfo.xml",
        // oxlint locates an .astro file's `<script>` blocks by a plain text scan,
        // so a literal `<script>` inside a JSX comment in the TEMPLATE is taken as
        // a real script opener and the markup after it is parsed as JS ("Unexpected
        // token"). This component's preview comment mentions `<script>` and the
        // file has a real `<script>` block further down, which is the exact shape
        // that trips it. The Astro source is valid — only the linter cannot read
        // it. Every other .astro file stays linted (frontmatter rules do work).
        "website/src/components/AdwWidget.astro"
    ]
}
