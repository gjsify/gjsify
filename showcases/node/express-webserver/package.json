{
  "name": "@gjsify/example-node-express-webserver",
  "version": "0.47.0",
  "description": "Express.js blog showcase with JSON API and static frontend — a real Node.js web app running on GJS",
  "main": "dist/index.gjs.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "clear": "gjsify clear dist tsconfig.tsbuildinfo",
    "check": "gjsify tsc --noEmit --skipLibCheck --strictNullChecks false --noImplicitAny false",
    "start": "gjsify run dist/index.gjs.js",
    "start:node": "node dist/index.node.mjs",
    "build": "gjsify run build:gjs && gjsify run build:node && gjsify run build:public",
    "build:gjs": "gjsify build src/index.ts --app gjs --outfile dist/index.gjs.js",
    "build:node": "gjsify build src/index.ts --app node --outfile dist/index.node.mjs",
    "build:public": "gjsify copy src/public dist/public"
  },
  "dependencies": {
    "@gjsify/http-soup-bridge": "workspace:^"
  },
  "devDependencies": {
    "@gjsify/cli": "workspace:^",
    "@gjsify/node-globals": "workspace:^",
    "@gjsify/runtime": "workspace:^",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "express": "^5.2.1",
    "typescript": "^6.0.3"
  },
  "author": "Pascal Garber <pascal@artandcode.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjsify/gjsify.git",
    "directory": "showcases/node/express-webserver"
  },
  "bugs": {
    "url": "https://github.com/gjsify/gjsify/issues"
  },
  "homepage": "https://github.com/gjsify/gjsify/tree/main/showcases/node/express-webserver#readme",
  "gjsify": {
    "main": "dist/index.gjs.js",
    "tier": 2,
    "os": {
      "linux": "supported",
      "darwin": "supported",
      "win32": "supported"
    },
    "example": {
      "runtimes": [
        "gjs",
        "node",
        "bun",
        "deno"
      ],
      "node": "dist/index.node.mjs"
    }
  }
}
