{
  "name": "@gjsify/example-dom-minimalist-browser",
  "version": "0.45.0",
  "description": "Minimalist Adwaita browser — an Epiphany-style header bar (flat back/forward/reload, URL entry, home) that looks identical natively (GTK/Adw) and in the browser (@gjsify/adwaita-web), driving a shared iframe core (real <iframe> on the web, IFrameBridge over WebKit.WebView on GJS)",
  "main": "dist/gjs.js",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./browser": "./src/browser/browser.ts",
    "./browser-demo": "./src/browser-demo.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clear": "gjsify clear dist tsconfig.tsbuildinfo",
    "check": "gjsify tsc --noEmit",
    "start": "gjsify run start:gjs",
    "start:gjs": "gjsify run dist/gjs.js",
    "start:browser": "http-server dist -o -c-1",
    "build": "gjsify run build:gjs && gjsify run build:browser && gjsify run build:assets",
    "build:gjs": "gjsify build src/gjs/gjs.ts --app gjs --outfile dist/gjs.js",
    "build:browser": "gjsify build src/browser/browser-main.ts --app browser --outfile dist/browser-main.js",
    "build:assets": "gjsify copy src/browser/index.html dist/"
  },
  "dependencies": {
    "@gjsify/iframe": "workspace:^"
  },
  "devDependencies": {
    "@girs/adw-1": "4.3.0",
    "@girs/gio-2.0": "4.3.0",
    "@girs/gjs": "4.3.0",
    "@girs/glib-2.0": "4.3.0",
    "@girs/gtk-4.0": "4.3.0",
    "@girs/pango-1.0": "4.3.0",
    "@gjsify/adwaita-web": "workspace:^",
    "@gjsify/cli": "workspace:^",
    "@gjsify/devtools": "workspace:^",
    "@gjsify/node-globals": "workspace:^",
    "@gjsify/runtime": "workspace:^",
    "@types/node": "^25.9.2",
    "http-server": "^14.1.1",
    "typescript": "^6.0.3"
  },
  "author": "Pascal Garber <pascal@artandcode.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjsify/gjsify.git",
    "directory": "showcases/dom/minimalist-browser"
  },
  "bugs": {
    "url": "https://github.com/gjsify/gjsify/issues"
  },
  "homepage": "https://github.com/gjsify/gjsify/tree/main/showcases/dom/minimalist-browser#readme",
  "gjsify": {
    "main": "dist/gjs.js",
    "tier": 2,
    "example": {
      "runtimes": [
        "gjs"
      ]
    }
  }
}
