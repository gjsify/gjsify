{
    "name": "@gjsify/example-dom-excalibur-jelly-jumper",
    "version": "0.48.0",
    "description": "2D platformer showcase using Excalibur.js 0.32.0 with Tiled tilemaps, running natively on GJS/GTK4 and in the browser",
    "main": "dist/gjs.js",
    "type": "module",
    "files": [
        "dist",
        "src"
    ],
    "exports": {
        "./browser": "./src/browser/browser.ts",
        "./assets/*": "./src/assets/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "clear": "gjsify clear dist tsconfig.tsbuildinfo",
        "check": "gjsify tsc --noEmit --skipLibCheck --strictNullChecks false --noImplicitAny false",
        "start": "gjsify run dist/gjs.js",
        "start:browser": "http-server dist",
        "build": "gjsify run build:gjs && gjsify run build:node && gjsify run build:browser && gjsify run build:assets",
        "build:gjs": "gjsify build src/gjs/gjs.ts --app gjs --outfile dist/gjs.js --globals auto,dom",
        "build:node": "gjsify build src/gjs/gjs.ts --app node --outfile dist/gjs.node.mjs --globals auto,dom,fetch,XMLHttpRequest,ProgressEvent,MouseEvent,KeyboardEvent,PointerEvent,DOMParser,Audio,AudioContext,webkitAudioContext,GamepadEvent --alias jsdom=@gjsify/empty",
        "build:browser": "gjsify build src/browser/browser-main.ts --app browser --outfile dist/browser.js",
        "build:assets": "gjsify copy src/assets dist/res && gjsify copy src/browser/index.html dist/"
    },
    "devDependencies": {
        "@excaliburjs/plugin-tiled": "0.32.0",
        "@gjsify/node-gi": "file:../../../packages/node-gi/node-gi",
        "@girs/adw-1": "4.6.0",
        "@girs/gio-2.0": "4.6.0",
        "@girs/gjs": "4.6.0",
        "@girs/glib-2.0": "4.6.0",
        "@girs/gobject-2.0": "4.6.0",
        "@girs/gtk-4.0": "4.6.0",
        "@gjsify/adwaita-icons": "workspace:^",
        "@gjsify/adwaita-web": "workspace:^",
        "@gjsify/canvas2d": "workspace:^",
        "@gjsify/cli": "workspace:^",
        "@gjsify/devtools": "workspace:^",
        "@gjsify/vite-plugin-blueprint": "workspace:^",
        "@types/node": "^25.9.2",
        "excalibur": "0.32.0",
        "http-server": "^14.1.1",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@gjsify/webgl": "workspace:^"
    },
    "author": "Pascal Garber <pascal@artandcode.studio>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gjsify/gjsify.git",
        "directory": "showcases/dom/excalibur-jelly-jumper"
    },
    "bugs": {
        "url": "https://github.com/gjsify/gjsify/issues"
    },
    "homepage": "https://github.com/gjsify/gjsify/tree/main/showcases/dom/excalibur-jelly-jumper#readme",
    "gjsify": {
        "main": "dist/gjs.js",
        "tier": 2,
        "example": {
            "runtimes": [
                "gjs",
                "node",
                "bun",
                "deno"
            ],
            "node": "dist/gjs.node.mjs"
        }
    }
}
