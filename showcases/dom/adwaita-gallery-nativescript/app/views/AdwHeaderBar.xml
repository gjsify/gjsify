<adw:HeaderBar
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:adw="~/adw"
  xmlns:gtk="~/gtk"
>
  <adw:HeaderBar.startBox>
    <gtk:Button
      text="‹"
      variant="flat"
    />
  </adw:HeaderBar.startBox>
  <adw:HeaderBar.titleWidget>
    <adw:WindowTitle
      title="Text Editor"
      subtitle="notes.md"
    />
  </adw:HeaderBar.titleWidget>
  <adw:HeaderBar.endBox>
    <gtk:Button
      text="≡"
      variant="flat"
    />
  </adw:HeaderBar.endBox>
</adw:HeaderBar>
