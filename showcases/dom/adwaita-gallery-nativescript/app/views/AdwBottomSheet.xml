<adw:BottomSheet
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:adw="~/adw"
  openState="true"
>
  <adw:BottomSheet.content>
    <adw:StatusPage
      title="Now Playing"
      description="The sheet slides up over this."
    />
  </adw:BottomSheet.content>
  <adw:BottomSheet.sheet>
    <adw:PreferencesGroup title="Queue">
      <adw:ActionRow
        title="Blue Monday"
        subtitle="New Order"
      />
      <adw:ActionRow
        title="Just Like Heaven"
        subtitle="The Cure"
      />
    </adw:PreferencesGroup>
  </adw:BottomSheet.sheet>
</adw:BottomSheet>
