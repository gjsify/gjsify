<StackLayout
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:gtk="~/gtk"
  orientation="horizontal"
>
  <gtk:Button
    text="Pill"
    styleClasses="pill"
  />
  <gtk:Button
    text="Suggested"
    styleClasses="suggested-action"
  />
  <gtk:Button
    text="Delete"
    styleClasses="destructive-action"
  />
  <gtk:Button
    text="Flat"
    styleClasses="flat"
  />
</StackLayout>
