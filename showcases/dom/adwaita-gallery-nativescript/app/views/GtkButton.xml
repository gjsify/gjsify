<StackLayout
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:gtk="~/gtk"
  orientation="horizontal"
>
  <gtk:Button
    text="Pill"
    cssClasses="pill"
  />
  <gtk:Button
    text="Suggested"
    cssClasses="suggested-action"
  />
  <gtk:Button
    text="Delete"
    cssClasses="destructive-action"
  />
  <gtk:Button
    text="Flat"
    cssClasses="flat"
  />
</StackLayout>
