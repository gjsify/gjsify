<gtk:Box
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:gtk="~/gtk"
  orientation="horizontal"
  spacing="12"
>
  <gtk:Button
    label="Pill"
    styleClasses="pill"
  />
  <gtk:Button
    label="Suggested"
    styleClasses="suggested-action"
  />
