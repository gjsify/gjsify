<adw:OverlaySplitView
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:adw="~/adw"
>
  <adw:OverlaySplitView.sidebar>
    <adw:ToolbarView>
      <adw:ToolbarView.topBar>
        <adw:HeaderBar title="Library" />
      </adw:ToolbarView.topBar>
      <adw:ToolbarView.content>
        <adw:StatusPage title="Sections" />
      </adw:ToolbarView.content>
    </adw:ToolbarView>
  </adw:OverlaySplitView.sidebar>
  <adw:OverlaySplitView.content>
    <adw:ToolbarView>
      <adw:ToolbarView.topBar>
        <adw:HeaderBar title="Your Library" />
      </adw:ToolbarView.topBar>
      <adw:ToolbarView.content>
        <adw:StatusPage
          title="Your Library"
          description="Toggle the sidebar to browse sections."
        />
      </adw:ToolbarView.content>
    </adw:ToolbarView>
  </adw:OverlaySplitView.content>
</adw:OverlaySplitView>
