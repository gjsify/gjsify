<adw:NavigationSplitView
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:adw="~/adw"
>
  <adw:NavigationSplitView.sidebar>
    <adw:ToolbarView>
      <adw:ToolbarView.topBar>
        <adw:HeaderBar title="Mailboxes" />
      </adw:ToolbarView.topBar>
      <adw:ToolbarView.content>
        <adw:StatusPage title="Mailboxes" />
      </adw:ToolbarView.content>
    </adw:ToolbarView>
  </adw:NavigationSplitView.sidebar>
  <adw:NavigationSplitView.content>
    <adw:ToolbarView>
      <adw:ToolbarView.topBar>
        <adw:HeaderBar title="All Mail" />
      </adw:ToolbarView.topBar>
      <adw:ToolbarView.content>
        <adw:StatusPage
          title="All Mail"
          description="Select a conversation from the list to read it here."
        />
      </adw:ToolbarView.content>
    </adw:ToolbarView>
  </adw:NavigationSplitView.content>
</adw:NavigationSplitView>
