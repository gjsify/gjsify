<adw:ToolbarView
  xmlns="http://schemas.nativescript.org/tns.xsd"
  xmlns:adw="~/adw"
>
  <adw:ToolbarView.topBar>
    <adw:HeaderBar
      title="Documents"
      subtitle="12 items"
    />
  </adw:ToolbarView.topBar>
  <adw:ToolbarView.content>
    <adw:StatusPage
      id="library"
      title="Your library"
      description="Content sits between the toolbars and scrolls independently of them."
    />
  </adw:ToolbarView.content>
  <adw:ToolbarView.bottomBar>
    <adw:HeaderBar>
      <adw:HeaderBar.titleWidget>
        <adw:WindowTitle title="Selection: none" />
      </adw:HeaderBar.titleWidget>
    </adw:HeaderBar>
  </adw:ToolbarView.bottomBar>
</adw:ToolbarView>
