{
    "compilerOptions": {
        "module": "esnext",
        "target": "ES2020",
        "moduleResolution": "bundler",
        "noEmitHelpers": true,
        "noEmitOnError": true,
        "skipLibCheck": true,
        "lib": ["ESNext", "dom"],
        "paths": {
            "~/*": ["./app/*"]
        }
    },
    "include": ["app/**/*", "scripts/**/*"],
    "files": ["./references.d.ts"],
    "exclude": ["node_modules", "platforms"]
}
