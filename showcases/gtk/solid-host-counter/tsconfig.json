{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ESNext",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "types": [],
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        // The JSX half of the contract, and both halves are required. `preserve`
        // is what `babel-preset-solid` needs — `"react"` is refused outright with
        // `jsxImportSource` (TS5089) — and `strict` is what supplies
        // `noImplicitAny`: without it every JSX element is implicitly `any` and
        // `tsc` exits 0 having checked nothing at all.
        "jsx": "preserve",
        "jsxImportSource": "@gjsify/gtk-host"
    },
    "include": ["src/**/*"]
}
