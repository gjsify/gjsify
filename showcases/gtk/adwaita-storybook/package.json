{
  "name": "@gjsify/example-gtk-adwaita-storybook",
  "version": "0.45.0",
  "description": "Interactive component browser for Libadwaita widgets — a native Adwaita storybook built on @gjsify/storybook, debuggable over DBus/MCP via @gjsify/devtools",
  "type": "module",
  "main": "dist/gjs.js",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./browser": "./src/browser/embed.ts",
    "./metas": "./src/metas.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clear": "gjsify clear dist tsconfig.tsbuildinfo node_modules/.cache/gjsify-storybook",
    "check": "gjsify tsc --noEmit",
    "start": "gjsify storybook",
    "start:node": "gjsify storybook --runtime node",
    "start:watch": "gjsify storybook --watch",
    "start:browser": "http-server dist -o -c-1",
    "build": "gjsify run build:gjs && gjsify run build:node && gjsify run build:web",
    "build:gjs": "gjsify storybook --build-only --runtime gjs --out dist/gjs.js",
    "build:node": "gjsify storybook --build-only --runtime node --out dist/gjs.node.mjs",
    "build:browser": "gjsify build src/browser/main.ts --app browser --outfile dist/browser-main.js",
    "build:assets": "gjsify copy src/browser/index.html dist/",
    "build:web": "gjsify run build:browser && gjsify run build:assets",
    "debug": "gjsify debug --profile storybook"
  },
  "gjsify": {
    "main": "dist/gjs.js",
    "storybook": {
      "applicationId": "org.gjsify.AdwaitaStorybook",
      "title": "Adwaita Storybook",
      "stories": "src",
      "globals": "auto"
    },
    "tier": 2,
    "example": {
      "runtimes": [
        "gjs",
        "node",
        "bun",
        "deno"
      ],
      "node": "dist/gjs.node.mjs"
    }
  },
  "devDependencies": {
    "@girs/adw-1": "4.3.0",
    "@girs/gio-2.0": "4.3.0",
    "@girs/gjs": "4.3.0",
    "@girs/glib-2.0": "4.3.0",
    "@girs/gobject-2.0": "4.3.0",
    "@girs/gtk-4.0": "4.3.0",
    "@gjsify/adwaita-web": "workspace:^",
    "@gjsify/cli": "workspace:^",
    "@gjsify/node-gi": "file:../../../packages/node-gi/node-gi",
    "@gjsify/storybook": "workspace:^",
    "@gjsify/adwaita-storybook": "workspace:^",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  },
  "author": "Pascal Garber <pascal@artandcode.studio>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjsify/gjsify.git",
    "directory": "showcases/gtk/adwaita-storybook"
  },
  "bugs": {
    "url": "https://github.com/gjsify/gjsify/issues"
  },
  "homepage": "https://github.com/gjsify/gjsify/tree/main/showcases/gtk/adwaita-storybook#readme"
}
