#!/usr/bin/env bash
# gjsify pre-commit hook — auto-rebuild + re-stage `affected.gjs.mjs` when the
# source it is bundled from was changed in the staged diff.
#
# Why this exists
# ---------------
# ADR 0002 untracked `cli.gjs.mjs` and `tsc.gjs.mjs`, and this hook shrank with
# them. ONE committed generated artifact is left:
#
#   packages/infra/cli/dist/affected.gjs.mjs   (the Soup-free CI classifier)
#
# It is the one whose staleness is worth a local rebuild, because it is the one
# that FAILS OPEN. The CI `changes` job boots it on a plain ubuntu+gjs host
# before any install and it gates every other job, so a stale copy does not
# error — it silently classifies today's PR with an older commit's tables, and
# the run looks green while having skipped work.
#
# This is BEST-EFFORT and cannot be the invariant: the trigger list below is a
# four-path heuristic over a bundle that inlines the whole workspace-dep
# closure. Measured 2026-08-06: a commit touching `packages/web/dom-events` and
# `packages/web/abort-controller` — neither of which looks like CLI
# infrastructure — staled all three artifacts by +18 B each, and this hook
# stayed silent, CORRECTLY, because none of its paths matched. Do not read a
# green pre-commit as "the bundle is fresh". `scripts/verify-committed-bundles.mjs`
# in CI is the exhaustive check.
#
# Bypass
# ------
#   git commit --no-verify          # standard escape hatch
#   SKIP_GJSIFY_HOOKS=1 git commit  # env-var escape hatch (CI, scripted commits)
#
# Install
# -------
#   node scripts/install-git-hooks.mjs   # sets core.hooksPath=.githooks
#   gjsify install                       # also installs the hook
#

set -e

# --- Bypass --------------------------------------------------------------

if [ "${SKIP_GJSIFY_HOOKS:-0}" = "1" ]; then
    exit 0
fi

# --- Repo root resolution ------------------------------------------------
#
# A pre-commit hook may be invoked from any subdirectory of the working tree
# (git invokes hooks with CWD=repo-root, but we don't rely on that — some
# wrappers/IDEs change CWD before exec). Resolve the root explicitly.

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- gjsify resolution ---------------------------------------------------
#
# Prefer the workspace-local CLI at node_modules/.bin/gjsify so the rebuild uses
# the version the workspace declares. Fall back to PATH, then to a BUILT
# `dist/cli.gjs.mjs` if this tree happens to have one — it is a build output
# now, not a checkout artifact, so its absence is the normal case rather than a
# problem. Resolving one of those says NOTHING about whether this tree can
# BUILD; the guard below is the precondition that actually matters, and the two
# diverge in every fresh worktree.

if [ -x "$REPO_ROOT/node_modules/.bin/gjsify" ]; then
    GJSIFY="$REPO_ROOT/node_modules/.bin/gjsify"
elif command -v gjsify >/dev/null 2>&1; then
    GJSIFY="$(command -v gjsify)"
elif command -v gjs >/dev/null 2>&1 && [ -f "$REPO_ROOT/packages/infra/cli/dist/cli.gjs.mjs" ]; then
    GJSIFY="gjs -m $REPO_ROOT/packages/infra/cli/dist/cli.gjs.mjs"
else
    echo "::warning::[gjsify pre-commit] no gjsify CLI on PATH and no node_modules/.bin/gjsify;"
    echo "::warning::[gjsify pre-commit] skipping bundle freshness check. Run 'gjsify install' first."
    exit 0
fi

# Finding a CLI is NOT the precondition — BUILDING is, and the two diverge.
# The rebuild below runs `gjsify workspace @gjsify/cli build`, whose `build`
# script is a plain `tsc` resolved from THIS tree's node_modules. A freshly
# added git worktree — the standard isolated-agent flow — resolves a CLI just
# fine via PATH and has no node_modules at all. The hook then sailed past the
# skip above and died on `tsc: command not found`, turning a documented graceful
# skip into a hard commit failure exactly where it is least recoverable:
# mid-commit, in a tree the author has not installed.
#
# Skipping is safe by design; CI is the exhaustive check. A skip costs a red CI
# run, a hard failure costs the commit.
if [ ! -d "$REPO_ROOT/node_modules" ]; then
    echo "::warning::[gjsify pre-commit] no node_modules in $REPO_ROOT — cannot rebuild the bundle;"
    echo "::warning::[gjsify pre-commit] skipping bundle freshness check. Run 'gjsify install' in THIS tree first."
    echo "::warning::[gjsify pre-commit] CI (verify-committed-bundles.mjs) remains the exhaustive check."
    exit 0
fi

# --- Rebuild failure is a WARNING, never a lost commit --------------------
#
# The two guards above are preconditions the hook can TEST. This is the one it
# cannot: a tree with node_modules and a resolvable CLI can still be unable to
# build, because the bundle build walks the whole workspace-dep closure and dies
# on the first package whose `lib/` is absent.
#
# Measured on the win32 test VM: a fresh checkout + `gjsify install --immutable`
# + a change under `packages/infra/cli/src/` reached this point and failed with
#
#   [plugin gjsify-unresolved-workspace-import] cannot resolve `@gjsify/fs`
#
# — three unbuilt polyfill packages. Building them first is not a workaround a
# contributor can reach for on that host either, so the hook turned "your bundle
# is stale" into "you cannot commit at all" on the platform with the fewest ways
# out. The answer is the one this hook already chose twice: degrade loudly.
rebuild_failed() {
    echo "::warning::[gjsify pre-commit] bundle rebuild FAILED in this tree — committing WITHOUT refreshing it."
    echo "::warning::[gjsify pre-commit] failing step: $1"
    echo "::warning::[gjsify pre-commit] CI (verify-committed-bundles.mjs) WILL flag the stale bundle."
    echo "::warning::[gjsify pre-commit] Rebuild on a host that can complete the full build, then amend:"
    echo "::warning::[gjsify pre-commit]   gjsify run build:infra"
    echo "::warning::[gjsify pre-commit]   gjsify workspace @gjsify/cli build"
    echo "::warning::[gjsify pre-commit]   gjsify workspace @gjsify/cli build:affected-bundle"
    exit 0
}

# --- Detect what changed -------------------------------------------------
#
# `--diff-filter=ACMR` includes Added / Copied / Modified / Renamed entries.
# Deliberately not Deleted — a pure delete won't make the bundle stale.
#
# Two non-`cli/src` paths are included deliberately, both for the same reason:
# they are inlined into the bundle AND their staleness is SILENT.
#
#   packages/infra/resolve-npm/lib/          — DATA the bundle inlines:
#     `globals-map.mjs`'s GJS_GLOBALS_MAP (identifier → `/register` subpath) and
#     `index.mjs`'s alias maps. A new entry SILENTLY no-ops until the bundle is
#     rebuilt — `--globals auto` just fails to inject the identifier, no error.
#
#   packages/infra/rolldown-plugin-gjsify/src/ — the BUILD PIPELINE the bundle
#     inlines (resolveId/load plugins: alias, gi-node, napi-addon, externals,
#     entry wrapper, the app/* orchestrators). Same silence, worse blast radius.
#
# Both still apply to `affected.gjs.mjs`: it is built by the same `--app gjs`
# pipeline from the same CLI source tree, so the same inputs stale it.
AFFECTED_SRC_CHANGED="$(git diff --cached --name-only --diff-filter=ACMR -- packages/infra/cli/src/ packages/infra/cli/package.json packages/infra/resolve-npm/lib/ packages/infra/rolldown-plugin-gjsify/src/ | head -1)"

if [ -z "$AFFECTED_SRC_CHANGED" ]; then
    exit 0
fi

echo "[gjsify pre-commit] staged changes may stale packages/infra/cli/dist/affected.gjs.mjs:"
echo "  • packages/infra/cli/src/ (or package.json), packages/infra/resolve-npm/lib/, or packages/infra/rolldown-plugin-gjsify/src/"
echo "[gjsify pre-commit] rebuilding it — bypass with 'git commit --no-verify' or SKIP_GJSIFY_HOOKS=1."

# `build` first: `build:affected-bundle` bundles `lib/`, which that step emits.
#
# `--with-dependencies` IS LOAD-BEARING, and its absence staged a wrong artefact
# twice. The bundle is built from the CLI's `lib/` AND its dependencies' — and
# nothing forces those to be current, so on a tree that had merely been pulled this
# rebuilt against a stale `resolve-npm`/`rolldown-plugin-gjsify` and produced a
# 249376 B bundle where the source at HEAD produces 258405 B. CI then failed its
# artifact check on a file the branch had no business changing, on two PRs whose
# only CLI edit was a *.spec.ts that the bundle does not contain.
#
# Same shape as #1080 one level down: a build trusting an on-disk artefact without
# checking it is current. There the answer was to widen the SELECTION rather than
# add a probe, and it is the same answer here.
$GJSIFY workspace @gjsify/cli build --with-dependencies || rebuild_failed "gjsify workspace @gjsify/cli build --with-dependencies"
$GJSIFY workspace @gjsify/cli build:affected-bundle || rebuild_failed "gjsify workspace @gjsify/cli build:affected-bundle"

# ANNOUNCE a change instead of staging it silently. A rebuild producing identical
# bytes is the COMMON case — the bundle carries only the `affected` command, so most
# CLI edits leave it alone — and `git add` of an identical file is a no-op anyway.
# When the bytes DO differ, the commit grows a binary file the author never edited,
# and that deserves a line: it is either a real consequence of the change, or the
# signal that this tree built something CI will not reproduce.
if git diff --quiet HEAD -- packages/infra/cli/dist/affected.gjs.mjs 2>/dev/null; then
    echo "[gjsify pre-commit] affected.gjs.mjs unchanged by the rebuild — nothing to stage"
    exit 0
fi
git add packages/infra/cli/dist/affected.gjs.mjs
echo "[gjsify pre-commit] affected.gjs.mjs CHANGED — staged. If this commit does not touch the"
echo "[gjsify pre-commit] \`affected\` command, check that is intended: CI rebuilds the bundle from"
echo "[gjsify pre-commit] source at HEAD and fails when the two disagree."

exit 0
