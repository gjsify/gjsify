#!/usr/bin/env bash
# gjsify pre-commit hook — auto-rebuild + re-stage the committed GJS bundles
# when the corresponding source trees were changed in the staged diff.
#
# Why this exists
# ---------------
# Two committed artifacts gate CI builds:
#
#   packages/infra/cli/dist/cli.gjs.mjs   (the @gjsify/cli GJS bundle)
#   packages/infra/tsc/dist/tsc.gjs.mjs   (the @gjsify/tsc GJS bundle)
#
# `.github/workflows/main.yml` runs `gjs -m <bundle> --version` against each
# committed bundle and fails the build if the reported version does not match
# the source-of-truth in `package.json` / `TYPESCRIPT_VERSION`. Contributors
# who edit the corresponding `src/` without rebuilding the bundle land red
# CI runs (~45 min × 2 platforms wasted). This hook removes the foot-gun by
# rebuilding + auto-staging the affected bundle inside the same commit.
#
# Bypass
# ------
#   git commit --no-verify          # standard escape hatch
#   SKIP_GJSIFY_HOOKS=1 git commit  # env-var escape hatch (CI, scripted commits)
#
# Install
# -------
#   node scripts/install-git-hooks.mjs   # sets core.hooksPath=.githooks
#   gjsify install                       # also installs the hook
#

set -e

# --- Bypass --------------------------------------------------------------

if [ "${SKIP_GJSIFY_HOOKS:-0}" = "1" ]; then
    exit 0
fi

# --- Repo root resolution ------------------------------------------------
#
# A pre-commit hook may be invoked from any subdirectory of the working tree
# (git invokes hooks with CWD=repo-root, but we don't rely on that — some
# wrappers/IDEs change CWD before exec). Resolve the root explicitly.

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- gjsify resolution ---------------------------------------------------
#
# Prefer the workspace-local CLI at node_modules/.bin/gjsify so the rebuilt
# bundle uses the same version the workspace declares (matters during a
# version bump where the global gjsify on PATH may drift from
# packages/infra/cli/package.json#version). Fall back to PATH, then to the
# committed GJS bundle itself. Resolving one of those says NOTHING about
# whether this tree can BUILD — the guard below is the precondition that
# actually matters, and the two diverge in every fresh worktree.

if [ -x "$REPO_ROOT/node_modules/.bin/gjsify" ]; then
    GJSIFY="$REPO_ROOT/node_modules/.bin/gjsify"
elif command -v gjsify >/dev/null 2>&1; then
    GJSIFY="$(command -v gjsify)"
elif command -v gjs >/dev/null 2>&1 && [ -f "$REPO_ROOT/packages/infra/cli/dist/cli.gjs.mjs" ]; then
    GJSIFY="gjs -m $REPO_ROOT/packages/infra/cli/dist/cli.gjs.mjs"
else
    echo "::warning::[gjsify pre-commit] no gjsify CLI on PATH and no node_modules/.bin/gjsify;"
    echo "::warning::[gjsify pre-commit] skipping bundle freshness check. Run 'gjsify install' first."
    exit 0
fi

# Finding a CLI is NOT the precondition — BUILDING is, and the two diverge.
# The rebuild below runs `gjsify workspace @gjsify/cli build`, whose `build`
# script is a plain `tsc` resolved from THIS tree's node_modules. A freshly
# added git worktree — the standard isolated-agent flow, not the "near
# impossible" case the comment above assumed — resolves a CLI just fine via
# PATH or the committed bundle and has no node_modules at all. The hook then
# sailed past the skip above and died on `tsc: command not found`, turning a
# documented graceful skip into a hard commit failure exactly where it is
# least recoverable: mid-commit, in a tree the author has not installed.
#
# Skipping is safe by design. This hook is BEST-EFFORT (its trigger list is a
# four-path heuristic over a bundle that inlines the whole workspace-dep
# closure); `verify-committed-bundles.mjs` in CI is the exhaustive check and
# fails the PR with exact commands. A skip costs a red CI run; a hard failure
# costs the commit.
if [ ! -d "$REPO_ROOT/node_modules" ]; then
    echo "::warning::[gjsify pre-commit] no node_modules in $REPO_ROOT — cannot rebuild the bundle(s);"
    echo "::warning::[gjsify pre-commit] skipping bundle freshness check. Run 'gjsify install' in THIS tree first."
    echo "::warning::[gjsify pre-commit] CI (verify-committed-bundles.mjs) remains the exhaustive check."
    exit 0
fi

# --- Rebuild failure is a WARNING, never a lost commit --------------------
#
# The two guards above are preconditions the hook can TEST. This is the one it
# cannot: a tree with node_modules and a resolvable CLI can still be unable to
# build the bundle, because `build:gjs-bundle` bundles the whole workspace-dep
# closure and dies on the first package whose `lib/` is absent.
#
# Measured on the win32 test VM: a fresh checkout + `gjsify install --immutable`
# + a change under `packages/infra/cli/src/` reached this point and failed with
#
#   [plugin gjsify-unresolved-workspace-import] cannot resolve `@gjsify/fs`
#
# — three unbuilt polyfill packages. Building them first is not a workaround a
# contributor can reach for on that host either (the `--library` builds those
# packages use are the slow path there), so the hook turned "your bundle is
# stale" into "you cannot commit at all" on the platform with the fewest ways
# out. Same shape as the git-worktree failure documented above, which is why
# the answer is the same one this hook already chose twice: degrade loudly.
#
# The warning names the exact CI check and the exact commands, so the stale
# bundle is a known, actionable follow-up rather than a surprise.
rebuild_failed() {
    echo "::warning::[gjsify pre-commit] bundle rebuild FAILED in this tree — committing WITHOUT refreshing it."
    echo "::warning::[gjsify pre-commit] failing step: $1"
    echo "::warning::[gjsify pre-commit] CI (verify-committed-bundles.mjs) WILL flag the stale bundle."
    echo "::warning::[gjsify pre-commit] Rebuild on a host that can complete the full build, then amend:"
    echo "::warning::[gjsify pre-commit]   gjsify run build:infra"
    echo "::warning::[gjsify pre-commit]   gjsify workspace @gjsify/cli build && gjsify workspace @gjsify/cli build:gjs-bundle"
    echo "::warning::[gjsify pre-commit]   gjsify workspace @gjsify/cli build:affected-bundle"
    exit 0
}

# --- Detect what changed -------------------------------------------------
#
# `--diff-filter=ACMR` includes Added / Copied / Modified / Renamed entries.
# We deliberately do not include Deleted — a pure delete won't make the
# bundle stale.
# `--name-only` keeps the command output single-line per file (cheap to
# substring-check via `head -1` for emptiness).

# Two non-`cli/src` paths are included deliberately, both for the same reason:
# they are inlined into the bundle AND their staleness is SILENT.
#
#   packages/infra/resolve-npm/lib/          — DATA the bundle inlines:
#     `globals-map.mjs`'s GJS_GLOBALS_MAP (identifier → `/register` subpath) and
#     `index.mjs`'s alias maps. A new entry SILENTLY no-ops until the bundle is
#     rebuilt — `--globals auto` just fails to inject the identifier, no error.
#
#   packages/infra/rolldown-plugin-gjsify/src/ — the BUILD PIPELINE the bundle
#     inlines (resolveId/load plugins: alias, gi-node, napi-addon, externals,
#     entry wrapper, the app/* orchestrators). Same silence, worse blast radius:
#     a resolver fix appears to do nothing at all when exercised through
#     `node_modules/.bin/gjsify` (which prefers the committed bundle), so the
#     next person re-debugs a bug that is already fixed in `src/`. Cost of a
#     false positive is one extra bundle rebuild; cost of a miss is a shipped
#     build regression, since every e2e that boots `gjs -m dist/cli.gjs.mjs`
#     tests the stale pipeline.
#
# `node_modules/.bin/gjsify` prefers the committed `dist/cli.gjs.mjs` over the
# workspace `lib/` whenever `gjs` is on PATH — that preference is what makes all
# of the above invisible without this trigger.
CLI_SRC_CHANGED="$(git diff --cached --name-only --diff-filter=ACMR -- packages/infra/cli/src/ packages/infra/cli/package.json packages/infra/resolve-npm/lib/ packages/infra/rolldown-plugin-gjsify/src/ | head -1)"
TSC_SRC_CHANGED="$(git diff --cached --name-only --diff-filter=ACMR -- packages/infra/tsc/src/ packages/infra/tsc/package.json | head -1)"

# Avoid re-entering rebuild if nothing relevant changed.
if [ -z "$CLI_SRC_CHANGED" ] && [ -z "$TSC_SRC_CHANGED" ]; then
    exit 0
fi

echo "[gjsify pre-commit] detected staged changes that may stale the committed GJS bundle(s):"
[ -n "$CLI_SRC_CHANGED" ] && echo "  • packages/infra/cli/src/ (or package.json), packages/infra/resolve-npm/lib/, or packages/infra/rolldown-plugin-gjsify/src/"
[ -n "$TSC_SRC_CHANGED" ] && echo "  • packages/infra/tsc/src/ (or package.json)"
echo "[gjsify pre-commit] rebuilding affected bundle(s) — bypass with 'git commit --no-verify' or SKIP_GJSIFY_HOOKS=1."

# --- Rebuild @gjsify/cli -------------------------------------------------

if [ -n "$CLI_SRC_CHANGED" ]; then
    echo "[gjsify pre-commit] rebuilding @gjsify/cli bundle..."
    # Two-step: tsc-build the workspace lib/, then bundle it into the
    # committed dist/cli.gjs.mjs. Both steps mirror what the GJS workflow
    # does for the freshness verifier in main.yml.
    $GJSIFY workspace @gjsify/cli build || rebuild_failed "gjsify workspace @gjsify/cli build"
    $GJSIFY workspace @gjsify/cli build:gjs-bundle || rebuild_failed "gjsify workspace @gjsify/cli build:gjs-bundle"
    git add packages/infra/cli/dist/cli.gjs.mjs
    echo "[gjsify pre-commit] staged packages/infra/cli/dist/cli.gjs.mjs"
    # The dedicated, Soup-free classifier bundle the CI `changes` job boots —
    # rebuilt from the same src/ so it can't drift from the affected logic.
    $GJSIFY workspace @gjsify/cli build:affected-bundle || rebuild_failed "gjsify workspace @gjsify/cli build:affected-bundle"
    git add packages/infra/cli/dist/affected.gjs.mjs
    echo "[gjsify pre-commit] staged packages/infra/cli/dist/affected.gjs.mjs"
fi

# --- Rebuild @gjsify/tsc -------------------------------------------------

if [ -n "$TSC_SRC_CHANGED" ]; then
    echo "[gjsify pre-commit] rebuilding @gjsify/tsc bundle..."
    # The tsc package's `build` script already wraps build-bundle.mjs (no
    # separate :gjs-bundle phase) — its dist/tsc.gjs.mjs is the only artifact.
    $GJSIFY workspace @gjsify/tsc build || rebuild_failed "gjsify workspace @gjsify/tsc build"
    git add packages/infra/tsc/dist/tsc.gjs.mjs
    echo "[gjsify pre-commit] staged packages/infra/tsc/dist/tsc.gjs.mjs"
fi

exit 0
