#!/usr/bin/env bash
# gjsify pre-commit hook — auto-rebuild + re-stage the committed GJS bundles
# when the corresponding source trees were changed in the staged diff.
#
# Why this exists
# ---------------
# Two committed artifacts gate CI builds:
#
#   packages/infra/cli/dist/cli.gjs.mjs   (the @gjsify/cli GJS bundle)
#   packages/infra/tsc/dist/tsc.gjs.mjs   (the @gjsify/tsc GJS bundle)
#
# `.github/workflows/main.yml` rebuilds each committed bundle from source and
# fails the build when it does not reproduce byte-identically
# (`scripts/verify-committed-bundles.mjs`). Contributors who edit an inlined
# source without rebuilding the bundle land red CI runs (~20 min per round
# trip). This hook removes the foot-gun by rebuilding + auto-staging the
# affected bundle inside the same commit.
#
# Trigger set — DERIVED, not hand-maintained
# ------------------------------------------
# The bundles inline the `lib/esm` of their whole transitive workspace-dep
# closure, so a hand-written path list structurally cannot keep up (it missed
# `@gjsify/fetch`, `@gjsify/utils`+`@gjsify/fs` and `@gjsify/zlib` in a single
# day). Each bundle's build therefore records the workspace packages its
# module graph actually inlined into a committed sibling manifest
# (`dist/<bundle>.gjs.inputs.json`, written by `gjsify build
# --inputs-manifest`, byte-compared in CI like the bundle itself). This hook
# unions those manifests with a few explicit paths and triggers on any staged
# change inside them. Reading a small committed JSON keeps the hook cheap —
# no build runs to DECIDE whether to build.
#
# Bypass
# ------
#   git commit --no-verify          # standard escape hatch
#   SKIP_GJSIFY_HOOKS=1 git commit  # env-var escape hatch (CI, scripted commits)
#
# Install
# -------
#   node scripts/install-git-hooks.mjs   # sets core.hooksPath=.githooks
#   gjsify install                       # also installs the hook
#

set -e

# --- Bypass --------------------------------------------------------------

if [ "${SKIP_GJSIFY_HOOKS:-0}" = "1" ]; then
    exit 0
fi

# --- Repo root resolution ------------------------------------------------
#
# A pre-commit hook may be invoked from any subdirectory of the working tree
# (git invokes hooks with CWD=repo-root, but we don't rely on that — some
# wrappers/IDEs change CWD before exec). Resolve the root explicitly.

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- Detect what changed -------------------------------------------------
#
# `--diff-filter=ACMR` includes Added / Copied / Modified / Renamed entries.
# We deliberately do not include Deleted — a pure delete won't make the
# bundle stale.

# Print the repo-relative package dirs a committed inputs manifest records —
# one per line. The manifest is JSON with one array entry per line (the shape
# `renderInputsManifest` in packages/infra/cli/src/utils/bundle-inputs-manifest.ts
# pins), so plain sed suffices: the hook must work on a fresh clone with no
# node_modules, where neither node nor jq can be assumed.
manifest_pkg_dirs() {
    [ -f "$1" ] || return 0
    sed -n '/"packages": \[/,/\]/{s/^[[:space:]]*"\([^"]*\)",\{0,1\}[[:space:]]*$/\1/p;}' "$1"
}

# Expand package dirs (stdin, one per line) into the pathspecs that are
# committed INPUTS to each package's `lib/esm`: the sources (`src/`), a
# committed no-build `lib/` (the `@gjsify/resolve-npm` shape), and the
# package manifest. No bash-4 namerefs — macOS ships bash 3.2.
expand_pkg_triggers() {
    while IFS= read -r pkg; do
        [ -n "$pkg" ] || continue
        printf '%s\n' "$pkg/src/" "$pkg/lib/" "$pkg/package.json"
    done
}

CLI_DIST="packages/infra/cli/dist"
TSC_DIST="packages/infra/tsc/dist"

# Explicit baseline paths (kept even though the manifests normally cover them —
# they are the belt to the manifests' braces, and they make a checkout whose
# manifests predate this mechanism behave exactly like the old hook):
#
#   packages/infra/resolve-npm/lib/          — DATA the bundle inlines (alias +
#     globals maps); a new entry SILENTLY no-ops until the bundle is rebuilt.
#   packages/infra/rolldown-plugin-gjsify/src/ — the BUILD PIPELINE the bundle
#     inlines; a resolver fix appears to do nothing at all when exercised
#     through `node_modules/.bin/gjsify` (which prefers the committed bundle).
CLI_TRIGGERS=(
    packages/infra/cli/src/
    packages/infra/cli/package.json
    packages/infra/resolve-npm/lib/
    packages/infra/rolldown-plugin-gjsify/src/
)
TSC_TRIGGERS=(
    packages/infra/tsc/src/
    packages/infra/tsc/scripts/
    packages/infra/tsc/package.json
)

# Union of the two CLI bundle manifests (cli.gjs.mjs + affected.gjs.mjs —
# both are rebuilt together, so one trigger set serves both). Duplicate
# pathspecs are harmless to `git diff`.
while IFS= read -r spec; do
    CLI_TRIGGERS+=("$spec")
done < <(
    {
        manifest_pkg_dirs "$CLI_DIST/cli.gjs.inputs.json"
        manifest_pkg_dirs "$CLI_DIST/affected.gjs.inputs.json"
    } | expand_pkg_triggers
)

while IFS= read -r spec; do
    TSC_TRIGGERS+=("$spec")
done < <(manifest_pkg_dirs "$TSC_DIST/tsc.gjs.inputs.json" | expand_pkg_triggers)

CLI_SRC_CHANGED="$(git diff --cached --name-only --diff-filter=ACMR -- "${CLI_TRIGGERS[@]}" | head -5)"
TSC_SRC_CHANGED="$(git diff --cached --name-only --diff-filter=ACMR -- "${TSC_TRIGGERS[@]}" | head -5)"

# Avoid re-entering rebuild if nothing relevant changed.
if [ -z "$CLI_SRC_CHANGED" ] && [ -z "$TSC_SRC_CHANGED" ]; then
    exit 0
fi

echo "[gjsify pre-commit] staged changes stale the committed GJS bundle(s):"
if [ -n "$CLI_SRC_CHANGED" ]; then
    echo "  • $CLI_DIST/{cli,affected}.gjs.mjs — triggered by:"
    echo "$CLI_SRC_CHANGED" | sed 's/^/      /'
fi
if [ -n "$TSC_SRC_CHANGED" ]; then
    echo "  • $TSC_DIST/tsc.gjs.mjs — triggered by:"
    echo "$TSC_SRC_CHANGED" | sed 's/^/      /'
fi

# --- gjsify resolution ---------------------------------------------------
#
# Prefer the workspace-local CLI at node_modules/.bin/gjsify so the rebuilt
# bundle uses the same version the workspace declares (matters during a
# version bump where the global gjsify on PATH may drift from
# packages/infra/cli/package.json#version). Fall back to PATH, then to the
# committed GJS bundle itself.
#
# Resolved AFTER detection on purpose: a checkout that cannot rebuild (a fresh
# worktree with no node_modules — the #821 case) still gets told exactly WHAT
# went stale and what to run, instead of a generic skip notice printed before
# anything was even diffed.

if [ -x "$REPO_ROOT/node_modules/.bin/gjsify" ]; then
    GJSIFY="$REPO_ROOT/node_modules/.bin/gjsify"
elif command -v gjsify >/dev/null 2>&1; then
    GJSIFY="$(command -v gjsify)"
elif command -v gjs >/dev/null 2>&1 && [ -f "$REPO_ROOT/$CLI_DIST/cli.gjs.mjs" ]; then
    GJSIFY="gjs -m $REPO_ROOT/$CLI_DIST/cli.gjs.mjs"
else
    echo "::warning::[gjsify pre-commit] CANNOT REBUILD: no gjsify CLI reachable (node_modules/.bin/gjsify, PATH, or gjs + the committed bundle)."
    echo "::warning::[gjsify pre-commit] The commit proceeds, but the bundle(s) above are STALE and CI's byte-compare (scripts/verify-committed-bundles.mjs) WILL fail."
    echo "::warning::[gjsify pre-commit] Run 'gjsify install' first, then rebuild + amend before pushing:"
    if [ -n "$CLI_SRC_CHANGED" ]; then
        echo "::warning::[gjsify pre-commit]   gjsify workspace @gjsify/cli build --with-dependencies && gjsify workspace @gjsify/cli build:gjs-bundle && gjsify workspace @gjsify/cli build:affected-bundle"
    fi
    if [ -n "$TSC_SRC_CHANGED" ]; then
        echo "::warning::[gjsify pre-commit]   gjsify workspace @gjsify/tsc build"
    fi
    exit 0
fi

echo "[gjsify pre-commit] rebuilding affected bundle(s) — bypass with 'git commit --no-verify' or SKIP_GJSIFY_HOOKS=1."

# --- Rebuild @gjsify/cli -------------------------------------------------

if [ -n "$CLI_SRC_CHANGED" ]; then
    echo "[gjsify pre-commit] rebuilding @gjsify/cli bundle..."
    # Two-step: tsc-build the workspace lib/, then bundle it into the
    # committed dist/cli.gjs.mjs. Both steps mirror what the GJS workflow
    # does for the freshness verifier in main.yml.
    $GJSIFY workspace @gjsify/cli build
    $GJSIFY workspace @gjsify/cli build:gjs-bundle
    git add "$CLI_DIST/cli.gjs.mjs" "$CLI_DIST/cli.gjs.inputs.json"
    echo "[gjsify pre-commit] staged $CLI_DIST/cli.gjs.mjs (+ inputs manifest)"
    # The dedicated, Soup-free classifier bundle the CI `changes` job boots —
    # rebuilt from the same src/ so it can't drift from the affected logic.
    $GJSIFY workspace @gjsify/cli build:affected-bundle
    git add "$CLI_DIST/affected.gjs.mjs" "$CLI_DIST/affected.gjs.inputs.json"
    echo "[gjsify pre-commit] staged $CLI_DIST/affected.gjs.mjs (+ inputs manifest)"
fi

# --- Rebuild @gjsify/tsc -------------------------------------------------

if [ -n "$TSC_SRC_CHANGED" ]; then
    echo "[gjsify pre-commit] rebuilding @gjsify/tsc bundle..."
    # The tsc package's `build` script already wraps build-bundle.mjs (no
    # separate :gjs-bundle phase) — its dist/tsc.gjs.mjs is the only artifact.
    $GJSIFY workspace @gjsify/tsc build
    git add "$TSC_DIST/tsc.gjs.mjs" "$TSC_DIST/tsc.gjs.inputs.json"
    echo "[gjsify pre-commit] staged $TSC_DIST/tsc.gjs.mjs (+ inputs manifest)"
fi

exit 0
