---
// Top-level pillar coverage — one @gjsify/adwaita-web boxed-list row per pillar
// (Node / Web / DOM / Framework / Adwaita / Infra / Build / Showcases /
// Integration). Each <adw-action-row> carries its count + progress meter in the
// suffix. Data is generated by generate-coverage.mjs from the project status
// data (status/ + the package manifests) so the bars always reflect reality.

import { overviewPillars, tallyOverview } from "../data/coverage.ts";

const total = tallyOverview();
const aggregateImplemented = total.full + total.partial;

function shortLabel(category: string): string {
    if (category === "Node.js APIs") return "Node.js modules";
    if (category === "Web APIs") return "Web API packages";
    if (category === "Browser UI / Adwaita assets") return "Adwaita assets";
    if (category === "Framework bridges") return "Framework bridges";
    if (category === "GJS Infrastructure") return "GJS infra";
    if (category === "Build/Infra Tools") return "Build / infra tools";
    if (category === "Integration test suites") return "Integration test suites";
    return category;
}
---

<section class="adw-coverage not-content">
    <header class="adw-coverage-head">
        <p class="adw-group-title">Project Coverage</p>
        <h2 class="adw-coverage-title">{aggregateImplemented} of {total.total} pillar entries implemented</h2>
        <p class="adw-coverage-subtitle">
            Every category of the project status snapshot, rendered as a live progress bar. The data file is regenerated from the status data and the package manifests on every build, so the bars never lag behind reality.
        </p>
    </header>

    <div class="adw-coverage-aggregate">
        <div class="adw-coverage-aggregate-head">
            <span class="adw-coverage-aggregate-pct">{total.implementedPct}%</span>
            <span class="adw-coverage-aggregate-sub">
                <span class="adw-pill adw-pill-success">{total.full} full</span>
                {total.partial > 0 && <span class="adw-pill adw-pill-warning">{total.partial} partial</span>}
                {total.stub > 0 && <span class="adw-pill adw-pill-muted">{total.stub} stub</span>}
            </span>
        </div>
        <div class="adw-bar" role="img" aria-label={`Across ${overviewPillars.length} pillars: ${total.full} full, ${total.partial} partial, ${total.stub} stub`}>
            <span class="adw-bar-seg seg-full" style={`width: ${(total.full / total.total) * 100}%`} />
            <span class="adw-bar-seg seg-partial" style={`width: ${(total.partial / total.total) * 100}%`} />
            <span class="adw-bar-seg seg-out" style={`width: ${(total.stub / total.total) * 100}%`} />
        </div>
    </div>

    <adw-preferences-group class="adw-cov-group">
        {overviewPillars.map((p) => {
            const implemented = p.full + p.partial;
            const pct = p.total === 0 ? 0 : Math.round((implemented / p.total) * 100);
            return (
                <adw-action-row title={shortLabel(p.category)}>
                    <span slot="suffix" class="adw-cov-suffix">
                        <span class="adw-meta-count">{implemented} / {p.total} ({pct}%)</span>
                        <span class="adw-bar adw-bar-inline" role="img" aria-label={`${p.category}: ${p.full} full, ${p.partial} partial, ${p.stub} stub of ${p.total} total`}>
                            <span class="adw-bar-seg seg-full" style={`width: ${(p.full / p.total) * 100}%`} />
                            <span class="adw-bar-seg seg-partial" style={`width: ${(p.partial / p.total) * 100}%`} />
                            <span class="adw-bar-seg seg-out" style={`width: ${(p.stub / p.total) * 100}%`} />
                        </span>
                    </span>
                </adw-action-row>
            );
        })}
    </adw-preferences-group>
</section>

<script>
    import "@gjsify/adwaita-web";
</script>
