---
// AdwWidgetWindow — the ONE window of an {@link AdwWidget} block: a header bar with the
// widget's title, the running widget under it, then the block's source in `tabs`
// (an Adw.TabBar for two or more, the bare pane for one).
//
// Every other rendering (`bindings`) sits behind the header bar's "Other bindings" menu and
// opens in a popover dialog. The menu is a `<details>`, the dialogs use the Popover API, so
// both work without script; the script in AdwWidget only closes the menu on a pick.
//
// `check-website-adwaita-gallery.mjs` arm 9 holds that the preview is mounted once, outside
// the tab view.

import AdwWidgetPane from './AdwWidgetPane.astro';
import type { LivePane, WidgetPane } from './widget-panes';

interface Props {
    /** The widget, e.g. "Adw.SwitchRow". */
    title: string;
    /** Canonical upstream docs for the widget. */
    refHref?: string | null;
    /** What the preview mounts, or none when the block has no markup. */
    live?: LivePane;
    /** The source tabs, in order; also the order `data-impls` names them in. */
    tabs: WidgetPane[];
    /** The panes behind the "Other bindings" menu. */
    bindings: WidgetPane[];
    padding?: 'comfortable' | 'flush';
    scroll?: boolean;
    /** Inline CSS for the preview stage — see AdwWidget. */
    stage?: string;
}

const { title, refHref = null, live, tabs, bindings, padding = 'comfortable', scroll = false, stage } = Astro.props;

const impls = tabs.map((pane) => pane.id).join(',');
const single = tabs.length === 1 ? tabs[0] : null;
const slug = title.replaceAll(/[^A-Za-z0-9]+/g, '-');
const bindingId = (pane: WidgetPane) => `binding-${slug}-${pane.id}`;
---

<div class="command-tabs adw-widget-window not-content" data-impl-tabs data-impls={impls}>
    <div class="command-tabs-headerbar">
        <span class="command-tabs-headerbar-start">
            {
                refHref && (
                    <a
                        class="command-tabs-ref"
                        href={refHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`Reference for ${title}`}
                        aria-label={`Open the reference for ${title} in a new tab`}
                    >
                        <span class="command-tabs-ref-icon" aria-hidden="true" />
                    </a>
                )
            }
        </span>
        <span class="command-tabs-headerbar-title">{title}</span>
        <span class="command-tabs-headerbar-end">
            {
                bindings.length > 0 && (
                    <details class="adw-widget-menu">
                        <summary>Other bindings</summary>
                        <ul>
                            {bindings.map((pane) => (
                                <li>
                                    <button type="button" popovertarget={bindingId(pane)}>
                                        {pane.label}
                                    </button>
                                </li>
                            ))}
                        </ul>
                    </details>
                )
            }
            {
                tabs.length > 0 && (
                    <button class="command-tabs-copy" aria-label="Copy this window's code" type="button">
                        <span class="command-tabs-copy-icon" aria-hidden="true" />
                    </button>
                )
            }
        </span>
    </div>

    {
        live && (
            <div class:list={['adw-widget-preview', 'not-content', `is-${padding}`, { 'is-scroll': scroll }]}>
                {/* `not-content`: Starlight's sibling margin rule would otherwise land on the
                    widgets, which are laid out by their own stylesheet alone. */}
                {/* The preview is CLONED into the stage at runtime (see AdwWidget's script):
                    a <template> is inert, so cloning AFTER the elements are defined avoids the
                    upgrade-order race of nested composites. The markup is the `preview` fence
                    read back out of Expressive Code, so `slot="…"` never meets the MDX compiler. */}
                {/* NOT self-closing: `<template … set:html={…} />` swallows its siblings. */}
                <template class="adw-widget-preview-tpl" data-shared-tree={live.tree} set:html={live.markup ?? ''}></template>
                <div class="adw-widget-preview-stage" style={stage} />
            </div>
        )
    }

    {
        tabs.length > 1 && (
            <adw-tab-view no-close expand-tabs data-impl-view>
                {tabs.map((pane) => (
                    <adw-tab-page title={pane.label}>
                        <AdwWidgetPane pane={pane} widget={title} />
                    </adw-tab-page>
                ))}
            </adw-tab-view>
        )
    }
    {
        single && (
            <div class="adw-widget-window-pane">
                <AdwWidgetPane pane={single} widget={title} />
            </div>
        )
    }

    {
        bindings.map((pane) => (
            <div
                class="adw-widget-binding"
                popover
                id={bindingId(pane)}
                data-pane={pane.id}
                aria-label={`${pane.label} — ${title}`}
            >
                <div class="adw-widget-binding-bar">
                    <span class="adw-widget-binding-title">{pane.label}</span>
                    {pane.kind !== 'refusal' && (
                        <button class="command-tabs-copy" aria-label={`Copy the ${pane.label} code`} type="button">
                            <span class="command-tabs-copy-icon" aria-hidden="true" />
                        </button>
                    )}
                    <button
                        class="adw-widget-binding-close"
                        type="button"
                        popovertarget={bindingId(pane)}
                        popovertargetaction="hide"
                        aria-label="Close"
                    >
                        ×
                    </button>
                </div>
                <AdwWidgetPane pane={pane} widget={title} />
            </div>
        ))
    }
</div>

<style is:global>
    .adw-widget-window .command-tabs-headerbar {
        gap: 6px;
    }

    .adw-widget-window .command-tabs-headerbar-start {
        width: auto;
        min-width: 38px;
    }

    .adw-widget-window .command-tabs-headerbar-title {
        min-width: 0;
    }

    .adw-widget-window .command-tabs-headerbar-end {
        gap: 2px;
    }

    .adw-widget-menu {
        position: relative;
    }

    .adw-widget-menu summary {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        height: 34px;
        padding: 0 10px;
        border-radius: 9px;
        font-size: 0.8125rem;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        list-style: none;
    }

    .adw-widget-menu summary::-webkit-details-marker {
        display: none;
    }

    .adw-widget-menu summary::after {
        content: '';
        width: 0.4em;
        height: 0.4em;
        border: solid currentColor;
        border-width: 0 1.5px 1.5px 0;
        transform: translateY(-0.1em) rotate(45deg);
    }

    .adw-widget-menu summary:hover,
    .adw-widget-menu[open] summary {
        background: rgba(128, 128, 128, 0.12);
    }

    .adw-widget-menu ul {
        position: absolute;
        z-index: 5;
        top: calc(100% + 4px);
        right: 0;
        min-width: 11rem;
        margin: 0;
        padding: 6px;
        list-style: none;
        border: 1px solid rgba(128, 128, 128, 0.3);
        border-radius: 12px;
        background: var(--adw-view-bg);
        color: var(--adw-window-fg);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }

    :root[data-theme='dark'] .adw-widget-menu ul {
        background: var(--adw-window-bg);
    }

    .adw-widget-menu li {
        margin: 0;
    }

    .adw-widget-menu li button {
        display: block;
        width: 100%;
        padding: 6px 10px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: inherit;
        font: inherit;
        font-size: 0.875rem;
        text-align: left;
        cursor: pointer;
    }

    .adw-widget-menu li button:hover,
    .adw-widget-menu li button:focus-visible {
        background: rgba(128, 128, 128, 0.16);
    }

    .adw-widget-binding {
        width: min(54rem, calc(100vw - 2rem));
        max-height: min(80vh, 42rem);
        margin: auto;
        padding: 0;
        overflow: auto;
        border: 1px solid rgba(128, 128, 128, 0.3);
        border-radius: 12px;
        background: var(--view-bg-color);
        color: var(--view-fg-color);
    }

    .adw-widget-binding::backdrop {
        background: rgba(0, 0, 0, 0.45);
    }

    .adw-widget-binding-bar {
        position: sticky;
        top: 0;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 47px;
        padding: 0 6px 0 16px;
        background: var(--headerbar-bg-color);
        color: var(--headerbar-fg-color);
    }

    .adw-widget-binding-title {
        flex: 1;
        font-size: 0.875rem;
        font-weight: bold;
    }

    .adw-widget-binding-close {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 9px;
        background: transparent;
        color: inherit;
        font-size: 1.25rem;
        line-height: 1;
        cursor: pointer;
    }

    .adw-widget-binding-close:hover {
        background: rgba(128, 128, 128, 0.12);
    }
</style>
