---
// Live Adwaita-window embed for a showcase sub-page.
//
// Mirrors the slot styling used by the home-page slideshow
// (`ShowcaseSlideshow.astro`): a dark-tinted, rounded, drop-shadowed container
// that frames the showcase's `mount()` output as if it were an Adwaita window.
// Each embed lazy-imports its showcase's `./browser` entry on first paint via
// the shared registry (`showcase-mounts.ts`) and forwards an optional
// `mountOpts` payload (typically `{ assetBase }`).
//
// CSS is duplicated from the slideshow on purpose — extracting it would touch
// the slideshow's working visual stack. Both components must stay in sync; if
// you change one, change the other — EXCEPT the `.showcase-embed :global(* + *)`
// margin reset below, which is embed-only: it counters Starlight's
// `.sl-markdown-content` content-flow margins, which apply only on the doc
// pages that host this embed, never on the (non-Starlight) home-page slideshow.

import {
  showcaseMountOpts,
  type ShowcaseMountOpts,
  type ShowcaseName,
} from './showcase-registry.ts';

interface Props {
  /** Showcase identifier — see `SHOWCASE_NAMES` in `showcase-registry.ts`. */
  name: ShowcaseName;
  /**
   * DOM id for the mount container. Defaults to the showcase name. Override
   * if a single page renders multiple embeds of the same showcase.
   */
  slideId?: string;
  /**
   * Layered over the showcase's registry defaults and forwarded to
   * `mount(container, mountOpts)`. Only the keys the specific showcase
   * understands are read; extras are ignored.
   */
  mountOpts?: ShowcaseMountOpts;
}

const { name, slideId, mountOpts } = Astro.props;
const id = slideId ?? name;

// `assetBase` and friends come from the registry, so a page only has to name
// its showcase. Resolved here rather than in the client script because
// `import.meta.env.BASE_URL` is a build-time constant on both sides, and one
// fully-resolved payload beats shipping a placeholder the client has to expand.
const resolvedMountOpts = showcaseMountOpts(name, import.meta.env.BASE_URL, mountOpts);

const mountOptsJson = JSON.stringify(resolvedMountOpts);
---

<div class="showcase-embed not-content" data-showcase-name={name} data-mount-opts={mountOptsJson}>
  <div
    class="showcase-embed-window focusable"
    id={`demo-${id}`}
    tabindex="0"
    style="background-color:#222226"
  ></div>
</div>

<script>
  // Lazy-mount each showcase embed when it first scrolls into view. Goes
  // through the same registry as the slideshow's `mountSlide()`, so the two
  // hosts share both the chunk split and the list of what can be mounted.
  import { mountShowcase, type ShowcaseHandle } from './showcase-mounts.ts';
  import type { ShowcaseMountOpts } from './showcase-registry.ts';

  const mounted = new WeakSet<Element>();
  const handles = new WeakMap<Element, ShowcaseHandle>();

  function resolveOpts(raw: string | null | undefined): ShowcaseMountOpts {
    if (!raw) return {};
    try {
      return JSON.parse(raw) as ShowcaseMountOpts;
    } catch {
      return {};
    }
  }

  async function doMount(root: HTMLElement): Promise<void> {
    if (mounted.has(root)) return;
    mounted.add(root);

    const name = root.dataset.showcaseName;
    const container = root.querySelector<HTMLElement>('.showcase-embed-window');
    if (!name || !container) return;

    const handle = await mountShowcase(name, container, resolveOpts(root.dataset.mountOpts));
    if (handle) handles.set(root, handle);
  }

  function observe(root: HTMLElement): void {
    if (!('IntersectionObserver' in window)) {
      // Old browsers / SSR-less environments: mount eagerly.
      void doMount(root);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            io.disconnect();
            void doMount(root);
            return;
          }
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(root);
  }

  document
    .querySelectorAll<HTMLElement>('.showcase-embed')
    .forEach((root) => observe(root));
</script>

<style>
  /* Mirrors the slideshow's `.slide-demo` framing so the embed reads as an
     Adwaita window — same aspect ratio, radius, shadow and dark surface tint
     used by `ShowcaseSlideshow.astro`. Margin-block adds breathing room
     between the embed and the surrounding MDX prose. */
  .showcase-embed {
    width: 100%;
    max-width: 1100px;
    margin: 1.5rem auto 2rem;
    /* The slideshow uses 30px of padding on its track to give the window's
       drop-shadow room to bleed; we replicate that here so the shadow isn't
       clipped against the next paragraph. */
    padding: 16px 0 24px;
  }

  /* Starlight's content-flow margins (`.sl-markdown-content :not(…) + :not(…)
     { margin-top }`) leak INTO the embedded live Adwaita window: its elements
     are LIGHT-DOM siblings inside the markdown content, so the window's content
     (e.g. `adw-overlay-split-view`, which follows the headerbar) picks up a
     stray `margin-top` — opening a visible gap below the headerbar (and between
     any sibling demo elements). The homepage slideshow is NOT a Starlight
     content page, so it never shows this; hence this reset is embed-only — an
     intentional divergence from the slideshow's otherwise-shared CSS. The demo
     is a self-contained app (adwaita-web lays out via flex/gap, never sibling
     margins — verified), so zeroing the leaked top-margins is safe. `!important`
     beats Starlight's (0,1,2)-specificity selector. */
  .showcase-embed :global(* + *) {
    margin-top: 0 !important;
  }

  .showcase-embed-window {
    width: 100%;
    aspect-ratio: 11 / 7;
    border-radius: 12px;
    overflow: hidden;
    /* Hard-coded surface tint matches the dark Adwaita window background so
       the slot looks framed even before the showcase has mounted. */
    background-color: #222226;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.08);
    position: relative;
    outline: none;
  }

  /* Light-theme placeholder — same fallback shade the slideshow uses. */
  :root[data-theme='light'] .showcase-embed-window {
    background-color: #fafafb;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .showcase-embed-window {
      background-color: #fafafb;
    }
  }

  /* Adwaita window fills the container (Three / Excalibur / minimalist-browser
     hosts emit an `<adw-window>` shell via `@gjsify/adwaita-web`). */
  .showcase-embed-window :global(adw-window) {
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    max-height: none;
    border-radius: 0;
    box-shadow: none;
    outline: none;
  }

  /* Canvas fills the container (canvas2d-fireworks, also WebGL host canvases
     used by Three and Excalibur). */
  .showcase-embed-window :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* WebRTC loopback log + minimalist-browser shell render plain sections —
     make them fill the slot so the demo doesn't sit awkwardly above empty
     dark space. */
  .showcase-embed-window :global(section) {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  /* Make the embed legible on smaller viewports — switch to a 4:3 aspect
     ratio so the demos retain enough vertical room. Mirrors the slideshow's
     mobile breakpoint. */
  @media (max-width: 600px) {
    .showcase-embed-window {
      aspect-ratio: 4 / 3;
    }
  }
</style>
