---
// AdwWidget — the documentation block for one Adwaita component: ONE window with the
// running widget on top and the source under it in two tabs, Blueprint and TypeScript.
// Every other rendering (Web Components, NativeScript, Solid, Vue, React, and the recorded
// reasons for the ones a widget has none of) is behind the window's "Other bindings" menu.
//
// Feed the sources as named MDX slots, one fenced code block each; a tab appears only where
// its slot was given:
//
//   <AdwWidget title="Adw.SwitchRow">
//     <Fragment slot="preview">```html …```</Fragment>
//     <Fragment slot="gjs">```ts …```</Fragment>
//     <Fragment slot="blueprint">```blueprint …```</Fragment>
//   </AdwWidget>
//
// The `preview` fence is the single source of the markup: the live widget mounts it and the
// "Web Components" binding shows it. A ONE-BLUEPRINT block names its layout instead:
//
//   <AdwWidget title="Adw.Clamp" blueprint="adwaita/clamp.blp">
//     <Fragment slot="gjs">```ts …```</Fragment>
//     <Fragment slot="webloader">```js …```</Fragment>
//     <Fragment slot="nativescriptloader">```ts …```</Fragment>
//   </AdwWidget>
//
// The `.blp` is the Blueprint tab and builds the live widget; the Web Components and
// NativeScript bindings are files generated from it ({@link PANE_MARKUP}) beside the loader
// code the page writes. `scripts/check-website-adwaita-gallery.mjs` reads this file's slot
// declarations and holds the pages to them.

interface Props {
    /** The widget, e.g. "Adw.SwitchRow". Titles the window. */
    title?: string;
    /** "flush" for widgets that own their full surface; the default pads small ones. */
    padding?: 'comfortable' | 'flush';
    /** Scroll the preview horizontally instead of clipping a wide widget. */
    scroll?: boolean;
    /**
     * Inline CSS for the preview STAGE. Preview-only scaffolding (a height for a widget that
     * has none) kept out of the markup the reader copies.
     */
    stage?: string;
    /** Upstream reference URL; omit to derive it from an `Adw.*` / `Gtk.*` title, `false` to drop it. */
    docHref?: string | false;
    /** The `.blp` that builds this widget, relative to `src/blueprints/`; selects the one-Blueprint shape. */
    blueprint?: string;
}

import {
    ADWAITA_FRAMEWORK_REFUSALS,
    ADWAITA_FRAMEWORK_SNIPPETS,
    type FrameworkDialect,
} from '../data/adwaita-framework-snippets';
import {
    ADWAITA_NATIVESCRIPT_REFUSALS,
    ADWAITA_NATIVESCRIPT_TEMPLATES,
} from '../data/adwaita-nativescript-templates';
import type { SharedTreeNode } from '@gjsify/adwaita-core/conformance';
import { sharedTreeHtml, sharedTreeNativeScriptXml } from '@gjsify/adwaita-core/markup';
import AdwWidgetWindow from './AdwWidgetWindow.astro';
import { BLUEPRINT_PANE_FILES, BLUEPRINT_PANE_SLOTS } from './blueprint-panes.mjs';
import type { LivePane, WidgetPane } from './widget-panes';

const { title = 'Code', padding = 'comfortable', scroll = false, stage, docHref, blueprint } = Astro.props;

// Every `.blp`, read as its SOURCE (`?raw`, Vite's own) and as the `?shared-tree` projection
// the live preview builds, keyed by the same glob so a block cannot name two files.
const BLUEPRINT_SOURCES = import.meta.glob<string>('../blueprints/**/*.blp', {
    query: '?raw',
    import: 'default',
    eager: true,
});
const BLUEPRINT_TREES = import.meta.glob<unknown>('../blueprints/**/*.blp', {
    query: '?shared-tree',
    import: 'default',
    eager: true,
});
const blueprintKey = blueprint === undefined ? undefined : `../blueprints/${blueprint}`;
const blueprintSource = blueprintKey === undefined ? undefined : BLUEPRINT_SOURCES[blueprintKey];
const blueprintTree = blueprintKey === undefined ? undefined : BLUEPRINT_TREES[blueprintKey];
if (blueprint !== undefined && (blueprintSource === undefined || blueprintTree === undefined)) {
    throw new Error(
        `AdwWidget(${title}): blueprint="${blueprint}" names no file under src/blueprints/. ` +
            `Known: ${Object.keys(BLUEPRINT_SOURCES).map((key) => key.replace('../blueprints/', '')).join(', ')}.`,
    );
}
const oneBlueprint = blueprint !== undefined;

const REF_BASES: Record<string, string> = {
    Adw: 'https://gnome.pages.gitlab.gnome.org/libadwaita/doc/main/class.',
    Gtk: 'https://docs.gtk.org/gtk4/class.',
};
const deriveRef = (t: string): string | null => {
    const m = /^(Adw|Gtk)\.([A-Za-z][A-Za-z0-9]*)$/.exec(t);
    return m ? `${REF_BASES[m[1]]}${m[2]}.html` : null;
};
const refHref = docHref === false ? null : (docHref ?? deriveRef(title));

// The Solid, Vue and React snippets, rendered from `data/adwaita-framework-snippets.ts`.
// Each was compiled and run by `showcases/gtk/adwaita-gallery-*` before it was written down.
const FRAMEWORK_PANES: readonly { id: FrameworkDialect; label: string; lang: string }[] = [
    { id: 'solid', label: 'Solid', lang: 'tsx' },
    { id: 'vue', label: 'Vue', lang: 'vue' },
    { id: 'react', label: 'React', lang: 'tsx' },
];

// The NativeScript XML template, from `data/adwaita-nativescript-templates.ts`.
const NATIVESCRIPT_PANES: readonly { id: string; label: string; lang: string }[] = [
    { id: 'nativescript-xml', label: 'NativeScript', lang: 'xml' },
];

/**
 * A group of data panes and the recorded reason that stands in for them. The two groups
 * partition the gallery independently (28 blocks have a framework tree, 28 an XML template,
 * and not the same 28), so each has its own reason.
 */
type PaneGroup = {
    code: readonly { id: string; label: string; lang: string }[];
    codeOf: (widget: string, pane: string) => string | undefined;
    refusalOf: (widget: string) => string | undefined;
    /** The pane the reason renders as; its id has to be unique among all panes. */
    refusal: { pane: string; label: string; missing: string; note: string };
};

const FRAMEWORK_GROUP: PaneGroup = {
    code: FRAMEWORK_PANES,
    codeOf: (widget, pane) => ADWAITA_FRAMEWORK_SNIPPETS[widget]?.[pane as FrameworkDialect],
    refusalOf: (widget) => ADWAITA_FRAMEWORK_REFUSALS[widget],
    refusal: {
        pane: 'why-not',
        label: 'Why no Solid, Vue or React',
        missing: 'Solid, Vue or React snippet',
        note:
            'Every snippet in this gallery was compiled and run before it was written down. Where a widget is ' +
            'built imperatively rather than declared — a Gio.MenuModel, a dialog opened with present(), a ' +
            'container with no child policy — there is nothing for the three dialects to differ about, so the ' +
            'reason is recorded here rather than the entry being quietly absent.',
    },
};

// DATA and not a slot: an XML template is the one dialect where "it renders" cannot be read
// off the text (NativeScript's Builder assigns `open="false"` verbatim and opened a dialog).
// Only a run says which, and the generator's output is what that run asserts.
const NATIVESCRIPT_GROUP: PaneGroup = {
    code: NATIVESCRIPT_PANES,
    codeOf: (widget) => ADWAITA_NATIVESCRIPT_TEMPLATES[widget],
    refusalOf: (widget) => ADWAITA_NATIVESCRIPT_REFUSALS[widget],
    refusal: {
        pane: 'why-no-xml',
        label: 'Why no NativeScript XML',
        missing: 'NativeScript XML template',
        note:
            'NativeScript’s Builder reaches a widget through an attribute, which is always a string, and ' +
            'through a child, which lands only where the widget declares a slot for it. A property that is an ' +
            'array of options or a reference to another view fits through neither, so such a widget is built ' +
            'from TypeScript instead.',
    },
};

/** The slot whose fence is BOTH mounted by the live preview and shown as the Web Components binding. */
const MARKUP_SLOT = 'preview';

/**
 * The one slot that is an OVERRIDE: markup shown in place of {@link MARKUP_SLOT}'s fence, for
 * `<adw-toast-overlay>`, whose preview DOM is internal and must not be copied.
 */
const MARKUP_OVERRIDE = 'web';

/**
 * Slots a page AUTHORS that nothing renders, with what reads each one instead. Astro drops an
 * unmatched slot in silence, so the category is named for the gate to tell it from a typo.
 *
 * `nativescript`: a block's NativeScript program should be its `gjs` program, byte for byte
 * (ADR 0034); arm 12 of the gate holds the two together.
 */
const CORPUS_SLOTS: Record<string, string> = {
    nativescript: 'held against the `gjs` fence of the same block by arm 12 of scripts/check-website-adwaita-gallery.mjs',
};

/** Slots only a ONE-BLUEPRINT block writes: loaders for the generated `.blp` markup. */
const ONE_BLUEPRINT_SLOTS: Record<string, string> = {
    webloader: 'the module script that reaches an element of the generated `<adw-*>` markup by its id',
    nativescriptloader: 'the TypeScript that loads the generated XML template (`Builder.load`) and reaches a view by its id',
};

/** Slots a one-Blueprint block must NOT write: the component fills them from the `.blp`. */
const FROM_THE_BLUEPRINT: Record<string, string> = {
    blueprint: 'the Blueprint tab renders the `.blp` file itself',
    preview: 'the live widget builds the `.blp`, so there is no markup to mount or to show',
};

/** The generated markup of each loader binding, built from the tree the preview mounts. */
const PANE_MARKUP: Record<string, (tree: SharedTreeNode) => string> = {
    webloader: sharedTreeHtml,
    nativescriptloader: sharedTreeNativeScriptXml,
};

type BlockShape = 'markup' | 'one-Blueprint';

/** The tabs under the preview, in order. A tab with no source on a block is skipped. */
const TABS = [
    { slot: 'blueprint', label: 'Blueprint' },
    { slot: 'gjs', label: 'TypeScript' },
] as const;

/** Slot-backed entries of the "Other bindings" menu, before the data panes of {@link GROUPS}. */
const BINDINGS = [
    { slot: MARKUP_SLOT, label: 'Web Components' },
    { slot: 'webloader', label: 'Web Components' },
    { slot: 'nativescriptloader', label: 'NativeScript' },
] as const;

/** The data panes of each block shape, in menu order. */
const GROUPS: Record<BlockShape, readonly PaneGroup[]> = {
    markup: [NATIVESCRIPT_GROUP, FRAMEWORK_GROUP],
    'one-Blueprint': [FRAMEWORK_GROUP],
};

/** U+007F — Expressive Code's own stand-in for a newline inside `data-code`. */
const EC_NEWLINE = String.fromCharCode(0x7f);

/**
 * Expressive Code hands the raw source back on the copy button's `data-code`, which is how
 * the live preview gets the fence's bytes. Only NUMERIC entities are decoded, in one pass:
 * EC escapes `&` as `&#x26;`, so `&#x26;lt;` is a literal `&lt;` that must stay one.
 */
const decodeEcCode = (html: string): string | null => {
    const found = [...html.matchAll(/data-code="([^"]*)"/g)];
    if (found.length !== 1) return null;
    return found[0][1]
        .replaceAll(EC_NEWLINE, '\n')
        .replaceAll(/&#x([0-9a-fA-F]+);/g, (_m, hex: string) => String.fromCodePoint(Number.parseInt(hex, 16)))
        .replaceAll(/&#(\d+);/g, (_m, dec: string) => String.fromCodePoint(Number(dec)));
};

const shape: BlockShape = oneBlueprint ? 'one-Blueprint' : 'markup';
const groups = GROUPS[shape];

// Pane ids are the preference keys and the dialog ids, so no two may share one.
const PANE_IDS = [
    ...TABS.map((tab) => tab.slot),
    ...BINDINGS.map((binding) => binding.slot),
    ...[...new Set(Object.values(GROUPS).flat())].flatMap((group) => [
        ...group.code.map((pane) => pane.id),
        group.refusal.pane,
    ]),
];
const duplicatePane = PANE_IDS.find((id, index) => PANE_IDS.indexOf(id) !== index);
if (duplicatePane !== undefined) {
    throw new Error(`AdwWidget: "${duplicatePane}" names two panes (${PANE_IDS.join(', ')}). Give each its own id.`);
}
const renderedCorpusSlot = [...TABS, ...BINDINGS].find((entry) => Object.hasOwn(CORPUS_SLOTS, entry.slot));
if (renderedCorpusSlot !== undefined) {
    throw new Error(
        `AdwWidget: "${renderedCorpusSlot.slot}" is in CORPUS_SLOTS and rendered as a pane. A corpus slot is not rendered.`,
    );
}

// A block of one shape writing a slot of the other is refused by name: Astro would render it.
for (const slot of Object.keys(oneBlueprint ? FROM_THE_BLUEPRINT : ONE_BLUEPRINT_SLOTS)) {
    if (!Astro.slots.has(slot)) continue;
    throw new Error(
        oneBlueprint
            ? `AdwWidget(${title}): a one-Blueprint block writes no "${slot}" fragment — ${FROM_THE_BLUEPRINT[slot]}.`
            : `AdwWidget(${title}): the "${slot}" fragment loads a \`.blp\`, and this block names none. ` +
                  'Give it a `blueprint="…"` prop, or drop the fragment.',
    );
}

// The block's markup, read once: the live widget mounts it and the Web Components binding shows it.
const markupHtml = Astro.slots.has(MARKUP_SLOT) ? await Astro.slots.render(MARKUP_SLOT) : null;
const previewMarkup = markupHtml === null ? null : decodeEcCode(markupHtml);
// An empty fence decodes to '' and would mount nothing at exit 0, so it counts as missing.
if (markupHtml !== null && (previewMarkup === null || previewMarkup.trim() === '')) {
    throw new Error(
        `AdwWidget(${title}): the preview slot rendered no single NON-EMPTY Expressive Code ` +
            'block to read its markup back from. It has to hold exactly one fenced ```html ' +
            'block, with markup in it.',
    );
}

const live: LivePane | undefined = oneBlueprint
    ? { tree: JSON.stringify(blueprintTree) }
    : previewMarkup === null
      ? undefined
      : { markup: previewMarkup };

const tabs: WidgetPane[] = [];
for (const tab of TABS) {
    if (oneBlueprint && tab.slot === 'blueprint') {
        tabs.push({ id: tab.slot, kind: 'code', label: tab.label, lang: 'blueprint', source: blueprintSource ?? '' });
    } else if (Astro.slots.has(tab.slot)) {
        tabs.push({ id: tab.slot, kind: 'slot', label: tab.label, html: await Astro.slots.render(tab.slot) });
    }
}

const bindings: WidgetPane[] = [];
for (const binding of BINDINGS) {
    if (binding.slot === MARKUP_SLOT) {
        if (markupHtml === null) continue;
        const html = Astro.slots.has(MARKUP_OVERRIDE) ? await Astro.slots.render(MARKUP_OVERRIDE) : markupHtml;
        bindings.push({ id: binding.slot, kind: 'slot', label: binding.label, html });
        continue;
    }
    if (!Astro.slots.has(binding.slot)) continue;
    const html = await Astro.slots.render(binding.slot);
    const access = decodeEcCode(html);
    const lang = /data-language="([^"]+)"/.exec(html)?.[1];
    const pane = BLUEPRINT_PANE_SLOTS[binding.slot as keyof typeof BLUEPRINT_PANE_SLOTS];
    if (access === null || lang !== pane.accessLang) {
        throw new Error(
            `AdwWidget(${title}): the "${binding.slot}" slot has to hold exactly one \`\`\`${pane.accessLang} ` +
                'fence: the code that reaches the elements of the generated markup by id.',
        );
    }
    const tree = blueprintTree as SharedTreeNode;
    const file = blueprint!.split('/').pop()!;
    const compose = BLUEPRINT_PANE_FILES[binding.slot as keyof typeof BLUEPRINT_PANE_FILES];
    const files = compose({ markup: PANE_MARKUP[binding.slot](tree), access, file, tree });
    bindings.push({ id: binding.slot, kind: 'files', label: binding.label, files });
}

// A block missing from a group's snippet map gets the RECORDED REASON, never silence; one in
// neither map is what arms 4 and 7 of `check-generated-website-data.mjs` refuse.
for (const group of groups) {
    const code = group.code
        .map((pane) => ({
            id: pane.id,
            kind: 'code' as const,
            label: pane.label,
            lang: pane.lang,
            source: group.codeOf(title, pane.id) ?? '',
        }))
        .filter((pane) => pane.source !== '');
    if (code.length > 0) {
        bindings.push(...code);
        continue;
    }
    const reason = group.refusalOf(title);
    if (reason === undefined) continue;
    bindings.push({
        id: group.refusal.pane,
        kind: 'refusal',
        label: group.refusal.label,
        missing: group.refusal.missing,
        note: group.refusal.note,
        reason,
    });
}
---

<div class="adw-widget">
    <AdwWidgetWindow
        title={title}
        refHref={refHref}
        live={live}
        tabs={tabs}
        bindings={bindings}
        padding={padding}
        scroll={scroll}
        stage={stage}
    />
</div>

<script>
    // Registers every <adw-*> custom element — both the tab bar of this
    // component AND the live-preview widgets slotted into it. This static import
    // runs before the code below, so every element is defined by the time the
    // previews mount. `buildSharedTree` is what a one-Blueprint block's preview is
    // realised with — see the mount below.
    import { buildSharedTree } from '@gjsify/adwaita-web';
    // The element CLASS, for the ordinal door below. `<adw-tab-view>` has no settable
    // ordinal any more (ADR 0048) and an attribute is a string no type sees, so the
    // selection has to go through a method a type can miss.
    import type { Adw } from '@gjsify/adwaita-web';

    // Mount each preview: clone its inert <template> into the stage now that the
    // custom elements are defined. Building the subtree and attaching it in one go
    // (rather than letting the parser upgrade it in place) avoids the
    // nested-composite upgrade-order race.
    for (const tpl of document.querySelectorAll<HTMLTemplateElement>('.adw-widget-preview-tpl')) {
        const stage = tpl.parentElement?.querySelector<HTMLElement>('.adw-widget-preview-stage');
        if (!stage || stage.dataset.mounted) continue;
        stage.dataset.mounted = '1';
        // A one-Blueprint block carries its `.blp`'s projected tree instead of markup, and
        // the renderer's own builder realises it: the preview is the web render of the file.
        const tree = tpl.dataset.sharedTree;
        stage.append(tree === undefined ? tpl.content.cloneNode(true) : buildSharedTree(JSON.parse(tree)));
    }

    const KEY = 'gjsify-preferred-impl';

    const applyPreference = (impl: string | null, skip?: Element) => {
        if (!impl) return;
        for (const el of document.querySelectorAll<HTMLElement>('[data-impl-tabs]')) {
            // The MARKED view, not just any: a mounted preview can itself be an
            // `<adw-tab-view>` — the Adw.TabView block on /adwaita/view-switching/ is
            // one — and an unmarked `querySelector` handed that one back and silently
            // retargeted it whenever the reader picked an implementation on any other
            // widget. The marker is what makes the read right rather than lucky, and
            // the preview window is now the case that proves it: that window has no
            // tab view of its own at all, so an unmarked selector there returns the
            // MOUNTED WIDGET and nothing else.
            const view = el.querySelector<Adw.TabView>('adw-tab-view[data-impl-view]');
            if (!view || view === skip) continue;
            const impls = (el.dataset.impls ?? '').split(',');
            const index = impls.indexOf(impl);
            // The windows hold disjoint pane sets, so a stored choice simply does not
            // apply to most of them: picking "Blueprint" moves every GJS window and
            // leaves the others where the reader left them.
            // A CALL, not an attribute: `selected="n"` was the door until ADR 0048 renamed
            // the markup half to `selected-page="<page id>"`, and these panes declare no
            // `page-id`. The stored preference is a NAME resolved to a position against the
            // list as it is now — nothing here holds the number, which is the whole
            // difference the ADR draws.
            if (index >= 0) view.selectNthPage(index);
        }
    };

    // Follow user selection: persist + mirror to every other widget on the page.
    document.addEventListener('notify::selected-page', (event) => {
        const view = event.target as HTMLElement;
        // ONLY this component's own implementation tab view. `notify::selected-page`
        // BUBBLES, and every widget preview lives inside the same `[data-impl-tabs]`
        // host, so an unguarded listener also caught the previews. On
        // /adwaita/view-switching/ the Adw.TabView preview IS an `<adw-tab-view>`:
        // clicking its "Details" chip arrived here as `detail.selected = 1`, was read
        // as "the reader picked implementation 1" (Blueprint), persisted, and rewrote
        // every widget on the page. The widgets above then swapped a long snippet for
        // a short one and shrank, so the content under the reader's cursor jumped
        // upward while scrollY never moved. Reported as "clicking a tab scrolls the
        // page", which is exactly what it looks like.
        if (!view?.matches?.('[data-impl-view]')) return;
        const host = view.closest('[data-impl-tabs]') as HTMLElement | null;
        if (!host) return;
        const impls = (host.dataset.impls ?? '').split(',');
        const impl = impls[(event as CustomEvent).detail?.selected ?? 0];
        if (!impl) return;
        try {
            localStorage.setItem(KEY, impl);
        } catch {
            // Private mode — selection just won't persist.
        }
        applyPreference(impl, view);
    });

    // Copy button → the ACTIVE pane's hidden Expressive Code copy button (EC handles the
    // clipboard; the Adwaita toast listens on that button's click). The header button copies the
    // visible tab, a dialog's own button copies its dialog. A pane with no code copies nothing.
    const EC_COPY = '.copy button, .adw-code-headerbar-end button';
    document.addEventListener('click', (event) => {
        const btn = (event.target as HTMLElement).closest?.('.command-tabs-copy') as HTMLElement | null;
        if (!btn) return;
        // The mounted preview can hold an <adw-tab-view> of its own; only the marked one is ours.
        const page =
            btn.closest('.adw-widget-binding') ??
            btn
                .closest('[data-impl-tabs]')
                ?.querySelector('adw-tab-view[data-impl-view] .adw-tab-page:not([hidden]), .adw-widget-window-pane');
        // A pane of several files copies the one on screen, and only that one.
        const active = page?.querySelector('.adw-widget-file[data-active]') ?? page;
        const ecButton = active?.querySelector<HTMLButtonElement>(EC_COPY);
        if (!ecButton) return;
        ecButton.click();
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
    });

    // "Other bindings": a pick, a click elsewhere or Escape closes the menu. Opening a dialog
    // from inside it would otherwise leave it open underneath.
    const closeMenus = (except?: Element | null) => {
        for (const menu of document.querySelectorAll<HTMLDetailsElement>('.adw-widget-menu[open]')) {
            if (menu !== except) menu.open = false;
        }
    };
    document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        const menu = target.closest?.('.adw-widget-menu');
        closeMenus(menu && !target.closest('li button') ? menu : null);
    });
    document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const open = document.querySelector<HTMLDetailsElement>('.adw-widget-menu[open]');
        if (!open) return;
        open.open = false;
        open.querySelector('summary')?.focus();
    });

    // Initial: restore the remembered implementation once the element is defined.
    customElements.whenDefined('adw-tab-view').then(() => {
        try {
            applyPreference(localStorage.getItem(KEY));
        } catch {
            // ignore
        }
    });

    // THE FILE ROW of a pane of several files (AdwWidgetFiles). The pick is kept PER TAB and
    // by the file's ROLE, not its name: `views/clamp.xml` and `views/avatar.xml` are both the
    // NativeScript tab's `markup` file, so a reader who picked the markup on one block finds it
    // on every other, and picking a web file leaves the NativeScript tabs where they were.
    const FILE_KEY = 'gjsify-preferred-file';

    const readFilePicks = (): Record<string, string> => {
        try {
            const stored = JSON.parse(localStorage.getItem(FILE_KEY) ?? '{}');
            return stored !== null && typeof stored === 'object' ? stored : {};
        } catch {
            // Private mode, or a value this script did not write: nothing is remembered.
            return {};
        }
    };

    /** Shows `role`'s file in every pane of tab `tab`, the row included; unknown roles move nothing. */
    const showFile = (tab: string, role: string) => {
        for (const files of document.querySelectorAll<HTMLElement>(`.adw-widget-files[data-files-of="${tab}"]`)) {
            const panels = [...files.querySelectorAll<HTMLElement>(':scope > .adw-widget-file')];
            if (!panels.some((panel) => panel.dataset.fileRole === role)) continue;
            for (const panel of panels) panel.toggleAttribute('data-active', panel.dataset.fileRole === role);
            // `active-name` selects without emitting `notify::active`, so this cannot loop.
            const row = files.querySelector(':scope > adw-toggle-group');
            if (row?.getAttribute('active-name') !== role) row?.setAttribute('active-name', role);
        }
    };

    document.addEventListener('notify::active', (event) => {
        // Only a file row: a preview can hold a toggle group of its own, and its event bubbles
        // through here too.
        const row = event.target as HTMLElement;
        if (!row?.matches?.('.adw-widget-files-row')) return;
        const tab = (row.parentElement as HTMLElement | null)?.dataset.filesOf;
        const role = (row as HTMLElement & { activeName: string | null }).activeName;
        if (!tab || !role) return;
        showFile(tab, role);
        try {
            localStorage.setItem(FILE_KEY, JSON.stringify({ ...readFilePicks(), [tab]: role }));
        } catch {
            // Private mode — the pick just won't persist.
        }
    });

    customElements.whenDefined('adw-toggle-group').then(() => {
        for (const [tab, role] of Object.entries(readFilePicks())) {
            if (typeof role === 'string') showFile(tab, role);
        }
    });
</script>

<style is:global>
    .adw-widget {
        margin-top: 1.5rem;
    }

    /* A lone source pane has no <adw-tab-view>, so this stands in for its page surface. */
    .adw-widget-window-pane {
        background-color: var(--view-bg-color);
        color: var(--view-fg-color);
        overflow: hidden;
    }

    /* ── Live preview pane ──────────────────────────────────────────────
       The only pane of the window that runs the widget: an Adwaita "view"
       surface the real widget is painted onto, directly under the header bar. It
       carries no frame and no separator of its own — the window around it owns
       every edge, and the header bar above it is the only line the reader needs. */
    .adw-widget-preview {
        background: var(--adw-view-bg);
        overflow: hidden;
        /* Subtle GNOME-wallpaper-ish tint so a white row/card stays visible on
           the white view surface, mirroring the widget gallery's backdrop. */
        background-image:
            radial-gradient(circle at 0% 0%, rgba(53, 132, 228, 0.06), transparent 45%),
            radial-gradient(circle at 100% 100%, rgba(146, 110, 228, 0.05), transparent 45%);
    }

    :root[data-theme='dark'] .adw-widget-preview {
        background-color: var(--adw-window-bg);
        background-image:
            radial-gradient(circle at 0% 0%, rgba(120, 174, 237, 0.08), transparent 45%),
            radial-gradient(circle at 100% 100%, rgba(146, 110, 228, 0.08), transparent 45%);
    }

    /* A modal dialog paints a position:fixed scrim covering its containing
       block. A transform on the preview panel makes the panel that containing
       block, so an opened dialog stays inside the preview instead of covering
       the whole page. Scoped to previews that actually hold a dialog. */
    .adw-widget-preview:has(adw-alert-dialog, adw-about-dialog, adw-preferences-dialog, adw-dialog) {
        transform: translateZ(0);
    }

    /* The box the widget is mounted into. The `stage` prop adds an inline style
       here: the size a doc page has to give a widget that has none, kept out of
