diff --git a/glib/garray.c b/glib/garray.c
index 208f30d..43f80e8 100644
--- a/glib/garray.c
+++ b/glib/garray.c
@@ -47,6 +47,23 @@
 #include "grefcount.h"
 #include "gutilsprivate.h"
 
+#ifdef __EMSCRIPTEN__
+/* WebAssembly type-checks every indirect call against the callee's declared
+ * signature, so GLib's habit of invoking a two-argument #GCompareFunc through a
+ * three-argument #GCompareDataFunc pointer traps ("null function or function
+ * signature mismatch") instead of harmlessly ignoring the extra argument as it
+ * does on every native ABI. Route those calls through a real three-argument
+ * adapter that carries the original function as its user_data.
+ */
+static int
+g_compare_func_wasm_adapter (gconstpointer a,
+                             gconstpointer b,
+                             gpointer      user_data)
+{
+  return ((GCompareFunc) user_data) (a, b);
+}
+#endif
+
 #define MIN_ARRAY_SIZE  16
 
 typedef struct _GRealArray  GRealArray;
@@ -948,8 +965,13 @@ g_array_sort (GArray       *farray,
     g_sort_array (array->data,
                   array->len,
                   array->elt_size,
+#ifdef __EMSCRIPTEN__
+                  g_compare_func_wasm_adapter,
+                  (gpointer) compare_func);
+#else
                   (GCompareDataFunc) compare_func,
                   NULL);
+#endif
 }
 
 /**
@@ -2435,8 +2457,13 @@ g_ptr_array_sort (GPtrArray    *array,
     g_sort_array (array->pdata,
                   array->len,
                   sizeof (gpointer),
+#ifdef __EMSCRIPTEN__
+                  g_compare_func_wasm_adapter,
+                  (gpointer) compare_func);
+#else
                   (GCompareDataFunc) compare_func,
                   NULL);
+#endif
 }
 
